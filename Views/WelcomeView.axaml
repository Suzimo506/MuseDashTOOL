<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MdModManager.ViewModels"
             x:Class="MdModManager.Views.WelcomeView"
             x:DataType="vm:WelcomeViewModel">

    <UserControl.Resources>
        <!-- 快捷卡片按钮主题 -->
        <ControlTheme x:Key="QuickCardBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="CardBorder"
                            Background="{DynamicResource CardBgBrush}"
                            CornerRadius="16"
                            Padding="18,16"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource FloatingPanelBorder}"
                            BoxShadow="0 2 8 0 #18000000">
                        <Border.Transitions>
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18"/>
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#CardBorder">
                <Setter Property="RenderTransform" Value="translateY(-3px)"/>
                <Setter Property="BoxShadow" Value="0 8 20 0 #30000000"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#CardBorder">
                <Setter Property="RenderTransform" Value="translateY(0px) scale(0.97)"/>
            </Style>
        </ControlTheme>

        <!-- 底部链接按钮主题 -->
        <ControlTheme x:Key="BottomLinkBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="RootBorder" Background="Transparent">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Opacity" Value="0.8"/>
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Opacity" Value="0.6"/>
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid RowDefinitions="*,Auto" ColumnDefinitions="1.1*,*" Margin="15,10,15,20" MinHeight="560">
            <Grid.ColumnSpacing>25</Grid.ColumnSpacing>

            <!-- ====== 左侧：问候与状态 ====== -->
            <StackPanel Grid.Column="0" Spacing="22" VerticalAlignment="Top">

                <!-- 问候语区域 -->
                <StackPanel Spacing="6" Margin="0,5,0,0">
                    <TextBlock Text="{Binding GreetingText}"
                               FontSize="30" FontWeight="Bold" LetterSpacing="1">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Color="#FF00FF" Offset="0"/>
                                <GradientStop Color="#FF69B4" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="{Binding SubtitleText}"
                               FontSize="14"
                               Foreground="{DynamicResource ThemeTextSubBrush}"
                               LetterSpacing="1"/>
                </StackPanel>

                <!-- 运行状态卡片 -->
                <Border CornerRadius="18"
                        Padding="22,20"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource FloatingPanelBorder}"
                        BoxShadow="0 4 16 0 #20000000">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#1A1018" Offset="0"/>
                            <GradientStop Color="#20161E" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="16">
                        <TextBlock Text="运行状态" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeTextMainBrush}" Opacity="0.9"/>

                        <!-- 游戏路径 -->
                        <Grid ColumnDefinitions="Auto,*">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <PathIcon Data="M928 352v-48c0-35.3-28.7-64-64-64H485.2c-21 0-40.7-10.3-52.6-27.6l-61.5-88.9c-12-17.3-31.6-27.6-52.6-27.6H64c-35.3 0-64 28.7-64 64v656c0 70.7 57.3 128 128 128h638c57.8 0 108.5-38.8 123.6-94.6L928 707.2l74.2-274.5c11-40.7-19.6-80.7-61.8-80.7H928z"
                                          Width="14" Height="14" Foreground="{DynamicResource SvgIconBrush}"/>
                                <TextBlock Text="游戏路径" FontSize="13" Foreground="{DynamicResource ThemeTextSubBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding GamePath}"
                                       FontSize="12"
                                       Foreground="{DynamicResource ThemeTextTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       MaxWidth="320"
                                       ToolTip.Tip="{Binding GamePath}"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource ThemeTextTertiaryBrush}" Opacity="0.15"/>

                        <!-- 统计行 -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <!-- MelonLoader -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="4">
                                <PathIcon Data="M128 256h768v85.333333H128V256z m85.333333 213.333333h597.333334v85.333334H213.333333v-85.333334z m128 213.333334h341.333334v85.333333H341.333333v-85.333333z"
                                          Width="20" Height="20"
                                          Foreground="{DynamicResource SvgIconBrush}"/>
                                <TextBlock Text="{Binding MelonLoaderVersion, FallbackValue=未安装}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThemeTextMainBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="MelonLoader"
                                           FontSize="11"
                                           Foreground="{DynamicResource ThemeTextTertiaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <!-- Mod -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="4">
                                <PathIcon Data="M406.186667 120.874667a213.418667 213.418667 0 0 1 211.669333 0l3.370667 1.92a42.666667 42.666667 0 0 1-42.368 74.112l-3.370667-1.92a128.042667 128.042667 0 0 0-126.976 0L267.050667 298.666667a128 128 0 0 0-32.853334 26.794666l0.298667 0.170667L512 484.181333l277.504-158.549333c0.085333 0 0.170667-0.085333 0.256-0.170667A128 128 0 0 0 756.992 298.666667l-2.048-1.152a42.666667 42.666667 0 1 1 42.325333-74.069334l2.048 1.152a213.376 213.376 0 0 1 107.52 185.216v204.373334a213.333333 213.333333 0 0 1-107.52 185.173333l-181.461333 103.722667a213.376 213.376 0 0 1-211.669333 0l-3.413334-1.877334a42.666667 42.666667 0 0 1 42.410667-74.112l3.328 1.92a128 128 0 0 0 21.333333 9.728A42.88 42.88 0 0 1 469.333333 832v-273.92L202.666667 405.76c-0.042667 1.322667-0.128 2.688-0.128 4.053333v204.373334A128 128 0 0 0 267.093333 725.333333l2.048 1.152a42.666667 42.666667 0 0 1-42.368 74.069334l-2.005333-1.152a213.333333 213.333333 0 0 1-107.52-185.216v-204.373334a213.333333 213.333333 0 0 1 107.52-185.173333L406.186667 120.874667zM554.666667 558.08v273.92a42.368 42.368 0 0 1-0.597334 6.741333c7.338667-2.56 14.506667-5.802667 21.418667-9.728L756.992 725.333333a128 128 0 0 0 64.512-111.146666v-204.373334c0-1.365333-0.128-2.773333-0.170667-4.138666L554.666667 558.08z"
                                          Width="20" Height="20"
                                          Foreground="{DynamicResource SvgIconBrush}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding TotalMods}"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                    <TextBlock Text="个"
                                               FontSize="12"
                                               Foreground="{DynamicResource ThemeTextTertiaryBrush}"
                                               VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                </StackPanel>
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource ThemeTextTertiaryBrush}"
                                           HorizontalAlignment="Center">
                                    <Run Text="{Binding EnabledMods}"/>
                                    <Run Text="启用 / "/>
                                    <Run Text="{Binding DisabledMods}"/>
                                    <Run Text="禁用"/>
                                </TextBlock>
                            </StackPanel>
                            <!-- 谱面 -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="4">
                                <PathIcon Data="M870.4 307.568V262.4a57.664 57.664 0 0 0-51.2-57.232V160a57.664 57.664 0 0 0-57.6-57.6H262.4a57.664 57.664 0 0 0-57.6 57.6v45.168A57.664 57.664 0 0 0 153.6 262.4v45.168A57.664 57.664 0 0 0 102.4 364.8v550.4a57.664 57.664 0 0 0 57.6 57.6h704a57.664 57.664 0 0 0 57.6-57.6V364.8a57.664 57.664 0 0 0-51.2-57.232zM262.4 153.6h499.2a6.4 6.4 0 0 1 6.4 6.4v44.8H256v-44.8a6.4 6.4 0 0 1 6.4-6.4z m-51.2 102.4h601.6a6.4 6.4 0 0 1 6.4 6.4v44.8H204.8v-44.8a6.4 6.4 0 0 1 6.4-6.4z m659.2 659.2a6.4 6.4 0 0 1-6.4 6.4H160a6.4 6.4 0 0 1-6.4-6.4V364.8a6.4 6.4 0 0 1 6.4-6.4h704a6.4 6.4 0 0 1 6.4 6.4zM620.304 536.336a83.136 83.136 0 0 0-29.456-24.256 92.456 92.456 0 0 1-12-16.128C566.184 474.4 563.352 450.888 563.2 434.96a25.6 25.6 0 0 0-25.6-25.36h-0.12A25.6 25.6 0 0 0 512 435.2v240.368c-14.976-6.4-32.424-9.968-51.2-9.968-57.424 0-102.4 33.736-102.4 76.8s44.976 76.8 102.4 76.8 102.4-33.736 102.4-76.8V555.672a24.624 24.624 0 0 0 3.464 1.664 30.768 30.768 0 0 1 13.032 10.192c6.648 8.656 8.664 18.864 9.272 24.184a25.6 25.6 0 0 0 50.864-5.824c-1.48-12.928-6.064-32.024-19.528-49.552zM460.8 768c-31.256 0-51.2-15.2-51.2-25.6s19.944-25.6 51.2-25.6 51.2 15.2 51.2 25.6-19.944 25.6-51.2 25.6z"
                                          Width="20" Height="20"
                                          Foreground="{DynamicResource SvgIconBrush}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding TotalCharts}"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                    <TextBlock Text="首"
                                               FontSize="12"
                                               Foreground="{DynamicResource ThemeTextTertiaryBrush}"
                                               VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                </StackPanel>
                                <TextBlock Text="自制谱面"
                                           FontSize="11"
                                           Foreground="{DynamicResource ThemeTextTertiaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 启动游戏大按钮 -->
                <Button Command="{Binding LaunchGameCommand}"
                        HorizontalAlignment="Stretch"
                        Height="52"
                        CornerRadius="16"
                        Cursor="Hand"
                        BorderThickness="0">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="#d4237a" Offset="0"/>
                            <GradientStop Color="#FF69B4" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                        <GradientStop Color="#e0297f" Offset="0"/>
                                        <GradientStop Color="#FF85C8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                        <Style Selector="Button:pressed /template/ ContentPresenter">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                        <GradientStop Color="#b81e68" Offset="0"/>
                                        <GradientStop Color="#e05ca0" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                    </Button.Styles>
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Button.RenderTransform>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <PathIcon Data="M896 512L128 1024V0z"
                                  Width="18" Height="18" Foreground="White"/>
                        <TextBlock Text="启动 / 重启游戏" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Button>

                <!-- 新闻卡片 -->
                <Border CornerRadius="14"
                        Padding="18,14"
                        Background="{DynamicResource CardBgBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource FloatingPanelBorder}"
                        IsVisible="{Binding HasNews}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="M880 112H144c-17.7 0-32 14.3-32 32v736c0 17.7 14.3 32 32 32h736c17.7 0 32-14.3 32-32V144c0-17.7-14.3-32-32-32zM368 256h288c8.8 0 16 7.2 16 16s-7.2 16-16 16H368c-8.8 0-16-7.2-16-16s7.2-16 16-16zm0 128h288c8.8 0 16 7.2 16 16s-7.2 16-16 16H368c-8.8 0-16-7.2-16-16s7.2-16 16-16zm-56 372c-6.6 0-12-5.4-12-12V556c0-6.6 5.4-12 12-12h488c6.6 0 12 5.4 12 12v188c0 6.6-5.4 12-12 12H312z"
                                      Width="16" Height="16" Foreground="{DynamicResource SvgIconBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding NewsTitle}" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource SvgIconBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding NewsContent}"
                                   FontSize="13" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ThemeTextSubBrush}"
                                   Margin="26,0,0,0"/>
                        <Button IsVisible="{Binding HasNewsUrl}"
                                Command="{Binding OpenUrlCommand}"
                                CommandParameter="{Binding NewsUrl}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Cursor="Hand"
                                Margin="26,0,0,0">
                            <TextBlock Text="查看详情 ›" FontSize="12"
                                       Foreground="{DynamicResource ThemeAccentBrush}"/>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ====== 右侧：Logo 与快捷入口 ====== -->
            <StackPanel Grid.Column="1" Spacing="18" VerticalAlignment="Top">

                <!-- 发光 Logo -->
                <StackPanel HorizontalAlignment="Center" Spacing="10" Margin="0,20,0,8">
                    <Border Width="90" Height="90"
                            CornerRadius="26"
                            Background="#1E1018"
                            BorderThickness="1.5"
                            BoxShadow="0 8 28 0 #40FF69B4"
                            HorizontalAlignment="Center">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#FF69B4" Offset="0"/>
                                <GradientStop Color="#d4237a" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Image Source="/Assets/MuseDashTOOL.ico" Width="56" Height="56"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="喵斯兔" FontSize="20" FontWeight="Bold"
                               LetterSpacing="4" HorizontalAlignment="Center">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Color="#FF00FF" Offset="0"/>
                                <GradientStop Color="#FF69B4" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>

                <!-- 快捷入口标题 -->
                <TextBlock Text="快捷入口" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextSubBrush}"
                           Margin="4,0,0,0"/>

                <!-- 快捷入口卡片网格 -->
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*"
                      RowSpacing="12" ColumnSpacing="12">
                    <!-- Mod 管理 -->
                    <Button Grid.Row="0" Grid.Column="0"
                            Theme="{StaticResource QuickCardBtn}"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="ModManager">
                        <StackPanel Spacing="8">
                            <PathIcon Data="M406.186667 120.874667a213.418667 213.418667 0 0 1 211.669333 0l3.370667 1.92a42.666667 42.666667 0 0 1-42.368 74.112l-3.370667-1.92a128.042667 128.042667 0 0 0-126.976 0L267.050667 298.666667a128 128 0 0 0-32.853334 26.794666l0.298667 0.170667L512 484.181333l277.504-158.549333c0.085333 0 0.170667-0.085333 0.256-0.170667A128 128 0 0 0 756.992 298.666667l-2.048-1.152a42.666667 42.666667 0 1 1 42.325333-74.069334l2.048 1.152a213.376 213.376 0 0 1 107.52 185.216v204.373334a213.333333 213.333333 0 0 1-107.52 185.173333l-181.461333 103.722667a213.376 213.376 0 0 1-211.669333 0l-3.413334-1.877334a42.666667 42.666667 0 0 1 42.410667-74.112l3.328 1.92a128 128 0 0 0 21.333333 9.728A42.88 42.88 0 0 1 469.333333 832v-273.92L202.666667 405.76c-0.042667 1.322667-0.128 2.688-0.128 4.053333v204.373334A128 128 0 0 0 267.093333 725.333333l2.048 1.152a42.666667 42.666667 0 0 1-42.368 74.069334l-2.005333-1.152a213.333333 213.333333 0 0 1-107.52-185.216v-204.373334a213.333333 213.333333 0 0 1 107.52-185.173333L406.186667 120.874667zM554.666667 558.08v273.92a42.368 42.368 0 0 1-0.597334 6.741333c7.338667-2.56 14.506667-5.802667 21.418667-9.728L756.992 725.333333a128 128 0 0 0 64.512-111.146666v-204.373334c0-1.365333-0.128-2.773333-0.170667-4.138666L554.666667 558.08z"
                                      Width="22" Height="22"
                                      Foreground="{DynamicResource SvgIconBrush}"/>
                            <TextBlock Text="Mod 管理" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource ThemeTextMainBrush}"/>
                            <TextBlock Text="安装、启用或禁用模组"
                                       FontSize="11"
                                       Foreground="{DynamicResource ThemeTextTertiaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <!-- 谱面管理 -->
                    <Button Grid.Row="0" Grid.Column="1"
                            Theme="{StaticResource QuickCardBtn}"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="ChartManager">
                        <StackPanel Spacing="8">
                            <PathIcon Data="M870.4 307.568V262.4a57.664 57.664 0 0 0-51.2-57.232V160a57.664 57.664 0 0 0-57.6-57.6H262.4a57.664 57.664 0 0 0-57.6 57.6v45.168A57.664 57.664 0 0 0 153.6 262.4v45.168A57.664 57.664 0 0 0 102.4 364.8v550.4a57.664 57.664 0 0 0 57.6 57.6h704a57.664 57.664 0 0 0 57.6-57.6V364.8a57.664 57.664 0 0 0-51.2-57.232zM262.4 153.6h499.2a6.4 6.4 0 0 1 6.4 6.4v44.8H256v-44.8a6.4 6.4 0 0 1 6.4-6.4z m-51.2 102.4h601.6a6.4 6.4 0 0 1 6.4 6.4v44.8H204.8v-44.8a6.4 6.4 0 0 1 6.4-6.4z m659.2 659.2a6.4 6.4 0 0 1-6.4 6.4H160a6.4 6.4 0 0 1-6.4-6.4V364.8a6.4 6.4 0 0 1 6.4-6.4h704a6.4 6.4 0 0 1 6.4 6.4zM620.304 536.336a83.136 83.136 0 0 0-29.456-24.256 92.456 92.456 0 0 1-12-16.128C566.184 474.4 563.352 450.888 563.2 434.96a25.6 25.6 0 0 0-25.6-25.36h-0.12A25.6 25.6 0 0 0 512 435.2v240.368c-14.976-6.4-32.424-9.968-51.2-9.968-57.424 0-102.4 33.736-102.4 76.8s44.976 76.8 102.4 76.8 102.4-33.736 102.4-76.8V555.672a24.624 24.624 0 0 0 3.464 1.664 30.768 30.768 0 0 1 13.032 10.192c6.648 8.656 8.664 18.864 9.272 24.184a25.6 25.6 0 0 0 50.864-5.824c-1.48-12.928-6.064-32.024-19.528-49.552zM460.8 768c-31.256 0-51.2-15.2-51.2-25.6s19.944-25.6 51.2-25.6 51.2 15.2 51.2 25.6-19.944 25.6-51.2 25.6z"
                                      Width="22" Height="22"
                                      Foreground="{DynamicResource SvgIconBrush}"/>
                            <TextBlock Text="谱面管理" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource ThemeTextMainBrush}"/>
                            <TextBlock Text="管理本地自制谱面"
                                       FontSize="11"
                                       Foreground="{DynamicResource ThemeTextTertiaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <!-- 谱面下载 -->
                    <Button Grid.Row="1" Grid.Column="0"
                            Theme="{StaticResource QuickCardBtn}"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="ChartDownload">
                        <StackPanel Spacing="8">
                            <PathIcon Data="M498.347 824.32l-296.96-296.96c-11.947-11.947-3.414-34.133 13.653-34.133h160.427c11.946 0 20.48-8.534 20.48-20.48V54.613c0-11.946 8.533-20.48 20.48-20.48h189.44c11.946 0 20.48 8.534 20.48 20.48v418.134c0 11.946 8.533 20.48 20.48 20.48h160.426c18.774 0 27.307 22.186 13.654 34.133L525.653 824.32c-6.826 6.827-20.48 6.827-27.306 0zM916.48 989.867H107.52c-18.773 0-35.84-15.36-35.84-35.84 0-18.774 15.36-35.84 35.84-35.84h810.667c18.773 0 35.84 15.36 35.84 35.84-1.707 20.48-17.067 35.84-37.547 35.84z"
                                      Width="22" Height="22"
                                      Foreground="{DynamicResource SvgIconBrush}"/>
                            <TextBlock Text="谱面下载" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource ThemeTextMainBrush}"/>
                            <TextBlock Text="从线上平台下载谱面"
                                       FontSize="11"
                                       Foreground="{DynamicResource ThemeTextTertiaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <!-- 使用说明 -->
                    <Button Grid.Row="1" Grid.Column="1"
                            Theme="{StaticResource QuickCardBtn}"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="Tutorial">
                        <StackPanel Spacing="8">
                            <PathIcon Data="M512 85.333333C276.266667 85.333333 85.333333 276.266667 85.333333 512s190.933333 426.666667 426.666667 426.666667 426.666667-190.933333 426.666667-426.666667S747.733333 85.333333 512 85.333333z m42.666667 640h-85.333334v-256h85.333334v256z m0-341.333333h-85.333334v-85.333333h85.333334v85.333333z"
                                      Width="22" Height="22"
                                      Foreground="{DynamicResource SvgIconBrush}"/>
                            <TextBlock Text="使用说明" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource ThemeTextMainBrush}"/>
                            <TextBlock Text="新手教程与常见问题"
                                       FontSize="11"
                                       Foreground="{DynamicResource ThemeTextTertiaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- ====== 底部：相关链接横向排列 ====== -->
            <Border Grid.Row="1" Grid.ColumnSpan="2"
                    CornerRadius="14"
                    Padding="20,12"
                    Margin="0,16,0,0"
                    Background="{DynamicResource CardBgBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource FloatingPanelBorder}">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
                    <!-- GitHub -->
                    <Button Grid.Column="0" Theme="{StaticResource BottomLinkBtn}"
                            Command="{Binding OpenUrlCommand}"
                            CommandParameter="https://github.com/Suzimo506/MuseDashTOOL">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="28" Height="28" CornerRadius="8"
                                    Background="#18FF69B4" VerticalAlignment="Center">
                                <PathIcon Data="M511.6 76.3C264.3 76.2 64 276.4 64 523.5 64 718.9 189.3 885 370.2 948c22.5 4.1 29.7-9.8 29.7-21.5 0-11.2-.6-48.2-.6-87.6-98.2 17.8-122.7-24-130.4-46-4.4-11.2-23.4-46-40-55.2-13.7-7.3-33.2-25.5-.5-26 30.7-.5 52.6 28.3 59.9 40 35.1 59 91.1 42.4 113.4 32.2 3.5-25 13.7-42.4 24.9-52.2-87-9.8-178.2-43.5-178.2-193 0-42.6 15.2-77.8 40-105.2-4-9.8-17.5-49.8 3.8-103.7 0 0 32.7-10.3 107.2 40.2 31.2-8.7 64.4-13 97.5-13.2 33.1.2 66.3 4.5 97.5 13.2 74.5-50.8 107.2-40.2 107.2-40.2 21.3 53.9 7.8 93.9 3.8 103.7 24.9 27.4 40 62.3 40 105.2 0 150-91.4 183.2-178.6 193 14 12.2 26.2 35.4 26.2 71.6 0 51.7-.5 93.4-.5 106.4 0 11.7 7.3 25.9 29.9 21.5C834.7 885 960 718.7 960 523.5 960 276.4 759.1 76.3 511.6 76.3z"
                                          Width="14" Height="14" Foreground="#FF69B4"/>
                            </Border>
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="GitHub 仓库" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                <TextBlock Text="开源代码与反馈" FontSize="10"
                                           Foreground="{DynamicResource ThemeTextTertiaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- 分隔线 -->
                    <Border Grid.Column="1" Width="1" Height="28"
                            Background="{DynamicResource ThemeTextTertiaryBrush}" Opacity="0.15"
                            Margin="24,0"/>

                    <!-- Euterpe -->
                    <Button Grid.Column="2" Theme="{StaticResource BottomLinkBtn}"
                            Command="{Binding OpenUrlCommand}"
                            CommandParameter="https://euterpe-org.com">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="28" Height="28" CornerRadius="8"
                                    Background="#18FF69B4" VerticalAlignment="Center">
                                <Image Source="/Assets/EuterpeLogo.webp"
                                       Width="16" Height="16"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                            </Border>
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="Euterpe" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                <TextBlock Text="自制谱面社区平台" FontSize="10"
                                           Foreground="{DynamicResource ThemeTextTertiaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- 分隔线 -->
                    <Border Grid.Column="3" Width="1" Height="28"
                            Background="{DynamicResource ThemeTextTertiaryBrush}" Opacity="0.15"
                            Margin="24,0"/>

                    <!-- MDMC -->
                    <Button Grid.Column="4" Theme="{StaticResource BottomLinkBtn}"
                            Command="{Binding OpenUrlCommand}"
                            CommandParameter="https://mdmc.moe">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="28" Height="28" CornerRadius="8"
                                    Background="#18FF69B4" VerticalAlignment="Center">
                                <Image Source="/Assets/mdmc.png"
                                       Width="20" Height="20"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                            </Border>
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="MDMC" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                <TextBlock Text="自制谱面社区平台" FontSize="10"
                                           Foreground="{DynamicResource ThemeTextTertiaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- 分隔线 -->
                    <Border Grid.Column="5" Width="1" Height="28"
                            Background="{DynamicResource ThemeTextTertiaryBrush}" Opacity="0.15"
                            Margin="24,0"/>

                    <!-- MuseDashTOOL -->
                    <Button Grid.Column="6" Theme="{StaticResource BottomLinkBtn}"
                            Command="{Binding OpenUrlCommand}"
                            CommandParameter="https://space.bilibili.com/289883561?spm_id_from=333.1007.0.0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="28" Height="28" CornerRadius="8"
                                    Background="#18FF69B4" VerticalAlignment="Center">
                                <Image Source="/Assets/MuseDashTOOL.ico"
                                       Width="16" Height="16"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                            </Border>
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="MuseDashTOOL" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                <TextBlock Text="上千首自制谱仓库" FontSize="10"
                                           Foreground="{DynamicResource ThemeTextTertiaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- 分隔线 -->
                    <Border Grid.Column="7" Width="1" Height="28"
                            Background="{DynamicResource ThemeTextTertiaryBrush}" Opacity="0.15"
                            Margin="24,0"/>

                    <!-- 打赏按钮 -->
                    <Button Grid.Column="8" Theme="{StaticResource BottomLinkBtn}"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="Sponsor"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Margin="0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="28" Height="28" CornerRadius="8"
                                    Background="#18FF69B4" VerticalAlignment="Center">
