                                          Width="14" Height="14" Foreground="#FF5566"/>
                            </Border>
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="打赏" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                <TextBlock Text="支持喵斯兔" FontSize="10"
                                           Foreground="{DynamicResource ThemeTextTertiaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- 分隔线 -->
                    <Border Grid.Column="9" Width="1" Height="28"
                            Background="{DynamicResource ThemeTextTertiaryBrush}" Opacity="0.15"
                            Margin="24,0"/>

                    <!-- 右侧版本号 -->
                    <TextBlock Grid.Column="11" Text="v1.4.3" FontSize="11"
                               Foreground="{DynamicResource ThemeTextTertiaryBrush}"
                               VerticalAlignment="Center" Opacity="0.5"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
