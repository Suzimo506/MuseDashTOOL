<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MdModManager.ViewModels"
             xmlns:models="using:MdModManager.Models"
             xmlns:conv="using:MdModManager.Converters"
             xmlns:i18n="using:MdModManager.Services"
             x:Class="MdModManager.Views.OnlineLobbyView"
             x:DataType="vm:OnlineLobbyViewModel">

    <UserControl.Resources>
        <conv:AccuracyColorConverter x:Key="AccuracyColorConverter"/>

        <ControlTheme x:Key="LobbyCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="RootBorder"
                            Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource FloatingPanelBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,12">
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#RootBorder">
                <Setter Property="Background" Value="{DynamicResource CardHoverBgBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#RootBorder">
                <Setter Property="RenderTransform" Value="scale(0.99)"/>
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*" RowSpacing="18">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding [OnlineLobby_Title], Source={x:Static i18n:I18nService.Instance}}"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{DynamicResource ThemeTextMainBrush}"/>
                <TextBlock Text="{Binding StatusText}"
                           FontSize="13"
                           Foreground="{DynamicResource ThemeTextSubBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{Binding OpenOnlineModDownloadCommand}"
                        Height="36"
                        Padding="12,0"
                        Background="{DynamicResource ControlBgBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        ToolTip.Tip="{Binding [OnlineLobby_DownloadMod], Source={x:Static i18n:I18nService.Instance}}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <PathIcon Width="14"
                                  Height="14"
                                  Foreground="{DynamicResource ThemeTextMainBrush}"
                                  Data="M5 20h14v-2H5m14-9h-4V3H9v6H5l7 7 7-7z"/>
                        <TextBlock Text="{Binding [OnlineLobby_DownloadMod], Source={x:Static i18n:I18nService.Instance}}"
                                   FontSize="13"
                                   Foreground="{DynamicResource ThemeTextMainBrush}"/>
                    </StackPanel>
                </Button>
                <Border Height="36"
                        MinWidth="118"
                        Padding="12,0"
                        CornerRadius="8"
                        Background="{DynamicResource ControlBgBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1">
                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ThemeTextMainBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Border>
                <Button Command="{Binding RefreshCommand}"
                        Height="36"
                        Padding="14,0"
                        Background="{DynamicResource ControlBgBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}">
                    <TextBlock Text="{Binding [OnlineLobby_Refresh], Source={x:Static i18n:I18nService.Instance}}"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="360,*" ColumnSpacing="18">
            <Border Background="{DynamicResource FloatingPanelBackground}"
                    BorderBrush="{DynamicResource FloatingPanelBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                    <ScrollViewer x:Name="NodeScrollViewer"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  PointerWheelChanged="OnNodeScrollWheelChanged">
                        <ItemsControl ItemsSource="{Binding Nodes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:EnsembleLobbyNode">
                                    <Button Command="{Binding $parent[UserControl].DataContext.SelectNodeCommand}"
                                            CommandParameter="{Binding}"
                                            Width="62"
                                            HorizontalContentAlignment="Stretch"
                                            MinHeight="54"
                                            Padding="0"
                                            Margin="0,0,4,0"
                                            Background="Transparent"
                                            BorderThickness="0">
                                        <Border Background="{Binding TabBackgroundBrush}"
                                                BorderBrush="{Binding TabBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="6,5">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding TabTextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding RoomCountText}"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource ThemeTextTertiaryBrush}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="9"
                                                           Foreground="{Binding StatusBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding SelectedNode.Address}"
                                   FontSize="11"
                                   Foreground="{DynamicResource ThemeTextTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <Border Grid.Column="1"
                                CornerRadius="8"
                                Padding="8,3"
                                Background="#12000000">
                            <TextBlock Text="{Binding SelectedNode.RoomCountText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource ThemeTextSubBrush}"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <TextBlock Text="{Binding [OnlineLobby_NoRooms], Source={x:Static i18n:I18nService.Instance}}"
                                   IsVisible="{Binding !SelectedNodeHasRooms}"
                                   FontSize="12"
                                   Foreground="{DynamicResource ThemeTextTertiaryBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>

                        <ScrollViewer IsVisible="{Binding SelectedNodeHasRooms}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SelectedNode.Rooms}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:EnsembleLobbyRoom">
                                        <Button Theme="{StaticResource LobbyCardButton}"
                                                Command="{Binding $parent[UserControl].DataContext.SelectRoomCommand}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,0,6">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ThemeTextMainBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding StatusText}"
                                                               FontSize="12"
                                                               Foreground="{Binding StatusBrush}"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="{Binding HostText}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource ThemeTextSubBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding PlayerCountText}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource ThemeTextSubBrush}"/>
                                                </Grid>
                                                <WrapPanel>
                                                    <Border CornerRadius="6" Padding="7,3" Margin="0,0,6,0" Background="#18F25D9C">
                                                        <TextBlock Text="{Binding PlaylistLabelText}" FontSize="11" Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                                    </Border>
                                                    <Border CornerRadius="6" Padding="7,3" Margin="0,0,6,0" Background="#12000000">
                                                        <TextBlock Text="{Binding PrivacyText}" FontSize="11" Foreground="{DynamicResource ThemeTextSubBrush}"/>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource FloatingPanelBackground}"
                    BorderBrush="{DynamicResource FloatingPanelBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <Grid RowDefinitions="Auto,*">
                    <Grid IsVisible="{Binding !HasSelectedRoom}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <TextBlock Text="{Binding [OnlineLobby_SelectRoomHint], Source={x:Static i18n:I18nService.Instance}}"
                                   FontSize="18"
                                   Foreground="{DynamicResource ThemeTextSubBrush}"/>
                    </Grid>

                    <Grid IsVisible="{Binding HasSelectedRoom}"
                          RowDefinitions="Auto,*"
                          RowSpacing="14">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding SelectedRoom.Name}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                <TextBlock Text="{Binding SelectedRoom.CurrentBattleEntry}"
                                           FontSize="12"
                                           Foreground="{DynamicResource ThemeTextSubBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding SelectedRoom.StatusText}"
                                           FontSize="14"
                                           Foreground="{Binding SelectedRoom.StatusBrush}"
                                           HorizontalAlignment="Right"/>
                                 <TextBlock Text="{Binding SelectedRoom.PlaylistLabelText}"
                                            FontSize="12"
                                            Foreground="{DynamicResource ThemeTextSubBrush}"
                                            HorizontalAlignment="Right"/>
                                 <TextBlock Text="{Binding SelectedRoom.WatcherText}"
                                            FontSize="11"
                                            Foreground="{DynamicResource ThemeTextTertiaryBrush}"
                                            HorizontalAlignment="Right"/>
                             </StackPanel>
                         </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="1.2*,0.8*" ColumnSpacing="16">
                            <ScrollViewer MaxHeight="460"
                                          VerticalAlignment="Top"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding SelectedRoom.Players}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:EnsembleLobbyPlayer">
                                            <Border Background="{DynamicResource CardBgBrush}"
                                                    BorderBrush="{DynamicResource FloatingPanelBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="14,12"
                                                    Margin="0,0,0,10">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                                    <StackPanel Spacing="5">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="15"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource ThemeTextMainBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"/>
                                                            <Border Grid.Column="1"
                                                                    Background="#2E6BFF"
                                                                    CornerRadius="4"
                                                                    Padding="6,1"
                                                                    VerticalAlignment="Center"
                                                                    IsVisible="{Binding IsFc}">
                                                                <TextBlock Text="FC"
                                                                           FontSize="10"
                                                                           FontWeight="Bold"
                                                                           Foreground="White"/>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Text="{Binding CharacterText}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource ThemeTextSubBrush}"/>
                                                        <TextBlock Text="{Binding JudgeText}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource ThemeTextTertiaryBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1"
                                                                HorizontalAlignment="Right"
                                                                Spacing="4"
                                                                IsVisible="{Binding $parent[UserControl].DataContext.SelectedRoom.IsPlaying}">
                                                        <TextBlock Text="{Binding AccuracyText}"
                                                                   FontSize="18"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{Binding AccuracyText, Converter={StaticResource AccuracyColorConverter}}"/>
                                                        <TextBlock Text="{Binding ScoreText}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource ThemeTextSubBrush}"
                                                                   HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1"
                                                            CornerRadius="6"
                                                            Padding="8,4"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding ReadyBadgeBrush}"
                                                            IsVisible="{Binding !$parent[UserControl].DataContext.SelectedRoom.IsPlaying}">
                                                        <TextBlock Text="{Binding ReadyText}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding ReadyBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <ScrollViewer Grid.Column="1"
                                          VerticalAlignment="Top"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                    <Border Background="{DynamicResource CardBgBrush}"
                                            BorderBrush="{DynamicResource FloatingPanelBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10">
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding [OnlineLobby_ViewerChat], Source={x:Static i18n:I18nService.Instance}}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ViewerChatLengthText}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource ThemeTextTertiaryBrush}"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>

                                            <Border Grid.Row="1"
                                                    Background="#10000000"
                                                    CornerRadius="8"
                                                    Padding="8"
                                                    Height="86">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding SelectedRoom.ViewerChats}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:EnsembleLobbyChat">
                                                                <Border Background="#12000000"
                                                                        CornerRadius="8"
                                                                        Padding="10,8"
                                                                        Margin="0,0,0,8">
                                                                    <TextBlock Text="{Binding DisplayText}"
                                                                               FontSize="12"
                                                                               TextWrapping="Wrap"
                                                                               Foreground="{Binding MessageBrush}"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>

                                            <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="6">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <TextBox Text="{Binding ViewerChatText, Mode=TwoWay}"
                                                             MaxLength="80"
                                                             Watermark="{Binding [OnlineLobby_ViewerChatWatermark], Source={x:Static i18n:I18nService.Instance}}"
                                                             MinHeight="34">
                                                        <TextBox.KeyBindings>
                                                            <KeyBinding Command="{Binding SendViewerChatCommand}" Gesture="Enter"/>
                                                        </TextBox.KeyBindings>
                                                    </TextBox>
                                                    <Button Grid.Column="1"
                                                            Command="{Binding SendViewerChatCommand}"
                                                            IsEnabled="{Binding CanSendViewerChat}"
                                                            MinWidth="64"
                                                            Height="34"
                                                            Padding="12,0"
                                                            Background="{DynamicResource ThemeAccentBrush}"
                                                            Foreground="White">
                                                        <TextBlock Text="{Binding [OnlineLobby_Send], Source={x:Static i18n:I18nService.Instance}}"/>
                                                    </Button>
                                                </Grid>
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding ViewerChatCooldownText}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource ThemeTextTertiaryBrush}"
                                                           IsVisible="{Binding HasViewerChatCooldownText}"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="1"
                                            Background="{DynamicResource CardBgBrush}"
                                            BorderBrush="{DynamicResource FloatingPanelBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10"
                                            Height="110">
                                        <Grid RowDefinitions="Auto,*" RowSpacing="6">
                                            <TextBlock Text="{Binding [OnlineLobby_GameReplies], Source={x:Static i18n:I18nService.Instance}}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource ThemeTextTertiaryBrush}"/>
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding SelectedRoom.Chats}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:EnsembleLobbyChat">
                                                            <Border Background="#10000000"
                                                                    CornerRadius="8"
                                                                    Padding="10,8"
                                                                    Margin="0,0,0,8">
                                                                <TextBlock Text="{Binding DisplayText}"
                                                                           FontSize="12"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{Binding MessageBrush}"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="2" Spacing="8">
                                        <TextBlock Text="{Binding [OnlineLobby_SendToGameChat], Source={x:Static i18n:I18nService.Instance}}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource ThemeTextTertiaryBrush}"/>
                                        <ItemsControl ItemsSource="{Binding Phrases}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                <Button Command="{Binding $parent[UserControl].DataContext.SendPhraseCommand}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding $parent[UserControl].DataContext.CanSendPhrase}"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Height="34"
                                                        Padding="12,0"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource ControlBgBrush}"
                                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                                        ToolTip.Tip="{Binding}">
                                                    <TextBlock Text="{Binding}"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                                </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding CooldownText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource ThemeTextTertiaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
