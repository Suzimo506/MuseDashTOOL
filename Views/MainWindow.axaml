<Window xmlns:i18n="using:MdModManager.Services" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MdModManager.ViewModels"
        xmlns:svc="using:MdModManager.Services"
        xmlns:helpers="using:MdModManager.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="MdModManager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding [Str_147], Source={x:Static i18n:I18nService.Instance}}"
        Icon="/Assets/MuseDashTOOL.ico"
        Width="1280" Height="800"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        FontFamily="{Binding CurrentFontFamily}"
        FontSize="{Binding CurrentFontSize}"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        UseLayoutRounding="True"
        CanResize="False">

    <!-- 最外层 Panel，用于在窗口左下角叠加通知气泡及最底层背景图 -->
    <Panel>

        <!-- 全局自定义背景图容器 -->
        <Grid IsHitTestVisible="False" 
              IsVisible="{Binding CustomBackgroundBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"
              Opacity="{Binding WindowOpacityValue}">
            <Image Source="{Binding CustomBackgroundBitmap}" 
                   Stretch="UniformToFill" 
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Image.Effect>
                    <BlurEffect Radius="{Binding BackgroundBlurRadius}" />
                </Image.Effect>
            </Image>
            <!-- 亮度调节遮罩层（黑色），透明度等于 1.0 - 明亮度 -->
            <Border Background="Black" Opacity="{Binding CustomBackgroundDarkness}" />
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarWidth}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧侧边栏，背景颜色由 ViewModel 动态控制 -->
            <Border Grid.Column="0" Background="{Binding SidebarBackground}" Padding="0,0,0,0" PointerPressed="OnSidebarPointerPressed" ClipToBounds="False">
                <Grid RowDefinitions="Auto,*,Auto" ClipToBounds="False">
                    
                    <!-- 顶部 Logo 与 折叠按钮区 -->
                    <Panel Grid.Row="0" Margin="10,25,10,25" Height="40">
                        <!-- 展开状态：显示 Logo 且折叠按钮靠右 -->
                        <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding IsSidebarExpanded}">
                            <Button Command="{Binding GenerateLogCommand}" 
                                    PointerPressed="OnTitlePointerPressed"
                                    Background="Transparent" BorderThickness="0" Padding="0" Margin="15,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                    <Style Selector="Button:pressed /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                </Button.Styles>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Image Source="/Assets/MuseDashTOOL.ico" Width="24" Height="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding [Str_147], Source={x:Static i18n:I18nService.Instance}}" FontSize="22" FontWeight="Bold" LetterSpacing="3" VerticalAlignment="Center">
                                        <TextBlock.Foreground>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                <GradientStop Color="#FF00FF" Offset="0"/>
                                                <GradientStop Color="#FF69B4" Offset="1"/>
                                            </LinearGradientBrush>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            
                            <Button Grid.Column="1"
                                    Command="{Binding ToggleSidebarCommand}"
                                    Width="32" Height="32"
                                    CornerRadius="16"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#33FF75A9"/>
                                    </Style>
                                    <Style Selector="Button:pressed /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#66FF75A9"/>
                                    </Style>
                                </Button.Styles>
                                <PathIcon Data="M512 774.4c12.8 12.8 12.8 32 0 44.8-6.4 6.4-19.2 12.8-25.6 12.8-6.4 0-19.2 0-19.2-6.4L147.2 512l320-313.6c12.8-6.4 32-6.4 44.8 6.4 12.8 12.8 12.8 32 0 44.8L236.8 512 512 774.4zM582.4 512l268.8-262.4c12.8-12.8 12.8-32 0-44.8s-32-12.8-44.8 0L492.8 512l320 313.6c0 6.4 12.8 6.4 19.2 6.4 6.4 0 19.2-6.4 25.6-12.8 12.8-12.8 12.8-32 0-44.8L582.4 512z" 
                                          Width="14" Height="14" 
                                          Foreground="{DynamicResource SvgIconBrush}"/>
                            </Button>
                        </Grid>
                        
                        <!-- 折叠状态：仅显示折叠按钮，且居中 -->
                        <Button IsVisible="{Binding !IsSidebarExpanded}"
                                Command="{Binding ToggleSidebarCommand}"
                                Width="36" Height="36"
                                CornerRadius="18"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#33FF75A9"/>
                                </Style>
                                <Style Selector="Button:pressed /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#66FF75A9"/>
                                </Style>
                            </Button.Styles>
                            <PathIcon Data="M512 774.4c12.8 12.8 12.8 32 0 44.8-6.4 6.4-19.2 12.8-25.6 12.8-6.4 0-19.2 0-19.2-6.4L147.2 512l320-313.6c12.8-6.4 32-6.4 44.8 6.4 12.8 12.8 12.8 32 0 44.8L236.8 512 512 774.4zM582.4 512l268.8-262.4c12.8-12.8 12.8-32 0-44.8s-32-12.8-44.8 0L492.8 512l320 313.6c0 6.4 12.8 6.4 19.2 6.4 6.4 0 19.2-6.4 25.6-12.8 12.8-12.8 12.8-32 0-44.8L582.4 512z" 
                                      Width="14" Height="14" 
                                      RenderTransform="scale(-1, 1)"
                                      RenderTransformOrigin="50%,50%"
                                      Foreground="{DynamicResource SvgIconBrush}"/>
                        </Button>
                    </Panel>
                    
                    <!-- Main Navigation (Top) -->
                    <StackPanel Grid.Row="1" Spacing="8" Margin="10,0" ClipToBounds="False">
                        <StackPanel.Styles>
                            <Style Selector="Button.NavBtn">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource NavButtonMainBrush}"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="15,0"/>
                                <Setter Property="MinHeight" Value="40"/>
                                <Setter Property="CornerRadius" Value="12"/>
                                <Setter Property="RenderTransform" Value="translateX(0px) scale(1.0)"/>
                                <Setter Property="Transitions">
                                    <Transitions>
                                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="SineEaseOut"/>
                                    </Transitions>
                                </Setter>
                            </Style>
                            <Style Selector="Button.NavBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="#33FF75A9"/>
                                <Setter Property="Foreground" Value="{DynamicResource NavButtonMainBrush}"/>
                            </Style>
                            <Style Selector="Button.NavBtn:pointerover">
                                <Setter Property="Foreground" Value="{DynamicResource NavButtonMainBrush}"/>
                            </Style>
                            <!-- 按钮子元素过渡动画 -->
                            <Style Selector="Button.NavBtn > StackPanel, Button.NavBtn > Grid, Button.NavBtn > TextBlock, Button.NavBtn > PathIcon">
                                <Setter Property="RenderTransform" Value="translateX(0px) scale(1.0)"/>
                                <Setter Property="Transitions">
                                    <Transitions>
                                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="SineEaseOut"/>
                                    </Transitions>
                                </Setter>
                            </Style>
                            <!-- 悬停时子元素平移 -->
                            <Style Selector="Button.NavBtn:pointerover > StackPanel, Button.NavBtn:pointerover > Grid, Button.NavBtn:pointerover > TextBlock, Button.NavBtn:pointerover > PathIcon">
                                <Setter Property="RenderTransform" Value="translateX(8px)"/>
                            </Style>
                            <!-- 折叠悬停时子元素缩放 -->
                            <Style Selector="Button.NavBtn.collapsed:pointerover > StackPanel, Button.NavBtn.collapsed:pointerover > Grid, Button.NavBtn.collapsed:pointerover > TextBlock, Button.NavBtn.collapsed:pointerover > PathIcon">
                                <Setter Property="RenderTransform" Value="scale(1.08)"/>
                            </Style>
                            <Style Selector="Button.NavBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource NavButtonMainBrush}"/>
                            </Style>
                            <Style Selector="Button.NavBtn:pressed">
                                <Setter Property="RenderTransform" Value="translateX(0px) scale(0.95)"/>
                                <Setter Property="Foreground" Value="{DynamicResource NavButtonMainBrush}"/>
                            </Style>
                            <Style Selector="Button.NavBtn:disabled /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource NavButtonMainBrush}"/>
                            </Style>
                            <Style Selector="Button.NavBtn:disabled">
                                <Setter Property="Foreground" Value="{DynamicResource NavButtonMainBrush}"/>
                                <Setter Property="Opacity" Value="1.0"/>
                            </Style>
                            <!-- 折叠状态下重构对齐和间隙 -->
                            <Style Selector="Button.NavBtn.collapsed">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </StackPanel.Styles>
                        
                        <LayoutTransformControl ClipToBounds="False">
                            <LayoutTransformControl.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding FontScale}" ScaleY="{Binding FontScale}"/>
                            </LayoutTransformControl.LayoutTransform>
                            <StackPanel Spacing="10" ClipToBounds="False">
                                <Button Classes="NavBtn" Classes.collapsed="{Binding !IsSidebarExpanded}" Command="{Binding NavigateToModManagerCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <PathIcon Data="M406.186667 120.874667a213.418667 213.418667 0 0 1 211.669333 0l3.370667 1.92a42.666667 42.666667 0 0 1-42.368 74.112l-3.370667-1.92a128.042667 128.042667 0 0 0-126.976 0L267.050667 298.666667a128 128 0 0 0-32.853334 26.794666l0.298667 0.170667L512 484.181333l277.504-158.549333c0.085333 0 0.170667-0.085333 0.256-0.170667A128 128 0 0 0 756.992 298.666667l-2.048-1.152a42.666667 42.666667 0 1 1 42.325333-74.069334l2.048 1.152a213.376 213.376 0 0 1 107.52 185.216v204.373334a213.333333 213.333333 0 0 1-107.52 185.173333l-181.461333 103.722667a213.376 213.376 0 0 1-211.669333 0l-3.413334-1.877334a42.666667 42.666667 0 0 1 42.410667-74.112l3.328 1.92a128 128 0 0 0 21.333333 9.728A42.88 42.88 0 0 1 469.333333 832v-273.92L202.666667 405.76c-0.042667 1.322667-0.128 2.688-0.128 4.053333v204.373334A128 128 0 0 0 267.093333 725.333333l2.048 1.152a42.666667 42.666667 0 0 1-42.368 74.069334l-2.005333-1.152a213.333333 213.333333 0 0 1-107.52-185.216v-204.373334a213.333333 213.333333 0 0 1 107.52-185.173333L406.186667 120.874667zM554.666667 558.08v273.92a42.368 42.368 0 0 1-0.597334 6.741333c7.338667-2.56 14.506667-5.802667 21.418667-9.728L756.992 725.333333a128 128 0 0 0 64.512-111.146666v-204.373334c0-1.365333-0.128-2.773333-0.170667-4.138666L554.666667 558.08z"
                                                  Width="18" Height="18"
                                                  Foreground="{DynamicResource NavButtonMainBrush}"/>
                                        <TextBlock Text="{Binding [Str_148], Source={x:Static i18n:I18nService.Instance}}" LetterSpacing="{Binding NavButtonLetterSpacing}" IsVisible="{Binding IsSidebarExpanded}"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="NavBtn" Classes.collapsed="{Binding !IsSidebarExpanded}" Command="{Binding NavigateToChartManagerCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <PathIcon Data="M870.4 307.568V262.4a57.664 57.664 0 0 0-51.2-57.232V160a57.664 57.664 0 0 0-57.6-57.6H262.4a57.664 57.664 0 0 0-57.6 57.6v45.168A57.664 57.664 0 0 0 153.6 262.4v45.168A57.664 57.664 0 0 0 102.4 364.8v550.4a57.664 57.664 0 0 0 57.6 57.6h704a57.664 57.664 0 0 0 57.6-57.6V364.8a57.664 57.664 0 0 0-51.2-57.232zM262.4 153.6h499.2a6.4 6.4 0 0 1 6.4 6.4v44.8H256v-44.8a6.4 6.4 0 0 1 6.4-6.4z m-51.2 102.4h601.6a6.4 6.4 0 0 1 6.4 6.4v44.8H204.8v-44.8a6.4 6.4 0 0 1 6.4-6.4z m659.2 659.2a6.4 6.4 0 0 1-6.4 6.4H160a6.4 6.4 0 0 1-6.4-6.4V364.8a6.4 6.4 0 0 1 6.4-6.4h704a6.4 6.4 0 0 1 6.4 6.4zM620.304 536.336a83.136 83.136 0 0 0-29.456-24.256 92.456 92.456 0 0 1-12-16.128C566.184 474.4 563.352 450.888 563.2 434.96a25.6 25.6 0 0 0-25.6-25.36h-0.12A25.6 25.6 0 0 0 512 435.2v240.368c-14.976-6.4-32.424-9.968-51.2-9.968-57.424 0-102.4 33.736-102.4 76.8s44.976 76.8 102.4 76.8 102.4-33.736 102.4-76.8V555.672a24.624 24.624 0 0 0 3.464 1.664 30.768 30.768 0 0 1 13.032 10.192c6.648 8.656 8.664 18.864 9.272 24.184a25.6 25.6 0 0 0 50.864-5.824c-1.48-12.928-6.064-32.024-19.528-49.552zM460.8 768c-31.256 0-51.2-15.2-51.2-25.6s19.944-25.6 51.2-25.6 51.2 15.2 51.2 25.6-19.944 25.6-51.2 25.6z"
                                                  Width="18" Height="18"
                                                  Foreground="{DynamicResource NavButtonMainBrush}"/>
                                        <TextBlock Text="{Binding [Str_064], Source={x:Static i18n:I18nService.Instance}}" LetterSpacing="{Binding NavButtonLetterSpacing}" IsVisible="{Binding IsSidebarExpanded}"/>
                                    </StackPanel>
                                </Button>
                                
                                <!-- 展开状态下的“谱面下载”二级悬浮卡片 -->
                                <Grid Name="ChartDownloadContainerExpanded" Height="40" ClipToBounds="False" ZIndex="10" IsVisible="{Binding IsSidebarExpanded}">
                                    <Border Background="{Binding FloatingPanelBackground}"
                                            BorderBrush="{Binding FloatingPanelBorder}"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Margin="-6,-6,-6,-180"
                                            BoxShadow="0 8 24 0 #60000000"
                                            IsVisible="{Binding IsChartDownloadMenuExpanded}"
                                            IsHitTestVisible="True"/>
                                    
                                    <StackPanel Spacing="4" VerticalAlignment="Top" ClipToBounds="False">
                                        <Button Classes="NavBtn" Command="{Binding ToggleChartDownloadMenuCommand}">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                                <PathIcon Grid.Column="0"
                                                           Data="M498.347 824.32l-296.96-296.96c-11.947-11.947-3.414-34.133 13.653-34.133h160.427c11.946 0 20.48-8.534 20.48-20.48V54.613c0-11.946 8.533-20.48 20.48-20.48h189.44c11.946 0 20.48 8.534 20.48 20.48v418.134c0 11.946 8.533 20.48 20.48 20.48h160.426c18.774 0 27.307 22.186 13.654 34.133L525.653 824.32c-6.826 6.827-20.48 6.827-27.306 0zM916.48 989.867H107.52c-18.773 0-35.84-15.36-35.84-35.84 0-18.774 15.36-35.84 35.84-35.84h810.667c18.773 0 35.84 15.36 35.84 35.84-1.707 20.48-17.067 35.84-37.547 35.84z"
                                                           Width="18" Height="18"
                                                           Foreground="{DynamicResource NavButtonMainBrush}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding [Str_149], Source={x:Static i18n:I18nService.Instance}}"
                                                           LetterSpacing="{Binding NavButtonLetterSpacing}"
                                                           VerticalAlignment="Center"/>
                                                <Panel Grid.Column="2" Width="13" Height="13" VerticalAlignment="Center">
                                                    <PathIcon Data="M256 384l256 256 256-256z"
                                                               Width="13"
                                                               Height="13"
                                                               Foreground="{DynamicResource NavButtonMainBrush}"
                                                               IsVisible="{Binding !IsChartDownloadMenuExpanded}"/>
                                                    <PathIcon Data="M256 640l256-256 256 256z"
                                                               Width="13"
                                                               Height="13"
                                                               Foreground="{DynamicResource NavButtonMainBrush}"
                                                               IsVisible="{Binding IsChartDownloadMenuExpanded}"/>
                                                </Panel>
                                            </Grid>
                                        </Button>
                                        <StackPanel Spacing="4"
                                                     Margin="18,0,0,0"
                                                     IsVisible="{Binding IsChartDownloadMenuExpanded}">
                                            <Button Classes="NavBtn" Command="{Binding NavigateToChartDownloadCommand}">
                                                <TextBlock Text="{Binding [Str_048], Source={x:Static i18n:I18nService.Instance}}" LetterSpacing="{Binding NavButtonLetterSpacing}"/>
                                            </Button>
                                            <Button Classes="NavBtn" Command="{Binding NavigateToEuterpeDownloadCommand}" ToolTip.Tip="{Binding EuterpeButtonToolTip}">
                                                <TextBlock Text="{Binding EuterpeButtonText}" LetterSpacing="{Binding NavButtonLetterSpacing}"/>
                                            </Button>
                                            <Button Classes="NavBtn" Command="{Binding NavigateToAlbumCollectionCommand}">
                                                <TextBlock Text="{Binding [Str_012], Source={x:Static i18n:I18nService.Instance}}" LetterSpacing="{Binding NavButtonLetterSpacing}"/>
                                            </Button>
                                            <!-- 下载列表子按钮 -->
                                            <Button Classes="NavBtn" Command="{Binding NavigateToDownloadManagerCommand}">
                                                <TextBlock Text="{Binding [Str_117], Source={x:Static i18n:I18nService.Instance}}" LetterSpacing="{Binding NavButtonLetterSpacing}"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- 折叠状态下的“谱面下载”二级悬浮卡片 -->
                                <Grid Name="ChartDownloadContainerCollapsed" Height="40" ClipToBounds="False" ZIndex="10" IsVisible="{Binding !IsSidebarExpanded}">
                                    <!-- 悬浮卡片背景，仅在展开时显示 -->
                                    <Border Background="{Binding FloatingPanelBackground}"
                                            BorderBrush="{Binding FloatingPanelBorder}"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Margin="-6,-6,-6,-180"
                                            BoxShadow="0 8 24 0 #60000000"
                                            IsVisible="{Binding IsChartDownloadMenuExpanded}"
                                            IsHitTestVisible="True"/>
                                    
                                    <StackPanel Spacing="4" VerticalAlignment="Top" ClipToBounds="False">
                                        <Button Classes="NavBtn" Classes.collapsed="True" Command="{Binding ToggleChartDownloadMenuCommand}">
                                            <PathIcon Data="M498.347 824.32l-296.96-296.96c-11.947-11.947-3.414-34.133 13.653-34.133h160.427c11.946 0 20.48-8.534 20.48-20.48V54.613c0-11.946 8.533-20.48 20.48-20.48h189.44c11.946 0 20.48 8.534 20.48 20.48v418.134c0 11.946 8.533 20.48 20.48 20.48h160.426c18.774 0 27.307 22.186 13.654 34.133L525.653 824.32c-6.826 6.827-20.48 6.827-27.306 0zM916.48 989.867H107.52c-18.773 0-35.84-15.36-35.84-35.84 0-18.774 15.36-35.84 35.84-35.84h810.667c18.773 0 35.84 15.36 35.84 35.84-1.707 20.48-17.067 35.84-37.547 35.84z"
                                                      Width="18" Height="18"
                                                      Foreground="{DynamicResource NavButtonMainBrush}"/>
                                        </Button>
                                        
                                        <!-- 向下展示的三个小图标按钮 -->
                                        <StackPanel Spacing="6" IsVisible="{Binding IsChartDownloadMenuExpanded}" ClipToBounds="False">
                                            <Button Classes="NavBtn" Classes.collapsed="True" Command="{Binding NavigateToChartDownloadCommand}" Height="36" MinHeight="36">
                                                <TextBlock Text="M" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource NavButtonMainBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                            <Button Classes="NavBtn" Classes.collapsed="True" Command="{Binding NavigateToEuterpeDownloadCommand}" Height="36" MinHeight="36" ToolTip.Tip="{Binding EuterpeButtonToolTip}">
                                                <TextBlock Text="E" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource NavButtonMainBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                            <Button Classes="NavBtn" Classes.collapsed="True" Command="{Binding NavigateToAlbumCollectionCommand}" Height="36" MinHeight="36">
                                                <TextBlock Text="Q" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource NavButtonMainBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                            <Button Classes="NavBtn" Classes.collapsed="True" Command="{Binding NavigateToDownloadManagerCommand}" Height="36" MinHeight="36">
                                                <PathIcon Data="M87.04 138.971429h850.651429v62.902857H87.04zM87.04 479.085714h399.36v62.902857H87.04zM87.04 822.125714H358.4v62.902857H87.04zM703.634286 376.685714h62.902857v463.725715h-62.902857z M736.548571 885.028571L533.211429 681.691429l43.885714-44.617143 159.451428 158.72 156.525715-156.525715 43.885714 44.617143z"
                                                          Width="15" Height="15"
                                                          Foreground="{DynamicResource NavButtonMainBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Button Classes="NavBtn" Classes.collapsed="{Binding !IsSidebarExpanded}" Command="{Binding NavigateToConfigManagerCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <PathIcon Data="M595.017 974.043H166.62c-65.609 0-119.003-54.637-119.003-121.782V316.562c0-67.072 53.394-121.783 119.003-121.783h428.398c57.417 0 105.472 41.838 116.59 97.28 15.36-4.388 30.866-7.899 46.592-9.874-15.58-77.531-82.798-136.046-163.182-136.046H342.31c11.117-55.588 59.172-97.426 116.59-97.426h231.13c65.683 0 119.077 54.638 119.077 121.71V280.43c16.092 0.731 31.89 2.925 47.543 6.144V170.423C856.65 76.434 781.97 0 690.103 0H458.97C375.223 0 306.47 63.78 294.766 146.14H166.619C74.752 146.14 0 222.573 0 316.561v535.699c0 93.988 74.752 170.422 166.62 170.422h428.397c72.192 0 133.12-47.542 156.306-113.298a302.592 302.592 0 0 1-46.372-10.752 119.15 119.15 0 0 1-109.934 75.41zM142.775 322.56H459.63v36.571H142.775V322.56z m0 162.377h244.004v36.498H142.775v-36.571z m0 162.377h244.004v36.499H142.775V647.24z m0 162.304H459.63v36.572H142.775v-36.572z m829.147-226.596l43.667-16.457a11.995 11.995 0 0 0 6.875-15.36l-36.352-100.572a11.63 11.63 0 0 0-14.994-7.022l-43.52 16.384c-5.998 2.341-13.312 1.317-16.238-2.194-2.926-3.51-8.997-17.042-6.363-22.894l19.456-43.154a12.069 12.069 0 0 0-5.706-15.799l-95.158-44.91a11.557 11.557 0 0 0-15.434 5.852L788.7 380.05c-2.706 5.925-8.557 10.533-13.019 10.24-4.389-0.292-18.14-5.34-20.334-11.483l-16.091-44.69a11.703 11.703 0 0 0-14.994-7.095l-98.304 37.156a11.995 11.995 0 0 0-6.949 15.36l16.091 44.617c2.195 6.071 1.317 13.605-2.194 16.604-3.364 2.926-16.457 9.216-22.308 6.436l-42.13-19.894a11.557 11.557 0 0 0-15.434 5.851l-43.886 97.426a12.142 12.142 0 0 0 5.632 15.8l42.13 19.894c5.852 2.78 10.314 8.777 10.021 13.166-0.22 4.608-5.266 18.651-11.264 20.919l-43.593 16.457a11.995 11.995 0 0 0-6.875 15.36l36.279 100.644a11.703 11.703 0 0 0 14.92 7.095l43.594-16.457c5.998-2.34 13.385-1.317 16.238 2.194 2.998 3.365 9.07 16.896 6.363 22.894l-19.456 43.008a12.142 12.142 0 0 0 5.705 15.799l95.232 44.983c5.852 2.706 12.8 0.073 15.433-5.852l19.456-43.08c2.633-5.999 8.485-10.533 12.947-10.24 4.388 0.219 18.139 5.339 20.333 11.483l16.092 44.544c2.194 6.144 8.923 9.362 14.92 7.094l98.451-37.083a12.142 12.142 0 0 0 6.876-15.36l-16.092-44.617c-2.194-6.144-1.243-13.605 2.194-16.604 3.438-2.998 16.53-9.216 22.455-6.436l42.057 19.895a11.63 11.63 0 0 0 15.434-5.852l43.885-97.426a12.069 12.069 0 0 0-5.778-15.872l-41.984-19.822c-5.851-2.78-9.801-17.188-9.801-21.65 0-4.535 4.9-10.167 10.971-12.434z m-167.79 120.612a115.931 115.931 0 0 1-149.65-70.583c-22.235-61.732 8.631-130.34 69.047-153.16a115.785 115.785 0 0 1 149.577 70.582c22.236 61.806-8.63 130.414-68.973 153.161z"
                                                   Width="18" Height="18"
                                                   Foreground="{DynamicResource NavButtonMainBrush}"/>
                                        <TextBlock Text="{Binding [Str_105], Source={x:Static i18n:I18nService.Instance}}" LetterSpacing="{Binding NavButtonLetterSpacing}" IsVisible="{Binding IsSidebarExpanded}"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="NavBtn" Classes.collapsed="{Binding !IsSidebarExpanded}" Command="{Binding NavigateToAccountCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <PathIcon Data="M512 128a192 192 0 1 0 192 192A192 192 0 0 0 512 128z m0 469.333333c-128 0-384 64-384 192v42.666667h768v-42.666667c0-128-256-192-384-192z"
                                                  Width="18" Height="18"
                                                  Foreground="{DynamicResource NavButtonMainBrush}"/>
                                        <TextBlock Text="{Binding [Str_150], Source={x:Static i18n:I18nService.Instance}}" LetterSpacing="{Binding NavButtonLetterSpacing}" IsVisible="{Binding IsSidebarExpanded}"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="NavBtn" Classes.collapsed="{Binding !IsSidebarExpanded}" Command="{Binding NavigateToTutorialCommand}">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <PathIcon Data="M512 85.333333C276.266667 85.333333 85.333333 276.266667 85.333333 512s190.933333 426.666667 426.666667 426.666667 426.666667-190.933333 426.666667-426.666667S747.733333 85.333333 512 85.333333z m42.666667 640h-85.333334v-256h85.333334v256z m0-341.333333h-85.333334v-85.333333h85.333334v85.333333z"
                                                      Width="18" Height="18"
                                                      Foreground="{DynamicResource NavButtonMainBrush}"/>
                                            <TextBlock Text="{Binding [Str_151], Source={x:Static i18n:I18nService.Instance}}" LetterSpacing="{Binding NavButtonLetterSpacing}" IsVisible="{Binding IsSidebarExpanded}"/>
                                        </StackPanel>
                                        <Ellipse Width="8" Height="8" Fill="#FF4444"
                                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                                 Margin="0,-2,-12,0"
                                                 IsVisible="{Binding ShowTutorialBadge}">
                                            <Ellipse.Styles>
                                                <Style Selector="Ellipse">
                                                    <Style.Animations>
                                                        <Animation Duration="0:0:1.5" IterationCount="INFINITE" PlaybackDirection="Alternate">
                                                            <KeyFrame Cue="0%">
                                                                <Setter Property="Opacity" Value="1.0"/>
                                                            </KeyFrame>
                                                            <KeyFrame Cue="100%">
                                                                <Setter Property="Opacity" Value="0.3"/>
                                                            </KeyFrame>
                                                        </Animation>
                                                    </Style.Animations>
                                                </Style>
                                            </Ellipse.Styles>
                                        </Ellipse>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </LayoutTransformControl>
                    </StackPanel>
                    
                    <!-- Footer Navigation (Bottom) -->
                    <StackPanel Grid.Row="2" Spacing="8" Margin="10,0,10,20">
                        <StackPanel.Styles>
                            <Style Selector="Button.NavBtn">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource NavButtonSubBrush}"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="15"/>
                                <Setter Property="Padding" Value="15,0"/>
                                <Setter Property="MinHeight" Value="42"/>
                                <Setter Property="CornerRadius" Value="12"/>
                                <Setter Property="RenderTransform" Value="translateX(0px) scale(1.0)"/>
                                <Setter Property="Transitions">
                                    <Transitions>
                                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="SineEaseOut"/>
                                    </Transitions>
                                </Setter>
                            </Style>
                            <Style Selector="Button.NavBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="#33FF75A9"/>
                                <Setter Property="Foreground" Value="{DynamicResource NavButtonSubBrush}"/>
                            </Style>
                            <Style Selector="Button.NavBtn:pointerover">
                                <Setter Property="Foreground" Value="{DynamicResource NavButtonSubBrush}"/>
                            </Style>
                            <!-- 按钮子元素过渡动画 -->
                            <Style Selector="Button.NavBtn > StackPanel, Button.NavBtn > Grid, Button.NavBtn > TextBlock, Button.NavBtn > PathIcon">
                                <Setter Property="RenderTransform" Value="translateX(0px) scale(1.0)"/>
                                <Setter Property="Transitions">
                                    <Transitions>
                                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="SineEaseOut"/>
                                    </Transitions>
                                </Setter>
                            </Style>
                            <!-- 悬停时子元素平移 -->
                            <Style Selector="Button.NavBtn:pointerover > StackPanel, Button.NavBtn:pointerover > Grid, Button.NavBtn:pointerover > TextBlock, Button.NavBtn:pointerover > PathIcon">
                                <Setter Property="RenderTransform" Value="translateX(8px)"/>
                            </Style>
                            <!-- 折叠悬停时子元素缩放 -->
                            <Style Selector="Button.NavBtn.collapsed:pointerover > StackPanel, Button.NavBtn.collapsed:pointerover > Grid, Button.NavBtn.collapsed:pointerover > TextBlock, Button.NavBtn.collapsed:pointerover > PathIcon">
                                <Setter Property="RenderTransform" Value="scale(1.08)"/>
                            </Style>
                            <Style Selector="Button.NavBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource NavButtonSubBrush}"/>
                            </Style>
                            <Style Selector="Button.NavBtn:pressed">
                                <Setter Property="RenderTransform" Value="translateX(0px) scale(0.95)"/>
                                <Setter Property="Foreground" Value="{DynamicResource NavButtonSubBrush}"/>
                            </Style>
                            <Style Selector="Button.NavBtn:disabled /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource NavButtonSubBrush}"/>
                            </Style>
                            <Style Selector="Button.NavBtn:disabled">
                                <Setter Property="Foreground" Value="{DynamicResource NavButtonSubBrush}"/>
                                <Setter Property="Opacity" Value="1.0"/>
                            </Style>
                            <Style Selector="Button.NavBtn.collapsed">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </StackPanel.Styles>
                        
                        <!-- 启动/重启游戏按钮 + 暂存 Mod 提醒 -->
                        <LayoutTransformControl>
                            <LayoutTransformControl.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding FontScale}" ScaleY="{Binding FontScale}"/>
                            </LayoutTransformControl.LayoutTransform>
                            <StackPanel Spacing="8">
                                <!-- 折叠状态下的喵斯兔小图标 -->
                                <Image Source="/Assets/MuseDashTOOL.ico"
                                       Width="28" Height="28"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,2"
                                       IsVisible="{Binding !IsSidebarExpanded}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Button Grid.Column="0" Classes="NavBtn" Classes.collapsed="{Binding !IsSidebarExpanded}" Command="{Binding LaunchGameCommand}">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <PathIcon Data="M896 512L128 1024V0z"
                                                          Width="18" Height="18"
                                                          Foreground="{DynamicResource NavButtonSubBrush}"/>
                                                <TextBlock Text="{Binding [Str_152], Source={x:Static i18n:I18nService.Instance}}" IsVisible="{Binding IsSidebarExpanded}"/>
                                            </StackPanel>
                                            <!-- 折叠状态下的红点提示 -->
                                            <Ellipse Width="8" Height="8" Fill="#FF4444"
                                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                                     Margin="0,-2,-2,0"
                                                     ToolTip.Tip="{Binding [Str_153], Source={x:Static i18n:I18nService.Instance}}">
                                                <Ellipse.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="!IsSidebarExpanded"/>
                                                        <Binding Path="HasStagedMods"/>
                                                    </MultiBinding>
                                                </Ellipse.IsVisible>
                                            </Ellipse>
                                        </Grid>
                                    </Button>
                                    <TextBlock Grid.Column="1"
                                               Text="!!!"
                                               Foreground="{DynamicResource ThemeTextMainBrush}"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Margin="4,0,8,0"
                                               ToolTip.Tip="{Binding [Str_153], Source={x:Static i18n:I18nService.Instance}}">
                                        <TextBlock.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="IsSidebarExpanded"/>
                                                <Binding Path="HasStagedMods"/>
                                            </MultiBinding>
                                        </TextBlock.IsVisible>
                                    </TextBlock>
                                </Grid>
                                <Button Classes="NavBtn" Classes.collapsed="{Binding !IsSidebarExpanded}" Command="{Binding NavigateToSponsorCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <PathIcon Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                                                  Width="18" Height="18"
                                                  Foreground="{DynamicResource NavButtonSubBrush}"/>
                                        <TextBlock Text="{Binding [Str_154], Source={x:Static i18n:I18nService.Instance}}" IsVisible="{Binding IsSidebarExpanded}"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="NavBtn" Classes.collapsed="{Binding !IsSidebarExpanded}" Command="{Binding NavigateToSettingsCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <PathIcon Data="M896 554.666667v-85.333334l-94.293333-12.373333a292.266667 292.266667 0 0 0-24.746667-59.733333l57.173333-76.373334-60.373333-60.373333-76.373333 57.173333a292.266667 292.266667 0 0 0-59.733334-24.746666L554.666667 128h-85.333334l-12.373333 94.293333a292.266667 292.266667 0 0 0-59.733333 24.746667l-76.373334-57.173333-60.373333 60.373333 57.173333 76.373333a292.266667 292.266667 0 0 0-24.746666 59.733334L128 469.333333v85.333334l94.293333 12.373333a292.266667 292.266667 0 0 0 24.746667 59.733333l-57.173333 76.373334 60.373333 60.373333 76.373333-57.173333a292.266667 292.266667 0 0 0 59.733334 24.746666L469.333333 896h85.333334l12.373333-94.293333a292.266667 292.266667 0 0 0 59.733333-24.746667l76.373334 57.173333 60.373333-60.373333-57.173333-76.373333a292.266667 292.266667 0 0 0 24.746666-59.733334L896 554.666667zM512 682.666667a170.666667 170.666667 0 1 1 170.666667-170.666667 170.666667 170.666667 0 0 1-170.666667 170.666667z"
                                                  Width="18" Height="18"
                                                  Foreground="{DynamicResource NavButtonSubBrush}"/>
                                        <TextBlock Text="{Binding [Str_155], Source={x:Static i18n:I18nService.Instance}}" IsVisible="{Binding IsSidebarExpanded}"/>
                                    </StackPanel>
                                </Button>
                                
                                <Border Height="1" Background="{DynamicResource ThemeTextSubBrush}" Opacity="0.2" Margin="10,10,10,5"/>
                                <Button Classes="NavBtn" Classes.collapsed="{Binding !IsSidebarExpanded}" Click="OnSelectGamePathClick">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <PathIcon Data="M928 352v-48c0-35.3-28.7-64-64-64H485.2c-21 0-40.7-10.3-52.6-27.6l-61.5-88.9c-12-17.3-31.6-27.6-52.6-27.6H64c-35.3 0-64 28.7-64 64v656c0 70.7 57.3 128 128 128h638c57.8 0 108.5-38.8 123.6-94.6L928 707.2l74.2-274.5c11-40.7-19.6-80.7-61.8-80.7H928z"
                                                  Width="18" Height="18"
                                                  Foreground="{DynamicResource NavButtonSubBrush}"/>
                                        <TextBlock Text="{Binding [Str_156], Source={x:Static i18n:I18nService.Instance}}" IsVisible="{Binding IsSidebarExpanded}"/>
                                    </StackPanel>
                                </Button>
                                <!-- 版本号精准对齐并在折叠时隐去 -->
                                <TextBlock Text="v1.4.6" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource ThemeTextSubBrush}" 
                                           Opacity="0.6" 
                                           Margin="25,8,0,0" 
                                           HorizontalAlignment="Left"
                                           IsVisible="{Binding IsSidebarExpanded}"/>
                            </StackPanel>
                        </LayoutTransformControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <!-- 内容区域背景由ViewModel动态控制 -->
            <Border Grid.Column="1" 
                    Background="{Binding ContentBackground}">
                <LayoutTransformControl Margin="20,55,35,35">
                    <LayoutTransformControl.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding FontScale}" ScaleY="{Binding FontScale}"/>
                    </LayoutTransformControl.LayoutTransform>
                    <ContentControl Content="{Binding CurrentPage}"/>
                </LayoutTransformControl>
            </Border>
        </Grid>

        <!-- 全局公告弹窗遮罩 -->
        <Grid IsVisible="{Binding IsAnnouncementVisible}" Background="#D909070F">
            <Border Width="440" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#EC131118" BorderBrush="#1EFFFFFF" BorderThickness="1"
                    CornerRadius="24" Padding="28,26,28,26"
                    BoxShadow="0 20 60 0 #B0000000">
                <StackPanel Spacing="18">
                    <!-- 顶部简约角标 -->
                    <Border Background="{Binding CurrentAnnouncement.DisplayBadgeBackgroundColor}" 
                            BorderBrush="{Binding CurrentAnnouncement.DisplayBadgeBorderColor}" 
                            BorderThickness="1" CornerRadius="10" Padding="12,4" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="5" Height="5" Fill="{Binding CurrentAnnouncement.DisplayBadgeColor}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentAnnouncement.DisplayBadge}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding CurrentAnnouncement.DisplayBadgeColor}" LetterSpacing="2" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 标题渐变字 -->
                    <TextBlock Text="{Binding CurrentAnnouncement.DisplayTitle}"
                               FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Color="#FFFF75A9" Offset="0"/>
                                <GradientStop Color="#FFFF4081" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>

                    <!-- 内容卡片 -->
                    <Border Background="#07FFFFFF" BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="16" Padding="20,16">
                        <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
                            <TextBlock helpers:TextBlockHelper.MarkupText="{Binding CurrentAnnouncement.DisplayContent}"
                                       TextWrapping="Wrap" LineHeight="22" FontSize="13.5"
                                       Foreground="#E2E2E8"
                                       Opacity="0.9"/>
                        </ScrollViewer>
                    </Border>

                    <!-- 底部双按钮布局 -->
                    <Grid ColumnDefinitions="*,*">
                        <!-- 左侧不再提示按钮 -->
                        <Button Grid.Column="0" 
                                Command="{Binding SuppressAndCloseAnnouncementCommand}"
                                Height="38" Margin="0,0,8,0"
                                CornerRadius="19"
                                Background="Transparent"
                                BorderBrush="#25FFFFFF"
                                BorderThickness="1"
                                Foreground="#A0A0A5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Transitions">
                                        <Transitions>
                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="SineEaseOut"/>
                                            <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                                            <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                                        </Transitions>
                                    </Setter>
                                    <Setter Property="RenderTransform" Value="scale(1.0)"/>
                                </Style>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="BorderBrush" Value="#40FFFFFF"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="RenderTransform" Value="scale(1.02)"/>
                                </Style>
                                <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="#40FFFFFF"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Style>
                                <Style Selector="Button:pressed">
                                    <Setter Property="RenderTransform" Value="scale(0.98)"/>
                                    <Setter Property="Opacity" Value="0.8"/>
                                </Style>
                                <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="#0AFFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#30FFFFFF"/>
                                    <Setter Property="Foreground" Value="#EEEEEE"/>
                                </Style>
                            </Button.Styles>
                            <TextBlock Text="{Binding CurrentAnnouncement.DisplayCancelButtonText}"
                                       FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        
                        <!-- 右侧确认按钮 -->
                        <Button Grid.Column="1" 
                                Command="{Binding CloseAnnouncementCommand}"
                                Height="38" Margin="8,0,0,0"
                                CornerRadius="19"
                                Foreground="White"
                                BorderThickness="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                    <GradientStop Color="#FF75A9" Offset="0"/>
                                    <GradientStop Color="#FF1A7D" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Transitions">
                                        <Transitions>
                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="SineEaseOut"/>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                                        </Transitions>
                                    </Setter>
                                    <Setter Property="RenderTransform" Value="scale(1.0)"/>
                                </Style>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="RenderTransform" Value="scale(1.04)"/>
                                    <Setter Property="Opacity" Value="0.95"/>
                                </Style>
                                <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background">
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                            <GradientStop Color="#FF75A9" Offset="0"/>
                                            <GradientStop Color="#FF1A7D" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                                <Style Selector="Button:pressed">
                                    <Setter Property="RenderTransform" Value="scale(0.96)"/>
                                    <Setter Property="Opacity" Value="0.8"/>
                                </Style>
                                <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background">
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                            <GradientStop Color="#FF75A9" Offset="0"/>
                                            <GradientStop Color="#FF1A7D" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                            </Button.Styles>
                            <TextBlock Text="{Binding CurrentAnnouncement.DisplayActionButtonText}" 
                                       FontWeight="Bold" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <!-- 全局通知气泡：叠加在最上层 -->
        <ItemsControl ItemsSource="{Binding Notifications}"
                      VerticalAlignment="Bottom" HorizontalAlignment="Left"
                      Margin="20,0,0,20"
                      IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" Spacing="10"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="14" Padding="15,10" Opacity="{Binding Opacity}"
                            BoxShadow="0 4 12 0 #40000000">
                        <Border.Background>
                            <Binding Path="IsSuccess">
                                <Binding.Converter>
                                    <helpers:BoolToBrushConverter TrueBrush="#E8F5E9" FalseBrush="#FFEBEE"/>
                                </Binding.Converter>
                            </Binding>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <!-- 根据状态显示不同图标 -->
                            <Path IsVisible="{Binding IsSuccess}" Data="M512 0a512 512 0 1 0 512 512A512 512 0 0 0 512 0z m255.488 387.584L452.928 705.408a46.208 46.208 0 0 1-65.792 0L256.512 574.912a46.208 46.208 0 1 1 65.792-65.792L420 606.528l281.28-284.736a46.208 46.208 0 0 1 66.208 65.792z"
                                  Fill="#4CAF50" Width="18" Height="18" Stretch="Uniform"/>
                            <Path IsVisible="{Binding IsInfo}" Data="M512 64C264.6 64 64 264.6 64 512s200.6 448 448 448 448-200.6 448-448S759.4 64 512 64z m0 820c-205.4 0-372-166.6-372-372s166.6-372 372-372 372 166.6 372 372-166.6 372-372 372z m28-564h-56v312h56V320z m0 384h-56v56h56v-56z"
                                  Fill="#2196F3" Width="18" Height="18" Stretch="Uniform"/>
                            <Path Data="M512 64C264.6 64 64 264.6 64 512s200.6 448 448 448 448-200.6 448-448S759.4 64 512 64z m165.4 548.2c1.4 1.4 2.1 3.2 2.1 5.1s-0.7 3.7-2.1 5.1L637 662.8c-1.4 1.4-3.2 2.1-5.1 2.1s-3.7-0.7-5.1-2.1L512 547.9 397.1 662.8c-1.4 1.4-3.2 2.1-5.1 2.1s-3.7-0.7-5.1-2.1L346.5 622.4c-1.4-1.4-2.1-3.2-2.1-5.1s0.7-3.7 2.1-5.1L461.4 512 346.5 397.1c-1.4-1.4-2.1-3.2-2.1-5.1s0.7-3.7 2.1-5.1l40.4-40.4c1.4-1.4 3.2-2.1 5.1-2.1s3.7 0.7 5.1 2.1L512 476.1l114.9-114.9c1.4-1.4 3.2-2.1 5.1-2.1s3.7 0.7 5.1 2.1l40.4 40.4c1.4 1.4 2.1 3.2 2.1 5.1s-0.7 3.7-2.1 5.1L562.6 512l114.8 114.8z"
                                  Fill="#F44336" Width="18" Height="18" Stretch="Uniform">
                                <Path.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="!IsSuccess"/>
                                        <Binding Path="!IsInfo"/>
                                    </MultiBinding>
                                </Path.IsVisible>
                            </Path>

                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{Binding Message}" FontSize="13" FontWeight="SemiBold">
                                    <TextBlock.Foreground>
                                        <Binding Path="IsSuccess">
                                            <Binding.Converter>
                                                <helpers:BoolToBrushConverter TrueBrush="#2E7D32" FalseBrush="#C62828"/>
                                            </Binding.Converter>
                                        </Binding>
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <ProgressBar IsVisible="{Binding ShowProgress}" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Height="4" Foreground="#d4237a" HorizontalAlignment="Stretch" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>


    </Panel>
</Window>
