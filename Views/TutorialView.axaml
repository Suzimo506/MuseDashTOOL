<UserControl xmlns:i18n="using:MdModManager.Services" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MdModManager.ViewModels"
             x:Class="MdModManager.Views.TutorialView"
             x:DataType="vm:TutorialViewModel">

    <UserControl.Resources>
        <!-- 基础透明按钮主体 -->
        <ControlTheme x:Key="RobustPlainIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="RootBorder" Background="Transparent">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#RootBorder">
                <Setter Property="Opacity" Value="0.8"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#RootBorder">
                <Setter Property="Opacity" Value="0.6"/>
            </Style>
        </ControlTheme>

        <!-- 文字链接按钮主题 -->
        <ControlTheme x:Key="LinkTextBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      Background="Transparent"
                                      BorderThickness="0"/>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Opacity" Value="0.7"/>
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <Grid RowDefinitions="*">
        <!-- ScrollViewer 明确设置垂直滚动可用，水平禁用，防止容器不闭合导致的滚动失败 -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="30" Margin="30,30,30,60" MaxWidth="1000" HorizontalAlignment="Stretch">
                <!-- 标题 -->
                <TextBlock Text="{Binding [Str_267], Source={x:Static i18n:I18nService.Instance}}" 
                           FontSize="28" FontWeight="Bold" 
                           HorizontalAlignment="Center">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="#FF00FF" Offset="0"/>
                            <GradientStop Color="#FF69B4" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>

                     <!-- Introduction -->
                <TextBlock Text="{Binding [Str_AboutIntro], Source={x:Static i18n:I18nService.Instance}}"
                           FontSize="15" Foreground="{DynamicResource ThemeTextMainBrush}"
                           TextWrapping="Wrap" LineHeight="24" TextAlignment="Center"
                           Margin="0,0,0,10"/>

                <!-- Cards Container -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="20" RowDefinitions="Auto">
                    <!-- Developer Card -->
                    <Border Grid.Column="0" CornerRadius="16" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource ShellOutlineBrush}" BorderThickness="1" Padding="24">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                            <!-- Left: Avatar image -->
                            <Border Grid.Column="0" Width="80" Height="80" CornerRadius="40" BorderBrush="{DynamicResource ThemeAccentBrush}" BorderThickness="2" VerticalAlignment="Top">
                                <Border.Background>
                                    <ImageBrush Source="avares://MuseDashTOOL/Assets/Suzimo.jpg" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            
                            <!-- Right: Details -->
                            <StackPanel Grid.Column="1" Spacing="8">
                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" HorizontalAlignment="Left" Padding="6,2">
                                    <TextBlock Text="{Binding [Str_LeadDeveloper], Source={x:Static i18n:I18nService.Instance}}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentBrush}"/>
                                </Border>
                                
                                <TextBlock Text="{Binding [Str_DevName], Source={x:Static i18n:I18nService.Instance}}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                
                                <TextBlock Text="{Binding [Str_DevDesc], Source={x:Static i18n:I18nService.Instance}}" FontSize="13" Foreground="{DynamicResource ThemeTextSubBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                
                                <!-- Buttons row -->
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                    <Button Command="{Binding OpenUrlCommand}" CommandParameter="https://space.bilibili.com/289883561?spm_id_from=333.1007.0.0" Height="32" Padding="12,0" Background="{DynamicResource ControlBgBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Background" Value="{DynamicResource ControlHoverBgBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                                            </Style>
                                        </Button.Styles>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="M306.005333 117.632L444.330667 256h135.296l138.368-138.325333a42.666667 42.666667 0 1 1 60.373333 60.373333l-78.037333 77.952L789.333333 256A149.333333 149.333333 0 0 1 938.666667 405.333333v341.333334a149.333333 149.333333 0 0 1-149.333334 149.333333h-554.666666A149.333333 149.333333 0 0 1 85.333333 746.666667v-341.333334A149.333333 149.333333 0 0 1 234.666667 256h88.96L245.632 177.962667a42.666667 42.666667 0 0 1 60.373333-60.373334zM789.333333 341.333333h-554.666666a64 64 0 0 0-63.701334 57.856L170.666667 405.333333v341.333334a64 64 0 0 0 57.856 63.701333L234.666667 810.666667h554.666666a64 64 0 0 0 63.701334-57.813334L853.333333 746.666667v-341.333334A64 64 0 0 0 789.333333 341.333333zM341.333333 469.333333a42.666667 42.666667 0 0 1 42.666667 42.666667v85.333333a42.666667 42.666667 0 1 1-85.333333 0v-85.333333a42.666667 42.666667 0 0 1 42.666666-42.666667z m341.333334 0a42.666667 42.666667 0 0 1 42.666666 42.666667v85.333333a42.666667 42.666667 0 1 1-85.333333 0v-85.333333a42.666667 42.666667 0 0 1 42.666667-42.666667z"
                                                     Foreground="#FF6699" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="Bilibili" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMainBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/Suzimo506/MuseDashTOOL" Height="32" Padding="12,0" Background="{DynamicResource ControlBgBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Background" Value="{DynamicResource ControlHoverBgBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                                            </Style>
                                        </Button.Styles>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="M12 2C6.477 2 2 6.477 2 12c0 4.419 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.577.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z" 
                                                      Foreground="#FF6699" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="GitHub" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMainBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Artist Card -->
                    <Border Grid.Column="1" CornerRadius="16" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource ShellOutlineBrush}" BorderThickness="1" Padding="24">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                            <!-- Left: Avatar image -->
                            <Border Grid.Column="0" Width="80" Height="80" CornerRadius="40" BorderBrush="{DynamicResource ThemeAccentBrush}" BorderThickness="2" VerticalAlignment="Top">
                                <Border.Background>
                                    <ImageBrush Source="avares://MuseDashTOOL/Assets/maomaotou.jpg" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            
                            <!-- Right: Details -->
                            <StackPanel Grid.Column="1" Spacing="8">
                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" HorizontalAlignment="Left" Padding="6,2">
                                    <TextBlock Text="{Binding [Str_VisualDesign], Source={x:Static i18n:I18nService.Instance}}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentBrush}"/>
                                </Border>
                                
                                <TextBlock Text="{Binding [Str_ArtistName], Source={x:Static i18n:I18nService.Instance}}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                
                                <TextBlock Text="{Binding [Str_ArtistDesc], Source={x:Static i18n:I18nService.Instance}}" FontSize="13" Foreground="{DynamicResource ThemeTextSubBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                
                                <!-- Buttons row -->
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                    <Button Command="{Binding OpenUrlCommand}" CommandParameter="https://v.douyin.com/EsV7a27lsdI/" Height="32" Padding="12,0" Background="{DynamicResource ControlBgBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Background" Value="{DynamicResource ControlHoverBgBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                                            </Style>
                                        </Button.Styles>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="M885.88671875 434.56835937c-73.828125 0-145.63476563-23.99414063-204.69726563-68.37890624v309.63867187c0 158.11523438-121.81640625 286.171875-272.10937499 286.171875S136.97070313 833.94335938 136.97070313 675.828125c0-158.11523438 121.81640625-286.171875 272.109375-286.17187499 15.02929689 0 29.61914063 1.31835938 43.85742187 3.77929687v164.00390624c-13.62304688-5.36132813-28.125-8.0859375-42.71484375-8.08593749-67.06054688 0-121.46484375 57.12890625-121.46484375 127.70507812 0 70.48828125 54.40429689 127.70507813 121.46484375 127.70507813 66.97265625 0 121.37695313-57.21679689 121.37695313-127.70507813V62H683.38671875c0 118.21289063 91.14257813 214.01367188 203.5546875 214.01367188v158.46679687l-1.0546875 0.08789063" 
                                                      Foreground="#FF6699" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="Douyin" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMainBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Community Card -->
                <Border CornerRadius="16" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource ShellOutlineBrush}" BorderThickness="1" Padding="24">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding [Str_AboutCommunityTitle], Source={x:Static i18n:I18nService.Instance}}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMainBrush}"/>
                        
                        <TextBlock Text="{Binding [Str_AboutCommunityDesc], Source={x:Static i18n:I18nService.Instance}}" FontSize="13" Foreground="{DynamicResource ThemeTextSubBrush}" TextWrapping="Wrap" LineHeight="20"/>
                        
                        <!-- Community Buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,6,0,0">
                            <Button Command="{Binding OpenUrlCommand}" CommandParameter="https://space.bilibili.com/130793282" Height="34" Padding="16,0" Background="{DynamicResource ControlBgBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource ControlHoverBgBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                                    </Style>
                                </Button.Styles>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="M306.005333 117.632L444.330667 256h135.296l138.368-138.325333a42.666667 42.666667 0 1 1 60.373333 60.373333l-78.037333 77.952L789.333333 256A149.333333 149.333333 0 0 1 938.666667 405.333333v341.333334a149.333333 149.333333 0 0 1-149.333334 149.333333h-554.666666A149.333333 149.333333 0 0 1 85.333333 746.666667v-341.333334A149.333333 149.333333 0 0 1 234.666667 256h88.96L245.632 177.962667a42.666667 42.666667 0 0 1 60.373333-60.373334zM789.333333 341.333333h-554.666666a64 64 0 0 0-63.701334 57.856L170.666667 405.333333v341.333334a64 64 0 0 0 57.856 63.701333L234.666667 810.666667h554.666666a64 64 0 0 0 63.701334-57.813334L853.333333 746.666667v-341.333334A64 64 0 0 0 789.333333 341.333333zM341.333333 469.333333a42.666667 42.666667 0 0 1 42.666667 42.666667v85.333333a42.666667 42.666667 0 1 1-85.333333 0v-85.333333a42.666667 42.666667 0 0 1 42.666666-42.666667z m341.333334 0a42.666667 42.666667 0 0 1 42.666666 42.666667v85.333333a42.666667 42.666667 0 1 1-85.333333 0v-85.333333a42.666667 42.666667 0 0 1 42.666667-42.666667z"
                                             Foreground="#FF6699" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="GreenHub (Bilibili)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMainBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Command="{Binding OpenUrlCommand}" CommandParameter="https://qun.qq.com/universal-share/share?ac=1&amp;authKey=YhHRlhAB7QZyQ3FcX4Sy2QOD1XdUyMu26%2FRGmr8IBvYxvSv5hnl7YKB%2FjQ0Z5l2K&amp;busi_data=eyJncm91cENvZGUiOiIzMzE1Njg3ODMiLCJ0b2tlbiI6IlMyUktWUXFJU1lVelZaUENLYktvWWtvY2FyRVZnK1ZRMW14amRGRlFyMndKS2JpcFIyRFlMd1hkSHh4WDNWSU0iLCJ1aW4iOiIxOTc1ODM4NjAyIn0%3D&amp;data=nL9sb2jFJvI5JGoPB-pW8rqOIE09UChRBB6KDjicxobhAjZhLFkuz1FK-iqA5CEEiPM-jVsvOCYbH1hnJ_9o-Q&amp;svctype=4&amp;tempid=h5_group_info" Height="34" Padding="16,0" Background="{DynamicResource ControlBgBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" ToolTip.Tip="加入群聊">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource ControlHoverBgBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                                    </Style>
                                </Button.Styles>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="M824.8 613.2c-16-51.4-34.4-94.6-62.7-165.3C766.5 262.2 689.3 112 511.5 112 331.7 112 256.2 265.2 261 447.9c-28.4 70.8-46.7 113.7-62.7 165.3-34 109.5-23 154.8-14.6 155.8 18 2.2 70.1-82.4 70.1-82.4 0 49 25.2 112.9 79.8 159-26.4 8.1-85.7 29.9-71.6 53.8 11.4 19.3 196.2 12.3 249.5 6.3 53.3 6 238.1 13 249.5-6.3 14.1-23.8-45.3-45.7-71.6-53.8 54.6-46.2 79.8-110.1 79.8-159 0 0 52.1 84.6 70.1 82.4 8.5-1.1 19.5-46.4-14.5-155.8z" 
                                              Foreground="#FF6699" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Group: 331568783" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMainBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- Disclaimer Card -->
                <Border CornerRadius="16" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource SoftSuccessBrush}" BorderThickness="4,0,0,0" Padding="24">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding [Str_OpenSourceDisclaimer], Source={x:Static i18n:I18nService.Instance}}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SoftSuccessBrush}"/>
                        
                        <TextBlock Text="{Binding [Str_DisclaimerDesc], Source={x:Static i18n:I18nService.Instance}}" FontSize="13" Foreground="{DynamicResource ThemeTextSubBrush}" TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
