<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MdModManager.ViewModels"
             xmlns:models="using:MdModManager.Models"
             xmlns:i18n="using:MdModManager.Services"
             x:Class="MdModManager.Views.ReplayManagerView"
             x:DataType="vm:ReplayManagerViewModel"
             DragDrop.AllowDrop="True">
    <!-- Extend the incumbent tool UI: compact metadata cards, bounded pages, import/delete only. -->
    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Foreground" Value="{DynamicResource CardTextMainBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        </Style>
        <Style Selector="Button.ToolbarActionBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="RenderTransform" Value="scale(1.0)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ToolbarActionBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ToolbarActionBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1AF25D9C"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.ToolbarActionBtn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.08)"/>
        </Style>
        <Style Selector="Button.ToolbarActionBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#30F25D9C"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.ToolbarActionBtn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.92)"/>
        </Style>
        <Style Selector="Button.ToolbarActionBtn PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource CardTextMainBrush}"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ToolbarActionBtn:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
        <TextBlock Text="{Binding [Replay_Title], Source={x:Static i18n:I18nService.Instance}}"
                   FontSize="28" FontWeight="Bold" HorizontalAlignment="Left" Foreground="{DynamicResource PageTitleGradientBrush}"/>
        <TextBlock Grid.Row="1" Text="{Binding [Replay_Help], Source={x:Static i18n:I18nService.Instance}}"
                   FontSize="13" Foreground="{DynamicResource ThemeTextSubBrush}" TextWrapping="Wrap"/>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
            <TextBox Text="{Binding SearchText, Mode=TwoWay}" Watermark="{Binding [Replay_Search], Source={x:Static i18n:I18nService.Instance}}"
                     Foreground="{DynamicResource CardTextMainBrush}" Background="{DynamicResource ControlBgBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"/>
            <Button Grid.Column="1" Click="OnImportClick" IsEnabled="{Binding CanEdit}"
                    Content="{Binding [Replay_Import], Source={x:Static i18n:I18nService.Instance}}"/>
            <Button Grid.Column="2" Classes="ToolbarActionBtn" Command="{Binding OpenFolderCommand}" IsEnabled="{Binding CanEdit}"
                    ToolTip.Tip="{Binding [Replay_OpenFolder], Source={x:Static i18n:I18nService.Instance}}">
                <PathIcon Data="M928 352v-48c0-35.3-28.7-64-64-64H485.2c-21 0-40.7-10.3-52.6-27.6l-61.5-88.9c-12-17.3-31.6-27.6-52.6-27.6H64c-35.3 0-64 28.7-64 64v656c0 70.7 57.3 128 128 128h638c57.8 0 108.5-38.8 123.6-94.6L928 707.2l74.2-274.5c11-40.7-19.6-80.7-61.8-80.7H928zM80 160h230.1c5.3 0 10.2 2.6 13.2 6.9l50.6 73.1H80c-8.8 0-16-7.2-16-16v-48c0-8.8 7.2-16 16-16z m0 144h768c8.8 0 16 7.2 16 16v32H209c-28.9 0-54.2 19.4-61.8 47.3L79.7 649c-2.4 9-15.7 7.3-15.7-2.1V320c0-8.8 7.2-16 16-16z m784 394.7l-36.2 134c-7.5 27.9-32.9 47.3-61.8 47.3H125.4c-21.1 0-36.4-20-30.9-40.3l111.3-411.8c1.9-7 8.2-11.8 15.4-11.8h698.3c10.5 0 18.2 10 15.4 20.2l-7 25.7L864 698.7z"/>
            </Button>
            <Button Grid.Column="3" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanEdit}"
                    Content="{Binding [OnlineLobby_Refresh], Source={x:Static i18n:I18nService.Instance}}"/>
        </Grid>
        <Grid Grid.Row="3">
            <ScrollViewer Name="ReplayScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Replays}" Margin="0,0,8,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ReplayInfo">
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource FloatingPanelBorder}"
                                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="7" ColumnSpacing="20">
                                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource CardTextMainBrush}" ToolTip.Tip="{Binding Title}"/>
                                    <Button Grid.Column="1" Grid.RowSpan="2" Tag="{Binding}" Click="OnDeleteClick"
                                            Content="{Binding [Replay_Delete], Source={x:Static i18n:I18nService.Instance}}"
                                            VerticalAlignment="Top" ToolTip.Tip="{Binding FilePath}"/>
                                    <TextBlock Grid.Row="1" Text="{Binding ChartDetails}" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource CardTextSubBrush}" FontSize="12"/>
                                    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Player}" Foreground="{DynamicResource CardTextMainBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Character}" FontSize="12" Foreground="{DynamicResource CardTextSubBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" IsVisible="{Binding IsValid}">
                                            <TextBlock Text="{Binding Score}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource CardTextMainBrush}" VerticalAlignment="Top"/>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Accuracy}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccentBrush}"/>
                                                <Border Background="{DynamicResource ControlBgBrush}" CornerRadius="4" Padding="7,3"
                                                        HorizontalAlignment="Right" IsVisible="{Binding HasResultBadge}">
                                                    <TextBlock Text="{Binding ResultBadge}" FontSize="12" Foreground="{DynamicResource CardTextMainBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding Judgements}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource CardTextSubBrush}" IsVisible="{Binding IsValid}"/>
                                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding Error}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource CardTextSubBrush}" IsVisible="{Binding !IsValid}"/>
                                    <Grid Grid.Row="4" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{Binding Recorded}" FontSize="12" Foreground="{DynamicResource CardTextSubBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="12" Foreground="{DynamicResource CardTextSubBrush}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="{Binding [Replay_Empty], Source={x:Static i18n:I18nService.Instance}}" IsVisible="{Binding IsEmpty}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSubBrush}"/>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" VerticalAlignment="Top"
                         Foreground="{DynamicResource ThemeAccentBrush}"/>
        </Grid>
        <Grid Name="ReplayFooter" Grid.Row="4" ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource ThemeTextSubBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <StackPanel Name="ReplayPagination" Grid.Column="1" Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Command="{Binding FirstCommand}" IsEnabled="{Binding CanPrevious}" Theme="{StaticResource PagingIconBtn}" Focusable="True" IsTabStop="True"
                        ToolTip.Tip="{Binding [Str_022], Source={x:Static i18n:I18nService.Instance}}">
                    <PathIcon Data="M321.53 929m-41.47 0l0 0q-41.47 0-41.47-41.47l0-747.06q0-41.47 41.47-41.47l0 0q41.47 0 41.47 41.47l0 747.06q0 41.47-41.47 41.47Z M787.26 170L411.44 514.25l375.82 344.21a39.32 39.32 0 0 1 13.11 29c0 36.51-48.2 54.79-76.38 29L348.17 572.2c-34.95-32-34.95-83.9 0-115.9L724 112.08c28.18-25.81 76.38-7.53 76.38 29A39.33 39.33 0 0 1 787.26 170z" Foreground="{DynamicResource SvgIconBrush}" Width="16" Height="16"/>
                </Button>
                <Button Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}" Theme="{StaticResource PagingIconBtn}" Focusable="True" IsTabStop="True"
                        ToolTip.Tip="{Binding [Replay_Previous], Source={x:Static i18n:I18nService.Instance}}">
                    <PathIcon Data="M704 944c-10.88 0-22.4-3.84-31.36-11.52l-448-384c-10.88-8.96-16.64-22.4-16.64-36.48s6.4-27.52 16.64-36.48l448-384c19.84-17.28 50.56-14.72 67.84 5.12s14.72 50.56-5.12 67.84L329.6 512l405.76 347.52c19.84 17.28 22.4 47.36 5.12 67.84-9.6 10.88-23.04 16.64-36.48 16.64z" Foreground="{DynamicResource SvgIconBrush}" Width="18" Height="18"/>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [Str_024], Source={x:Static i18n:I18nService.Instance}}" Foreground="{DynamicResource ThemeTextSubBrush}" VerticalAlignment="Center" FontSize="13"/>
                    <TextBlock Text="{Binding CurrentPage}" Foreground="{DynamicResource SvgIconBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="/" Foreground="{DynamicResource ThemeTextSubBrush}" VerticalAlignment="Center" FontSize="13"/>
                    <TextBlock Text="{Binding TotalPages}" Foreground="{DynamicResource ThemeTextSubBrush}" VerticalAlignment="Center" FontSize="13"/>
                    <TextBlock Text="{Binding [Str_025], Source={x:Static i18n:I18nService.Instance}}" Foreground="{DynamicResource ThemeTextSubBrush}" VerticalAlignment="Center" FontSize="13"/>
                </StackPanel>
                <Button Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}" Theme="{StaticResource PagingIconBtn}" Focusable="True" IsTabStop="True"
                        ToolTip.Tip="{Binding [Replay_Next], Source={x:Static i18n:I18nService.Instance}}">
                    <PathIcon Data="M288 944c10.88 0 22.4-3.84 31.36-11.52l448-384c10.88-8.96 16.64-22.4 16.64-36.48s-6.4-27.52-16.64-36.48l-448-384c-19.84-17.28-50.56-14.72-67.84 5.12s-14.72 50.56 5.12 67.84L662.4 512l-405.76 347.52c-19.84 17.28-22.4 47.36-5.12 67.84 9.6 10.88-23.04 16.64-36.48 16.64z" Foreground="{DynamicResource SvgIconBrush}" Width="18" Height="18"/>
                </Button>
                <Button Command="{Binding LastCommand}" IsEnabled="{Binding CanNext}" Theme="{StaticResource PagingIconBtn}" Focusable="True" IsTabStop="True"
                        ToolTip.Tip="{Binding [Str_027], Source={x:Static i18n:I18nService.Instance}}">
                    <PathIcon Data="M706.19 106m41.47 0l0 0q41.47 0 41.47 41.47l0 747.06q0 41.47-41.47 41.47l0 0q-41.47 0-41.47-41.47l0-747.06q0-41.47 41.47-41.47Z M240.46 865l375.81-344.25-375.81-344.21a39.32 39.32 0 0 1-13.11-29c0-36.51 48.2-54.79 76.38-29L679.55 462.8c35 32 35 83.9 0 115.9L303.73 922.92c-28.18 25.81-76.38 7.53-76.38-29A39.33 39.33 0 0 1 240.46 865z" Foreground="{DynamicResource SvgIconBrush}" Width="16" Height="16"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
