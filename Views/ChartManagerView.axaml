                                                              Width="13" Height="13"
                                                              Foreground="{DynamicResource ThemeTextSubBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,16,0,0">
                        <Button Content="{Binding SelectedCategoriesForDeletionCount, StringFormat='确认删除选中的 \{0\} 个分类'}"
                                Command="{Binding DeleteSelectedCategoriesCommand}"
                                IsVisible="{Binding IsCategoryDeleteMode}"
                                IsEnabled="{Binding HasSelectedCategoriesForDeletion}"
                                Padding="20,10"
                                CornerRadius="10"
                                FontSize="13"
                                Background="#D9383A"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="RenderTransform" Value="scale(1.0)"/>
                                    <Setter Property="Transitions">
                                        <Transitions>
                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                                            <BrushTransition Property="Background" Duration="0:0:0.2"/>
                                        </Transitions>
                                    </Setter>
                                </Style>
                                <Style Selector="Button:disabled">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Style>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="#FF4D4F"/>
                                    <Setter Property="RenderTransform" Value="scale(1.04)"/>
                                </Style>
                                <Style Selector="Button:pressed">
                                    <Setter Property="RenderTransform" Value="scale(0.96)"/>
                                    <Setter Property="Background" Value="#B82E30"/>
                                </Style>
                            </Button.Styles>
                        </Button>
                        
                        <Button Content="{Binding [Str_093], Source={x:Static i18n:I18nService.Instance}}"
                                Command="{Binding CloseCategoryManagerPanelCommand}"
                                Padding="24,10"
                                CornerRadius="10"
                                FontSize="13"
                                Background="#12FFFFFF"
                                Foreground="{DynamicResource ThemeTextMainBrush}"
                                BorderBrush="#20FFFFFF"
                                BorderThickness="1"
                                Cursor="Hand">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="RenderTransform" Value="scale(1.0)"/>
                                    <Setter Property="Transitions">
                                        <Transitions>
                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                                            <BrushTransition Property="Background" Duration="0:0:0.2"/>
                                            <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                                            <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                                        </Transitions>
                                    </Setter>
                                </Style>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="#1AF25D9C"/>
                                    <Setter Property="BorderBrush" Value="#FF8EBE"/>
                                    <Setter Property="Foreground" Value="#FF8EBE"/>
                                    <Setter Property="RenderTransform" Value="scale(1.04)"/>
                                </Style>
                                <Style Selector="Button:pressed">
                                    <Setter Property="RenderTransform" Value="scale(0.96)"/>
                                    <Setter Property="Background" Value="#30F25D9C"/>
                                    <Setter Property="BorderBrush" Value="#FF8EBE"/>
                                    <Setter Property="Foreground" Value="#FF7DB2"/>
                                </Style>
                            </Button.Styles>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    <!-- 加载中动画 -->
    <StackPanel IsVisible="{Binding IsLoading}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
        <ProgressBar IsIndeterminate="True"
                     Width="200"
                     Height="4"
                     Foreground="{DynamicResource ThemeAccentBrush}"
                     Background="#251F2E"
                     CornerRadius="2"/>
        <TextBlock Text="{Binding [Str_094], Source={x:Static i18n:I18nService.Instance}}"
                   FontSize="13"
                   Foreground="#8A8594"
                   HorizontalAlignment="Center"/>
    </StackPanel>
</Panel>
</UserControl>
