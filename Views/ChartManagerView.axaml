                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Str_024], Source={x:Static i18n:I18nService.Instance}}" Foreground="{DynamicResource ThemeTextSubBrush}" VerticalAlignment="Center" FontSize="11"/>
                        <Panel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentPage}" Foreground="{DynamicResource SvgIconBrush}" FontWeight="ExtraBold" FontSize="12" Cursor="Hand" PointerPressed="OnPageNumberClick" IsVisible="{Binding !IsEditingPageNumber}"/>
                            <TextBox Name="PageJumpTextBox_Top" Text="{Binding JumpPageText}" Foreground="{DynamicResource SvgIconBrush}" FontWeight="Bold" FontSize="12" Width="42" Height="22" Padding="2,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderThickness="1" CornerRadius="4" LostFocus="OnPageJumpLostFocus" IsVisible="{Binding IsEditingPageNumber}" Background="{DynamicResource ControlBgBrush}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Command="{Binding JumpPageCommand}" Gesture="Enter"/>
                                    <KeyBinding Command="{Binding CancelEditPageCommand}" Gesture="Escape"/>
                                </TextBox.KeyBindings>
                            </TextBox>
                        </Panel>
                        <TextBlock Text="/" Foreground="{DynamicResource ThemeTextSubBrush}" VerticalAlignment="Center" FontSize="11"/>
                        <TextBlock Text="{Binding TotalPages}" Foreground="{DynamicResource ThemeTextSubBrush}" VerticalAlignment="Center" FontSize="11"/>
                        <TextBlock Text="{Binding [Str_025], Source={x:Static i18n:I18nService.Instance}}" Foreground="{DynamicResource ThemeTextSubBrush}" VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                    <Button Command="{Binding LoadNextPageCommand}" IsEnabled="{Binding CanLoadNext}" Theme="{StaticResource PagingIconBtn}" ToolTip.Tip="{Binding [Str_026], Source={x:Static i18n:I18nService.Instance}}">
                        <PathIcon Data="M288 944c10.88 0 22.4-3.84 31.36-11.52l448-384c-10.88-8.96-16.64-22.4-16.64-36.48s6.4-27.52-16.64-36.48l-448-384c-19.84-17.28-50.56-14.72-67.84 5.12s-14.72 50.56 5.12 67.84L662.4 512l-405.76 347.52c-19.84 17.28-22.4 47.36-5.12 67.84 9.6 10.88 23.04 16.64 36.48 16.64z" Foreground="{DynamicResource SvgIconBrush}" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding LoadLastPageCommand}" IsEnabled="{Binding CanLoadNext}" Theme="{StaticResource PagingIconBtn}" ToolTip.Tip="{Binding [Str_027], Source={x:Static i18n:I18nService.Instance}}">
                        <PathIcon Data="M706.19 106m41.47 0l0 0q41.47 0 41.47 41.47l0 747.06q0 41.47-41.47 41.47l0 0q-41.47 0-41.47-41.47l0-747.06q0-41.47 41.47-41.47Z M240.46 865l375.81-344.25-375.81-344.21a39.32 39.32 0 0 1-13.11-29c0-36.51 48.2-54.79 76.38-29L679.55 462.8c35 32 35 83.9 0 115.9L303.73 922.92c-28.18 25.81-76.38 7.53-76.38-29A39.33 39.33 0 0 1 240.46 865z" Foreground="{DynamicResource SvgIconBrush}" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 右侧：清理坏谱面与排序 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- 清理坏谱面按钮 -->
                <Button Classes="CategoryControlBtn"
                        Command="{Binding CleanUpBrokenChartsCommand}"
                        Width="38"
                        Padding="8"
                        ToolTip.Tip="{Binding [Str_407], Source={x:Static i18n:I18nService.Instance}}">
                    <PathIcon Data="M453.312 448H248a29.312 29.312 0 0 0-29.312 29.312v58.688c0 16.192 13.12 29.312 29.312 29.312h528a29.312 29.312 0 0 0 29.312-29.312v-58.688A29.312 29.312 0 0 0 776 448H570.688V184a29.312 29.312 0 0 0-29.376-29.312h-58.624a29.312 29.312 0 0 0-29.376 29.312V448z m-58.624-58.688V154.688c0-32.448 26.24-58.688 58.624-58.688h117.376c32.384 0 58.624 26.24 58.624 58.688v234.624h176c32.448 0 58.688 26.24 58.688 58.688v117.312c0 32.448-26.24 58.688-58.688 58.688v234.688c0 32.384-26.24 58.624-58.624 58.624H277.312a58.688 58.688 0 0 1-58.624-58.624V624a58.688 58.688 0 0 1-58.688-58.688V448c0-32.384 26.24-58.688 58.688-58.688h176z m352 234.688H277.312v205.312c0 16.192 13.184 29.376 29.376 29.376h410.624a29.312 29.312 0 0 0 29.376-29.376V624z m-88 58.688c16.192 0 29.312 13.12 29.312 29.312v146.688h-58.688v-146.688c0-16.192 13.184-29.312 29.376-29.312z m-117.376 58.624c16.192 0 29.376 13.184 29.376 29.376v88H512v-88c0-16.192 13.12-29.376 29.312-29.376z m-117.312 58.688c16.192 0 29.312 13.12 29.312 29.312v29.376h-58.624v-29.376c0-16.192 13.12-29.312 29.312-29.312z"
                              Width="14" Height="14"/>
                </Button>

                <ComboBox ItemsSource="{Binding SortOptions}"
                          SelectedIndex="{Binding SelectedSortIndex}"
                          Width="130"
                          CornerRadius="8"
                          BorderThickness="0"
                          FontSize="12"
                          VerticalAlignment="Center">
                    <ComboBox.Resources>
                        <SolidColorBrush x:Key="ComboBoxBorderBrush">Transparent</SolidColorBrush>
                        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver">Transparent</SolidColorBrush>
                        <SolidColorBrush x:Key="ComboBoxBorderBrushFocused">Transparent</SolidColorBrush>
                        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed">Transparent</SolidColorBrush>
                    </ComboBox.Resources>
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- 主体区域 -->
        <Grid Grid.Row="2">

            <!-- 主体内容 -->
            <Panel IsVisible="{Binding !IsLoading}">
                <!-- 缺少 Custom_Albums 文件夹提示 -->
                <StackPanel IsVisible="{Binding IsCustomAlbumsMissing}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15">
                <TextBlock Text="{Binding [Str_078], Source={x:Static i18n:I18nService.Instance}}" FontSize="18" Foreground="{DynamicResource ThemeTextMainBrush}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- 文件夹存在但没有谱面时的正常空状态提示 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15">
                <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsEmpty"/>
                        <Binding Path="!IsCustomAlbumsMissing"/>
                    </MultiBinding>
                </StackPanel.IsVisible>
                <TextBlock Text="🎵" FontSize="60" HorizontalAlignment="Center" Foreground="Gray"/>
                <TextBlock Text="{Binding [Str_079], Source={x:Static i18n:I18nService.Instance}}" FontSize="18" Foreground="Gray" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding [Str_080], Source={x:Static i18n:I18nService.Instance}}" FontSize="13" Foreground="#555555" HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel IsVisible="{Binding HasNoSearchResults}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="15">
                <TextBlock Text="{Binding [Str_060], Source={x:Static i18n:I18nService.Instance}}" FontSize="18" Foreground="Gray" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding [Str_081], Source={x:Static i18n:I18nService.Instance}}" FontSize="13" Foreground="#666666" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- 谱面卡片网格 -->
            <ScrollViewer x:Name="ChartScrollViewer"
                          IsVisible="{Binding HasVisibleCharts}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid RowDefinitions="*,Auto">
                    <ItemsControl ItemsSource="{Binding Charts}" Grid.Row="0" Margin="0,16,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ChartGridColumns}" HorizontalAlignment="Stretch"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ChartInfo">
                                <Border Classes="ChartCard"
                                        Classes.ChartCardSelected="{Binding IsSelected}"
                                        CornerRadius="10"
                                        Margin="8,4,8,12"
                                        VerticalAlignment="Top"
                                        ClipToBounds="True"
                                        PointerPressed="OnChartCardPointerPressed"
                                        Tag="{Binding}">
                                    <Grid RowDefinitions="Auto,*">

                                        <!-- 封面图 -->
                                        <Border Grid.Row="0" Height="170" ClipToBounds="True" CornerRadius="10,10,0,0">
                                            <Panel>
                                                <!-- 有封面时显示 -->
                                                <Image IsVisible="{Binding HasAnimatedCoverSource}"
                                                       Stretch="UniformToFill"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       animated:ImageBehavior.AnimatedSource="{Binding AnimatedCoverSource}"/>
                                                <Image Source="{Binding CoverImage}"
                                                       IsVisible="{Binding HasCoverBitmap}"
                                                       Stretch="UniformToFill"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                                <!-- 无封面占位 -->
                                                <Border IsVisible="{Binding !HasAnyCover}"
                                                        Background="#333333"
                                                        CornerRadius="10,10,0,0">
                                                    <TextBlock Text="🎵" FontSize="56"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="#555555"/>
                                                </Border>

                                                <!-- 正在播放叠加 -->
                                                <Border IsVisible="{Binding IsPlaying}"
                                                        Background="#80000000"
                                                        CornerRadius="10,10,0,0">
                                                    <TextBlock Text="{Binding [Str_030], Source={x:Static i18n:I18nService.Instance}}" FontSize="14" FontWeight="Bold"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <!-- 选中半透明叠加层 -->
                                                <Border IsVisible="{Binding IsSelected}"
                                                        Background="#40FF4444"
                                                        CornerRadius="10,10,0,0"/>
                                                <!-- New 标签叠加 -->
                                                <Border IsVisible="{Binding IsNewDownload}" 
                                                        Background="#E81123" CornerRadius="4" Padding="6,2" Margin="6,0,0,6" 
                                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Height="20">
                                                    <TextBlock Text="New" FontSize="10" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                </Border>
                                                <!-- 分类标签叠加 (长度自适应，超过4个字自动滚动) -->
                                                <Border IsVisible="{Binding CategoryName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" 
                                                        Background="#281423" BorderBrush="#FF8EBE" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,6,6" 
                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="20">
                                                    <controls:MarqueeText Text="{Binding CategoryName}"
                                                                          FontSize="10" FontWeight="Bold"
                                                                          Foreground="#FFE0EF"
                                                                          MaxWidth="52"
                                                                          IsScrollingEnabled="True"
                                                                          Height="16"/>
                                                </Border>
                                            </Panel>
                                        </Border>

                                        <!-- 下方信息区 -->
                                        <StackPanel Grid.Row="1" Margin="12,10,12,10" Spacing="4">

                                            <!-- 歌曲名称 (带滚动动画) -->
                                            <controls:MarqueeText Text="{Binding Name}"
                                                                  HighlightText="{Binding Name}"
                                                                  SearchText="{Binding $parent[UserControl].((vm:ChartManagerViewModel)DataContext).SearchText}"
                                                                  FontSize="14" FontWeight="Bold"
                                                                  Foreground="{DynamicResource ThemeTextMainBrush}"
                                                                  Height="20"
                                                                  IsScrollingEnabled="{Binding $parent[UserControl].((vm:ChartManagerViewModel)DataContext).EnableMarquee}"
                                                                  ToolTip.Tip="{Binding Name}"/>

                                            <!-- 曲师 -->
                                            <TextBlock Text="{Binding DisplayArtist}"
                                                       helpers:TextBlockHelper.HighlightText="{Binding DisplayArtist}"
                                                       helpers:TextBlockHelper.SearchText="{Binding $parent[UserControl].((vm:ChartManagerViewModel)DataContext).SearchText}"
                                                       IsVisible="{Binding DisplayArtist, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                       FontSize="11" Foreground="{DynamicResource ThemeTextSubBrush}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding DisplayArtist}"/>

                                            <!-- 谱师 -->
                                            <TextBlock Text="{Binding DisplayCharter}"
                                                       helpers:TextBlockHelper.HighlightText="{Binding DisplayCharter}"
                                                       helpers:TextBlockHelper.SearchText="{Binding $parent[UserControl].((vm:ChartManagerViewModel)DataContext).SearchText}"
                                                       IsVisible="{Binding DisplayCharter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                       FontSize="11" Foreground="{DynamicResource ThemeTextSubBrush}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding DisplayCharter}"/>

                                            <!-- BPM和难度同行显示 -->
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Spacing="8" MinHeight="16">
                                                <TextBlock
                                                    IsVisible="{Binding Bpm, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                    Text="{Binding Bpm, StringFormat='BPM: \{0\}'}"
                                                    FontSize="11" Foreground="{DynamicResource ThemeTextTertiaryBrush}"
                                                    VerticalAlignment="Center"/>
                                                <ItemsControl ItemsSource="{Binding Difficulties}" VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="3"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#26F25D9C" BorderBrush="#80F25D9C" BorderThickness="1" CornerRadius="4" Padding="5,1">
                                                                <TextBlock Text="{Binding}" FontSize="10" Foreground="#FF8EBE" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- 操作按钮行 -->
                                             <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0"
                                                   IsVisible="{Binding $parent[UserControl].((vm:ChartManagerViewModel)DataContext).NotIsBatchMode}">
                                                 <!-- 试听按钮 -->
                                                 <Button Grid.Column="0"
                                                         Classes="IconBtn"
                                                         HorizontalAlignment="Center"
                                                         Command="{Binding $parent[UserControl].((vm:ChartManagerViewModel)DataContext).TogglePreviewCommand}"
                                                         CommandParameter="{Binding}"
                                                         ToolTip.Tip="{Binding [Str_082], Source={x:Static i18n:I18nService.Instance}}">
                                                     <Panel>
                                                         <PathIcon Data="M896 512L128 1024V0z"
                                                                   Foreground="{DynamicResource SvgIconBrush}" Width="20" Height="20"
                                                                   IsVisible="{Binding !IsPlaying}"/>
                                                         <PathIcon Data="M722.9375 933.875H301.0625a210.9375 210.9375 0 0 1-210.9375-210.9375V301.0625a210.9375 210.9375 0 0 1 210.9375-210.9375h421.875a210.9375 210.9375 0 0 1 210.9375 210.9375v421.875a210.9375 210.9375 0 0 1-210.9375 210.9375z"
                                                                   Foreground="{DynamicResource SvgIconBrush}" Width="20" Height="20"
                                                                   IsVisible="{Binding IsPlaying}"/>
                                                     </Panel>
                                                 </Button>

                                                 <!-- 移动分类按钮 -->
                                                 <Button Grid.Column="1"
                                                         Classes="IconBtn"
                                                         HorizontalAlignment="Center"
                                                         Command="{Binding $parent[UserControl].((vm:ChartManagerViewModel)DataContext).OpenSingleMovePanelCommand}"
                                                         CommandParameter="{Binding}"
                                                         ToolTip.Tip="{Binding [Str_083], Source={x:Static i18n:I18nService.Instance}}">
                                                     <PathIcon Data="M864 288H480l-64-64H160c-35.3 0-64 28.7-64 64v512c0 35.3 28.7 64 64 64h704c35.3 0 64-28.7 64-64V352c0-35.3-28.7-64-64-64z M576 448l128 128-128 128v-96H384v-64h192v-96z"
                                                               Foreground="{DynamicResource SvgIconBrush}" Width="20" Height="20"/>
                                                 </Button>

                                                 <!-- 卸载按钮 -->
                                                 <Button Grid.Column="2"
                                                         Classes="IconBtn"
                                                         HorizontalAlignment="Center"
                                                         Click="OnDeleteChartClick"
                                                         Tag="{Binding}"
                                                         ToolTip.Tip="{Binding [Str_084], Source={x:Static i18n:I18nService.Instance}}">
                                                     <PathIcon Data="M981.465503 192.054069v42.678682a20.185863 20.185863 0 0 1-6.055759 15.283582 20.474233 20.474233 0 0 1-15.283582 6.055759H896.108139v630.952408a152.259082 152.259082 0 0 1-31.143904 95.738665 92.85497 92.85497 0 0 1-75.264432 40.371727H234.300197a93.720079 93.720079 0 0 1-75.264432-38.929879 145.914954 145.914954 0 0 1-31.143904-94.296818v-634.412842H63.873838a19.897494 19.897494 0 0 1-15.283582-6.055759 20.474233 20.474233 0 0 1-6.055759-15.283582V192.342439a20.185863 20.185863 0 0 1 6.055759-15.283582 20.474233 20.474233 0 0 1 15.283582-6.055759h206.184174l46.715855-111.310617A94.008448 94.008448 0 0 1 352.820051 17.590538a94.873557 94.873557 0 0 1 52.771613-17.302169h213.393411a94.008448 94.008448 0 0 1 52.771613 17.302169 91.989862 91.989862 0 0 1 36.046184 42.101943l46.715855 111.310617h205.895804a20.185863 20.185863 0 0 1 15.283582 6.055759 20.762602 20.762602 0 0 1 5.47902 14.995212z m-597.501549 640.180231V362.768798a20.185863 20.185863 0 0 0-6.055759-15.283583 20.474233 20.474233 0 0 0-15.283582-6.055759H319.945931a20.185863 20.185863 0 0 0-15.283582 6.055759 20.474233 20.474233 0 0 0-6.055759 15.283583v469.465502a20.185863 20.185863 0 0 0 6.055759 15.283582 20.474233 20.474233 0 0 0 15.283582 6.055759h42.678682a20.474233 20.474233 0 0 0 21.339341-21.339341zM362.624613 170.714728h298.750774l-32.009011-77.859758a18.167277 18.167277 0 0 0-11.534779-7.209236h-211.086455a18.744016 18.744016 0 0 0-11.534779 7.209236z m192.054069 661.519572V362.768798a20.185863 20.185863 0 0 0-6.055759-15.283583 20.474233 20.474233 0 0 0-15.283582-6.055759h-42.678682a20.185863 20.185863 0 0 0-15.283582 6.055759 20.474233 20.474233 0 0 0-6.055759 15.283583v469.465502a20.185863 20.185863 0 0 0 6.055759 15.283582 20.474233 20.474233 0 0 0 15.283582 6.055759h42.678682a20.185863 20.185863 0 0 0 15.283582-6.055759 20.762602 20.762602 0 0 0 6.055759-15.283582z m170.714728 0V362.768798a20.185863 20.185863 0 0 0-6.055759-15.283583 20.474233 20.474233 0 0 0-15.283582-6.055759h-42.678682a20.185863 20.185863 0 0 0-15.283582 6.055759 20.474233 20.474233 0 0 0-6.055759 15.283583v469.465502a20.185863 20.185863 0 0 0 6.055759 15.283582 20.474233 20.474233 0 0 0 15.283582 6.055759h42.678682a20.474233 20.474233 0 0 0 21.339341-21.339341z m0 0"
                                                                 Foreground="{DynamicResource SvgIconBrush}" Width="20" Height="20"/>
                                                 </Button>
                                             </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Grid.Row="1" Background="Transparent" Margin="10,20,10,30" Padding="15,8" CornerRadius="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
                            <Button Command="{Binding LoadFirstPageCommand}" IsEnabled="{Binding CanLoadPrev}" Theme="{StaticResource PagingIconBtn}" ToolTip.Tip="{Binding [Str_022], Source={x:Static i18n:I18nService.Instance}}">
                                <PathIcon Data="M321.53 929m-41.47 0l0 0q-41.47 0-41.47-41.47l0-747.06q0-41.47 41.47-41.47l0 0q41.47 0 41.47 41.47l0 747.06q0 41.47-41.47 41.47Z M787.26 170L411.44 514.25l375.82 344.21a39.32 39.32 0 0 1 13.11 29c0 36.51-48.2 54.79-76.38 29L348.17 572.2c-34.95-32-34.95-83.9 0-115.9L724 112.08c28.18-25.81 76.38-7.53 76.38 29A39.33 39.33 0 0 1 787.26 170z" Foreground="{DynamicResource SvgIconBrush}" Width="16" Height="16"/>
                            </Button>
                            <Button Command="{Binding LoadPrevPageCommand}" IsEnabled="{Binding CanLoadPrev}" Theme="{StaticResource PagingIconBtn}" ToolTip.Tip="{Binding [Str_023], Source={x:Static i18n:I18nService.Instance}}">
                                <PathIcon Data="M704 944c-10.88 0-22.4-3.84-31.36-11.52l-448-384c-10.88-8.96-16.64-22.4-16.64-36.48s6.4-27.52 16.64-36.48l448-384c19.84-17.28 50.56-14.72 67.84 5.12s14.72 50.56-5.12 67.84L329.6 512l405.76 347.52c19.84 17.28 22.4 47.36 5.12 67.84-9.6 10.88-23.04 16.64-36.48 16.64z" Foreground="{DynamicResource SvgIconBrush}" Width="18" Height="18"/>
                            </Button>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Str_024], Source={x:Static i18n:I18nService.Instance}}" Foreground="{DynamicResource ThemeTextSubBrush}" VerticalAlignment="Center" FontSize="13"/>
                                <Panel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentPage}" Foreground="{DynamicResource SvgIconBrush}" FontWeight="Bold" FontSize="14" Cursor="Hand" PointerPressed="OnPageNumberClick" IsVisible="{Binding !IsEditingPageNumber}"/>
                                    <TextBox Name="PageJumpTextBox_Bottom" Text="{Binding JumpPageText}" Foreground="{DynamicResource SvgIconBrush}" FontWeight="Bold" FontSize="14" Width="50" Height="28" Padding="4,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderThickness="1" CornerRadius="4" LostFocus="OnPageJumpLostFocus" IsVisible="{Binding IsEditingPageNumber}" Background="{DynamicResource ControlBgBrush}">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Command="{Binding JumpPageCommand}" Gesture="Enter"/>
                                            <KeyBinding Command="{Binding CancelEditPageCommand}" Gesture="Escape"/>
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                </Panel>
                                <TextBlock Text="/" Foreground="{DynamicResource ThemeTextSubBrush}" VerticalAlignment="Center" FontSize="13"/>
                                <TextBlock Text="{Binding TotalPages}" Foreground="{DynamicResource ThemeTextSubBrush}" VerticalAlignment="Center" FontSize="13"/>
                                <TextBlock Text="{Binding [Str_025], Source={x:Static i18n:I18nService.Instance}}" Foreground="{DynamicResource ThemeTextSubBrush}" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                            <Button Command="{Binding LoadNextPageCommand}" IsEnabled="{Binding CanLoadNext}" Theme="{StaticResource PagingIconBtn}" ToolTip.Tip="{Binding [Str_026], Source={x:Static i18n:I18nService.Instance}}">
                                <PathIcon Data="M288 944c10.88 0 22.4-3.84 31.36-11.52l448-384c10.88-8.96 16.64-22.4 16.64-36.48s-6.4-27.52-16.64-36.48l-448-384c-19.84-17.28-50.56-14.72-67.84 5.12s-14.72 50.56 5.12 67.84L662.4 512l-405.76 347.52c-19.84 17.28-22.4 47.36-5.12 67.84 9.6 10.88-23.04 16.64-36.48 16.64z" Foreground="{DynamicResource SvgIconBrush}" Width="18" Height="18"/>
                            </Button>
                            <Button Command="{Binding LoadLastPageCommand}" IsEnabled="{Binding CanLoadNext}" Theme="{StaticResource PagingIconBtn}" ToolTip.Tip="{Binding [Str_027], Source={x:Static i18n:I18nService.Instance}}">
                                <PathIcon Data="M706.19 106m41.47 0l0 0q41.47 0 41.47 41.47l0 747.06q0 41.47-41.47 41.47l0 0q-41.47 0-41.47-41.47l0-747.06q0-41.47 41.47-41.47Z M240.46 865l375.81-344.25-375.81-344.21a39.32 39.32 0 0 1-13.11-29c0-36.51 48.2-54.79 76.38-29L679.55 462.8c35 32 35 83.9 0 115.9L303.73 922.92c-28.18 25.81-76.38 7.53-76.38-29A39.33 39.33 0 0 1 240.46 865z" Foreground="{DynamicResource SvgIconBrush}" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
            </Panel>
        </Grid>
    </Grid>

        <!-- 移动分类悬浮面板 -->
        <Grid IsVisible="{Binding IsMovePanelOpen}"
              Background="#E00B060D"
              PointerPressed="OnCloseMovePanelBackgroundPressed">
            <Border Width="380"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    BorderBrush="{DynamicResource ShellOutlineBrush}"
                    BorderThickness="1.5"
                    CornerRadius="20"
                    Padding="24"
                    BoxShadow="0 15 45 0 #2A000000, 0 0 30 0 #20FF8EBE">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#2D1A2C" Offset="0"/>
                        <GradientStop Color="#160F17" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0" Text="{Binding [Str_085], Source={x:Static i18n:I18nService.Instance}}" FontSize="18" FontWeight="Heavy" Margin="0,0,0,20" HorizontalAlignment="Center">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Color="#FFA7D1" Offset="0"/>
                                <GradientStop Color="#FF5C9D" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>

                    <ScrollViewer Grid.Row="1" MaxHeight="240" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MoveCategories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" ItemWidth="NaN"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                             <ItemsControl.ItemTemplate>
                                 <DataTemplate x:DataType="vm:MoveCategoryItem">
                                     <Button Command="{Binding $parent[UserControl].((vm:ChartManagerViewModel)DataContext).ConfirmMoveToCategoryCommand}"
                                             CommandParameter="{Binding}"
                                             Margin="6"
                                             Padding="14,8"
                                             CornerRadius="10"
                                             Background="#12FFFFFF"
                                             BorderThickness="1"
                                             BorderBrush="#15FFFFFF"
                                             Foreground="{DynamicResource ThemeTextMainBrush}"
                                             Cursor="Hand">
                                         <Button.Styles>
                                             <Style Selector="Button">
                                                 <Setter Property="RenderTransform" Value="scale(1.0)"/>
                                                 <Setter Property="Transitions">
                                                     <Transitions>
                                                         <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                                                         <BrushTransition Property="Background" Duration="0:0:0.2"/>
                                                         <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                                                     </Transitions>
                                                 </Setter>
                                             </Style>
                                             <Style Selector="Button:pointerover">
                                                 <Setter Property="Background" Value="#25FF8EBE"/>
                                                 <Setter Property="BorderBrush" Value="#80FF8EBE"/>
                                                 <Setter Property="RenderTransform" Value="scale(1.05)"/>
                                             </Style>
                                             <Style Selector="Button:pressed">
                                                 <Setter Property="RenderTransform" Value="scale(0.95)"/>
                                             </Style>
                                         </Button.Styles>
                                         <StackPanel Orientation="Horizontal" Spacing="6">
                                             <!-- 普通分类文件夹图标 -->
                                             <PathIcon Data="M896 256H512l-64-64H128c-35.3 0-64 28.7-64 64v512c0 35.3 28.7 64 64 64h768c35.3 0 64-28.7 64-64V320c0-35.3-28.7-64-64-64z"
                                                       Width="12" Height="12"
                                                       Foreground="{DynamicResource ThemeAccentBrush}"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding !IsCreateNew}"/>
                                             <!-- 新建分类加号图标 -->
                                             <PathIcon Data="M512 85.3a42.7 42.7 0 0 1 42.7 42.7v341.3h341.3a42.7 42.7 0 1 1 0 85.4H554.7v341.3a42.7 42.7 0 1 1-85.4 0V554.7H128a42.7 42.7 0 1 1 0-85.4h341.3V128a42.7 42.7 0 0 1 42.7-42.7z"
                                                       Width="12" Height="12"
                                                       Foreground="{DynamicResource ThemeAccentBrush}"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding IsCreateNew}"/>
                                             <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                         </StackPanel>
                                     </Button>
                                 </DataTemplate>
                             </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="{Binding [Str_086], Source={x:Static i18n:I18nService.Instance}}"
                            Command="{Binding CloseMovePanelCommand}"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0"
                            Padding="24,8"
                            CornerRadius="10"
                            Background="#12FFFFFF"
                            Foreground="{DynamicResource ThemeTextMainBrush}"
                            BorderThickness="1"
                            BorderBrush="#15FFFFFF"
                            Cursor="Hand">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="RenderTransform" Value="scale(1.0)"/>
                                <Setter Property="Transitions">
                                    <Transitions>
                                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                                        <BrushTransition Property="Background" Duration="0:0:0.2"/>
                                        <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                                    </Transitions>
                                </Setter>
                            </Style>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#25FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#60FF8EBE"/>
                                <Setter Property="RenderTransform" Value="scale(1.05)"/>
                            </Style>
                            <Style Selector="Button:pressed">
                                <Setter Property="RenderTransform" Value="scale(0.95)"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- 分类管理与选择悬浮面板 -->
        <Grid IsVisible="{Binding IsCategoryManagerPanelOpen}"
              Background="#E00B060D"
              PointerPressed="OnCloseCategoryManagerPanelBackgroundPressed">
            <Border Width="600"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    BorderBrush="{DynamicResource ShellOutlineBrush}"
                    BorderThickness="1.5"
                    CornerRadius="20"
                    Padding="28"
                    BoxShadow="0 15 45 0 #2A000000, 0 0 30 0 #20FF8EBE">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#2D1A2C" Offset="0"/>
                        <GradientStop Color="#160F17" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                        <TextBlock Grid.Column="0" Text="{Binding [Str_074], Source={x:Static i18n:I18nService.Instance}}" FontSize="20" FontWeight="Heavy" VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                    <GradientStop Color="#FFA7D1" Offset="0"/>
                                    <GradientStop Color="#FF5C9D" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                            <!-- 全选 -->
                            <Button Command="{Binding SelectAllCategoriesForDeletionCommand}"
                                    IsVisible="{Binding IsCategoryDeleteMode}"
                                    Content="{Binding [Str_087], Source={x:Static i18n:I18nService.Instance}}"
                                    Padding="14,8"
                                    CornerRadius="10"
                                    FontSize="12"
                                    Background="#10FFFFFF"
                                    BorderBrush="#20FFFFFF"
                                    BorderThickness="1"
                                    Foreground="{DynamicResource ThemeTextMainBrush}"
                                    Cursor="Hand">
                                <Button.Styles>
                                    <Style Selector="Button">
                                        <Setter Property="RenderTransform" Value="scale(1.0)"/>
                                        <Setter Property="Transitions">
                                            <Transitions>
                                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                                                <BrushTransition Property="Background" Duration="0:0:0.2"/>
                                                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                                                <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                                            </Transitions>
                                        </Setter>
                                    </Style>
                                    <Style Selector="Button:pointerover">
                                        <Setter Property="Background" Value="#1AF25D9C"/>
                                        <Setter Property="BorderBrush" Value="#80FF8EBE"/>
                                        <Setter Property="Foreground" Value="#FF8EBE"/>
                                        <Setter Property="RenderTransform" Value="scale(1.04)"/>
                                    </Style>
                                    <Style Selector="Button:pressed">
                                        <Setter Property="RenderTransform" Value="scale(0.96)"/>
                                        <Setter Property="Background" Value="#30F25D9C"/>
                                        <Setter Property="BorderBrush" Value="#FF8EBE"/>
                                        <Setter Property="Foreground" Value="#FF7DB2"/>
                                    </Style>
                                </Button.Styles>
                            </Button>

                            <!-- 反选 -->
                            <Button Command="{Binding InvertCategorySelectionForDeletionCommand}"
                                    IsVisible="{Binding IsCategoryDeleteMode}"
                                    Content="{Binding [Str_088], Source={x:Static i18n:I18nService.Instance}}"
                                    Padding="14,8"
                                    CornerRadius="10"
                                    FontSize="12"
                                    Background="#10FFFFFF"
                                    BorderBrush="#20FFFFFF"
                                    BorderThickness="1"
                                    Foreground="{DynamicResource ThemeTextMainBrush}"
                                    Cursor="Hand">
                                <Button.Styles>
                                    <Style Selector="Button">
                                        <Setter Property="RenderTransform" Value="scale(1.0)"/>
                                        <Setter Property="Transitions">
                                            <Transitions>
                                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                                                <BrushTransition Property="Background" Duration="0:0:0.2"/>
                                                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                                                <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                                            </Transitions>
                                        </Setter>
                                    </Style>
                                    <Style Selector="Button:pointerover">
                                        <Setter Property="Background" Value="#1AF25D9C"/>
                                        <Setter Property="BorderBrush" Value="#80FF8EBE"/>
                                        <Setter Property="Foreground" Value="#FF8EBE"/>
                                        <Setter Property="RenderTransform" Value="scale(1.04)"/>
                                    </Style>
                                    <Style Selector="Button:pressed">
                                        <Setter Property="RenderTransform" Value="scale(0.96)"/>
                                        <Setter Property="Background" Value="#30F25D9C"/>
                                        <Setter Property="BorderBrush" Value="#FF8EBE"/>
                                        <Setter Property="Foreground" Value="#FF7DB2"/>
                                    </Style>
                                </Button.Styles>
                            </Button>

                            <Button Command="{Binding ToggleCategoryDeleteModeCommand}"
                                    IsVisible="{Binding !IsCategoryDeleteMode}"
                                    Content="{Binding [Str_089], Source={x:Static i18n:I18nService.Instance}}"
                                    Padding="14,8"
                                    CornerRadius="10"
                                    FontSize="12"
                                    Background="#10FFFFFF"
                                    BorderBrush="#20FFFFFF"
                                    BorderThickness="1"
                                    Foreground="{DynamicResource ThemeTextMainBrush}"
                                    Cursor="Hand">
                                <Button.Styles>
                                    <Style Selector="Button">
                                        <Setter Property="RenderTransform" Value="scale(1.0)"/>
                                        <Setter Property="Transitions">
                                            <Transitions>
                                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                                                <BrushTransition Property="Background" Duration="0:0:0.2"/>
                                                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                                                <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                                            </Transitions>
                                        </Setter>
                                    </Style>
                                    <Style Selector="Button:pointerover">
                                        <Setter Property="Background" Value="#1AF25D9C"/>
                                        <Setter Property="BorderBrush" Value="#80FF8EBE"/>
                                        <Setter Property="Foreground" Value="#FF8EBE"/>
                                        <Setter Property="RenderTransform" Value="scale(1.04)"/>
                                    </Style>
                                    <Style Selector="Button:pressed">
                                        <Setter Property="RenderTransform" Value="scale(0.96)"/>
                                        <Setter Property="Background" Value="#30F25D9C"/>
                                        <Setter Property="BorderBrush" Value="#FF8EBE"/>
                                        <Setter Property="Foreground" Value="#FF7DB2"/>
                                    </Style>
                                </Button.Styles>
                            </Button>

                            <Button Command="{Binding ToggleCategoryDeleteModeCommand}"
                                    IsVisible="{Binding IsCategoryDeleteMode}"
                                    Content="{Binding [Str_090], Source={x:Static i18n:I18nService.Instance}}"
                                    Padding="14,8"
                                    CornerRadius="10"
                                    FontSize="12"
                                    Background="#10FFFFFF"
                                    BorderBrush="#80FF8EBE"
                                    BorderThickness="1"
                                    Foreground="{DynamicResource ThemeTextMainBrush}"
                                    Cursor="Hand">
                                <Button.Styles>
                                    <Style Selector="Button">
                                        <Setter Property="RenderTransform" Value="scale(1.0)"/>
                                        <Setter Property="Transitions">
                                            <Transitions>
                                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                                                <BrushTransition Property="Background" Duration="0:0:0.2"/>
                                                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                                            </Transitions>
                                        </Setter>
                                    </Style>
                                    <Style Selector="Button:pointerover">
                                        <Setter Property="Background" Value="#1AF25D9C"/>
                                        <Setter Property="BorderBrush" Value="#FF8EBE"/>
                                        <Setter Property="Foreground" Value="#FF8EBE"/>
                                        <Setter Property="RenderTransform" Value="scale(1.04)"/>
                                    </Style>
                                    <Style Selector="Button:pressed">
                                        <Setter Property="RenderTransform" Value="scale(0.96)"/>
                                        <Setter Property="Background" Value="#30F25D9C"/>
                                        <Setter Property="BorderBrush" Value="#FF8EBE"/>
                                        <Setter Property="Foreground" Value="#FF7DB2"/>
                                    </Style>
                                </Button.Styles>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" MaxHeight="350" VerticalScrollBarVisibility="Auto" Margin="0,10">
                        <ItemsControl ItemsSource="{Binding CategoryItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" HorizontalAlignment="Stretch"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategoryItem">
                                    <Border Classes="CategoryItemBorder" Classes.SelectedForDeletion="{Binding IsSelectedForDeletion}" Classes.ActiveCategory="{Binding IsActive}" Margin="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Button Grid.Column="0" Grid.ColumnSpan="2"
                                                    Theme="{StaticResource CategoryCardBtn}"
                                                    Command="{Binding $parent[UserControl].((vm:ChartManagerViewModel)DataContext).CategoryItemClickCommand}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    VerticalContentAlignment="Center"
                                                    Padding="12,6">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <CheckBox IsVisible="{Binding $parent[UserControl].((vm:ChartManagerViewModel)DataContext).IsCategoryDeleteMode}"
                                                              IsEnabled="{Binding IsCustom}"
                                                              IsChecked="{Binding IsSelectedForDeletion, Mode=OneWay}"
                                                              IsHitTestVisible="False"
                                                              Margin="0,0,4,0"
                                                              VerticalAlignment="Center"/>

                                                    <PathIcon Data="M928 352v-48c0-35.3-28.7-64-64-64H485.2c-21 0-40.7-10.3-52.6-27.6l-61.5-88.9c-12-17.3-31.6-27.6-52.6-27.6H64c-35.3 0-64 28.7-64 64v656c0 70.7 57.3 128 128 128h638c57.8 0 108.5-38.8 123.6-94.6L928 707.2l74.2-274.5c11-40.7-19.6-80.7-61.8-80.7H928zM80 160h230.1c5.3 0 10.2 2.6 13.2 6.9l50.6 73.1H80c-8.8 0-16-7.2-16-16v-48c0-8.8 7.2-16 16-16z m0 144h768c8.8 0 16 7.2 16 16v32H209c-28.9 0-54.2 19.4-61.8 47.3L79.7 649c-2.4 9-15.7 7.3-15.7-2.1V320c0-35.3-28.7-64-64-16z m784 394.7l-36.2 134c-7.5 27.9-32.9 47.3-61.8 47.3H125.4c-21.1 0-36.4-20-30.9-40.3l111.3-411.8c1.9-7 8.2-11.8 15.4-11.8h698.3c10.5 0 18.2 10 15.4 20.2l-7 25.7L864 698.7z"
                                                              Width="13" Height="13"
                                                              Foreground="{DynamicResource ThemeAccentBrush}"
                                                              VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DisplayName}" MaxWidth="135" FontSize="13" Foreground="{DynamicResource ThemeTextMainBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Button>

                                            <StackPanel Grid.Column="1" 
                                                        Orientation="Horizontal" 
                                                        Spacing="8" 
                                                        VerticalAlignment="Center" 
                                                        Margin="0,0,12,0">
                                                <StackPanel.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="!$parent[UserControl].DataContext.IsCategoryDeleteMode"/>
                                                        <Binding Path="IsCustom"/>
                                                    </MultiBinding>
                                                </StackPanel.IsVisible>
                                                
                                                <Button Command="{Binding $parent[UserControl].((vm:ChartManagerViewModel)DataContext).RenameSpecificCategoryCommand}"
                                                        CommandParameter="{Binding Name}"
                                                        Classes="CardActionBtn"
                                                        ToolTip.Tip="{Binding [Str_091], Source={x:Static i18n:I18nService.Instance}}">
                                                    <Button.Styles>
                                                        <Style Selector="Button:pointerover PathIcon">
                                                            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                                                        </Style>
                                                    </Button.Styles>
                                                    <PathIcon Data="M853.333333 170.666667c-25.6 0-51.2 8.533333-68.266666 25.6l-507.733334 507.733333-89.6 256 256-89.6L951.466667 362.666667c38.4-38.4 38.4-102.4 0-140.8l-34.133334-34.133334c-17.066667-17.066667-42.666667-17.066667-64-17.066666zM716.8 273.066667l102.4 102.4-512 512H204.8v-102.4l512-512z"
                                                              Width="13" Height="13"
                                                              Foreground="{DynamicResource ThemeTextSubBrush}"/>
                                                </Button>
                                                
                                                <Button Command="{Binding $parent[UserControl].((vm:ChartManagerViewModel)DataContext).DeleteSpecificCategoryCommand}"
                                                        CommandParameter="{Binding Name}"
                                                        Classes="CardActionBtn"
                                                        ToolTip.Tip="{Binding [Str_092], Source={x:Static i18n:I18nService.Instance}}">
                                                    <Button.Styles>
                                                        <Style Selector="Button:pointerover PathIcon">
                                                            <Setter Property="Foreground" Value="#FF4D4D"/>
                                                        </Style>
                                                    </Button.Styles>
                                                    <PathIcon Data="M981.465503 192.054069v42.678682a20.185863 20.185863 0 0 1-6.055759 15.283582 20.474233 20.474233 0 0 1-15.283582 6.055759H896.108139v630.952408a152.259082 152.259082 0 0 1-31.143904 95.738665 92.85497 92.85497 0 0 1-75.264432 40.371727H234.300197a93.720079 93.720079 0 0 1-75.264432-38.929879 145.914954 145.914954 0 0 1-31.143904-94.296818v-634.412842H63.873838a19.897494 19.897494 0 0 1-15.283582-6.055759 20.474233 20.474233 0 0 1-6.055759-15.283582V192.342439a20.185863 20.185863 0 0 1 6.055759-15.283582 20.474233 20.474233 0 0 1 15.283582-6.055759h206.184174l46.715855-111.310617A94.008448 94.008448 0 0 1 352.820051 17.590538a94.873557 94.873557 0 0 1 52.771613-17.302169h213.393411a94.008448 94.008448 0 0 1 52.771613 17.302169 91.989862 91.989862 0 0 1 36.046184 42.101943l46.715855 111.310617h205.895804a20.185863 20.185863 0 0 1 15.283582 6.055759 20.762602 20.762602 0 0 1 5.47902 14.995212z m-597.501549 640.180231V362.768798a20.185863 20.185863 0 0 0-6.055759-15.283583 20.474233 20.474233 0 0 0-15.283582-6.055759H319.945931a20.185863 20.185863 0 0 0-15.283582 6.055759 20.474233 20.474233 0 0 0-6.055759 15.283583v469.465502a20.185863 20.185863 0 0 0 6.055759 15.283582 20.474233 20.474233 0 0 0 15.283582 6.055759h42.678682a20.474233 20.474233 0 0 0 21.339341-21.339341zM362.624613 170.714728h298.750774l-32.009011-77.859758a18.167277 18.167277 0 0 0-11.534779-7.209236h-211.086455a18.744016 18.744016 0 0 0-11.534779 7.209236z m192.054069 661.519572V362.768798a20.185863 20.185863 0 0 0-6.055759-15.283583 20.474233 20.474233 0 0 0-15.283582-6.055759h-42.678682a20.185863 20.185863 0 0 0-15.283582 6.055759 20.474233 20.474233 0 0 0-6.055759 15.283583v469.465502a20.185863 20.185863 0 0 0 6.055759 15.283582 20.474233 20.474233 0 0 0 15.283582 6.055759h42.678682a20.185863 20.185863 0 0 0 15.283582-6.055759 20.762602 20.762602 0 0 0 6.055759-15.283582z m170.714728 0V362.768798a20.185863 20.185863 0 0 0-6.055759