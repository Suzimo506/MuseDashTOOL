<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MdModManager.ViewModels"
             xmlns:controls="using:MdModManager.Controls"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="700"
             x:Class="MdModManager.Views.EuterpeWebView"
             x:DataType="vm:EuterpeWebViewModel">
    <Grid RowDefinitions="Auto,*" Margin="28,24,28,20" RowSpacing="12">
        <Border Background="{DynamicResource EuterpeTopPanelBgBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,9">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Button Width="32"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        ToolTip.Tip="返回上一页"
                        Click="OnGoBackClick">
                    <PathIcon Data="M19,11H7.83L12.71,6.12A1,1 0 0,0 11.29,4.71L4,12L11.29,19.29A1,1 0 0,0 12.71,17.88L7.83,13H19A1,1 0 0,0 19,11Z"
                              Width="18"
                              Height="18" />
                </Button>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Euterpe 谱面库"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock Text="下载教程：点击下载按键展开菜单，选择下载 ZIP，即可自动转换并安装。"
                               Foreground="{DynamicResource ThemeTextSubBrush}"
                               FontSize="13" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource ShellContentBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <controls:EuterpeWebViewHost x:Name="WebViewHost"
                                         Source="{Binding BrowserUrl}"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch" />
        </Border>
    </Grid>
</UserControl>
