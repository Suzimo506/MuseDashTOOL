<UserControl xmlns:i18n="using:MdModManager.Services" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MdModManager.ViewModels"
             xmlns:models="using:MdModManager.Models"
             xmlns:controls="using:MdModManager.Views.Controls"
             xmlns:helpers="using:MdModManager.Helpers"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             xmlns:animated="clr-namespace:AnimatedImage.Avalonia;assembly=AnimatedImage.Avalonia"
             x:Class="MdModManager.Views.AlbumDetailView"
             x:DataType="vm:AlbumDetailViewModel">

    <UserControl.Resources>
        <ControlTheme x:Key="SmallRoundBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="RootBg" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#RootBg"><Setter Property="Opacity" Value="0.8"/></Style>
            <Style Selector="^:pressed /template/ Border#RootBg"><Setter Property="Opacity" Value="0.6"/><Setter Property="RenderTransform" Value="scale(0.96)"/></Style>
        </ControlTheme>

        <ControlTheme x:Key="RobustIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="RootBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#RootBorder"><Setter Property="Opacity" Value="0.8"/></Style>
            <Style Selector="^:pressed"><Setter Property="RenderTransform" Value="scale(0.92)"/></Style>
            <Style Selector="^:pressed /template/ Border#RootBorder"><Setter Property="Opacity" Value="0.6"/></Style>
        </ControlTheme>

    </UserControl.Resources>

    <UserControl.Styles>
        <!-- 谱面卡片样式升级 -->
        <Style Selector="Border.Card">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#2C1E2B" Offset="0"/>
                        <GradientStop Color="#191018" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#15FF8EBE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RenderTransform" Value="scale(1.0)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.Card:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.015)"/>
            <Setter Property="BorderBrush" Value="#CCFF8EBE"/>
        </Style>

        <!-- 文件夹/曲包分类卡片样式 (无悬浮缩放，仅有发光轮廓细线) -->
        <Style Selector="Border.FolderCard">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#2C1E2B" Offset="0"/>
                        <GradientStop Color="#191018" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#15FF8EBE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.FolderCard:pointerover">
            <Setter Property="BorderBrush" Value="#CCFF8EBE"/>
        </Style>

        <!-- 列表行卡片样式 -->
        <Style Selector="Border.ListRowBorder">
            <Setter Property="BorderBrush" Value="#15FF8EBE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ListRow:pointerover Border.ListRowBorder">
            <Setter Property="BorderBrush" Value="#CCFF8EBE"/>
        </Style>
    </UserControl.Styles>

    <Panel>
    <Grid RowDefinitions="Auto,Auto,*" PointerPressed="OnBackgroundPointerPressed" Background="Transparent">
        <!-- 顶部栏：返回按钮 + 标题 + 工具按钮 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="10,10,10,14">
            <Button Grid.Column="0" Command="{Binding GoBackCommand}" Theme="{StaticResource SmallRoundBtn}" ToolTip.Tip="{Binding [Str_035], Source={x:Static i18n:I18nService.Instance}}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Path Data="M732.794579 1020.867765a58.608941 58.608941 0 0 1-41.803294-17.558589L247.478814 553.984a60.446118 60.446118 0 0 1 0-84.720941L690.991285 19.847529a58.578824 58.578824 0 0 1 83.606588 0 60.446118 60.446118 0 0 1 0 84.720942L372.979049 511.638588 774.597873 918.588235a60.446118 60.446118 0 0 1 0 84.720941 58.608941 58.608941 0 0 1-41.803294 17.558589z"
                          Fill="{DynamicResource SvgIconBrush}" Stretch="Uniform" Width="22" Height="22" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Category.Name}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Color="#FF00FF" Offset="0"/>
                                <GradientStop Color="#FF69B4" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <Button Command="{Binding OpenHomepageCommand}"
                            IsVisible="{Binding HasHomepageLink}"
                            Theme="{StaticResource SmallRoundBtn}"
                            VerticalAlignment="Center"
                            Padding="12,5"
                            ToolTip.Tip="{Binding [Str_036], Source={x:Static i18n:I18nService.Instance}}">
                        <TextBlock Text="{Binding [Str_037], Source={x:Static i18n:I18nService.Instance}}" FontSize="12" Foreground="{DynamicResource SvgIconBrush}" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource ThemeTextSubBrush}"/>
            </StackPanel>

            <Button Grid.Column="2"
                    Command="{Binding ToggleListModeCommand}"
                    IsVisible="{Binding IsVirtualCategory}"
                    Theme="{StaticResource RobustIconBtn}"
                    ToolTip.Tip="{Binding ViewModeToolTip}"
                    VerticalAlignment="Center"
                    Margin="0,0,15,0">
                <PathIcon Data="{Binding ViewModeIconData}"
                          Foreground="{DynamicResource SvgIconBrush}"
                          Width="22"
                          Height="22"/>
            </Button>
            
            <TextBox Grid.Column="3"
                     Text="{Binding SearchText}"
                     IsVisible="{Binding ShowChartContent}"
                     Classes="ExpandableSearch"
                     Classes.HasText="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Margin="0,0,10,0"
                     MinWidth="0"
                     ContextFlyout="{x:Null}"
                     HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBox.Styles>
                    <Style Selector="TextBox.ExpandableSearch">
                        <Setter Property="Width" Value="280" />
                        <Setter Property="Transitions">
                            <Transitions>
                                <DoubleTransition Property="Width" Duration="0:0:0.3" Easing="CubicEaseOut" />
                            </Transitions>
                        </Setter>
                    </Style>
                    <Style Selector="TextBox.ExpandableSearch:focus, TextBox.ExpandableSearch.HasText">
                        <Setter Property="Watermark" Value="{Binding [Str_339], Source={x:Static i18n:I18nService.Instance}}" />
                    </Style>
                    <Style Selector="TextBox.ExpandableSearch:not(:focus):not(.HasText)">
                        <Setter Property="Width" Value="32" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Watermark" Value="" />
                    </Style>
                    <Style Selector="TextBox.ExpandableSearch:not(:focus):not(.HasText):pointerover /template/ Border#PART_BorderElement">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </TextBox.Styles>
                <TextBox.InnerRightContent>
                    <Border Background="Transparent" 
                            PointerPressed="OnSearchIconPointerPressed" 
                            Cursor="Hand" 
                            ToolTip.Tip="{Binding [Str_038], Source={x:Static i18n:I18nService.Instance}}" 
                            VerticalAlignment="Center" 
                            Padding="8">
                        <PathIcon Data="M415.59889935 818.40673751c-103.69194019 0-207.38388041-39.48836529-286.31642412-118.42090898-157.86508737-157.87981634-157.86508737-414.78248979 0-572.66230613 157.85035841-157.85035841 414.76776082-157.90927428 572.64757719 0 157.86508737 157.87981634 157.86508737 414.78248979 0 572.66230613-78.93254368 78.93254368-182.63921287 118.42090898-286.33115307 118.42090898z m0-725.22496474c-82.09927197 0-164.21327292 31.25487175-226.70828746 93.74988629-125.00475803 125.00475803-125.00475803 328.44127481 0 453.44603281 125.01948701 124.9753001 328.41181686 125.03421596 453.43130386 0 125.00475803-125.00475803 125.00475803-328.44127481 0-453.44603281-62.5097435-62.49501453-144.60901547-93.74988627-226.7230164-93.74988629z M973.48804978 1013.69813456c-10.78160515 0-21.57793927-4.10938229-29.79670383-12.34287584L658.31757585 715.95203069c-16.46698708-16.46698708-16.46698708-43.14114955 0-59.60813666s43.14114955-16.46698708 59.60813665 0l285.37377009 285.38849908c16.46698708 16.46698708 16.46698708 43.14114955 0 59.60813663a42.07329932 42.07329932 0 0 1-29.81143281 12.35760482z"
                                  Width="16" Height="16" Foreground="{DynamicResource SvgIconBrush}"/>
                    </Border>
                </TextBox.InnerRightContent>
            </TextBox>

            <Button Grid.Column="4"
                    Command="{Binding DownloadAllCommand}"
                    IsVisible="{Binding ShowChartContent}"
                    Theme="{StaticResource SmallRoundBtn}"
                    ToolTip.Tip="{Binding [Str_039], Source={x:Static i18n:I18nService.Instance}}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right">
                <Viewbox Width="24" Height="24">
                    <Canvas Width="1024" Height="1024">
                        <Path Data="M967.06 312.92c-31.4 0-56.9 25.5-56.9 56.9v512h-796.4v-512c0.7-31.4-24.2-57.4-55.6-58.1-31.4-0.7-57.4 24.2-58.1 55.6v571.3c0 31.4 25.5 56.9 56.9 56.9h910.2c31.4 0 56.9-25.5 56.9-56.9v-568.8c-0.1-31.4-25.5-56.9-57-56.9z"
                              Fill="{DynamicResource SvgIconBrush}"/>
                        <Path Data="M284.46 768.02h455.1c31.4-0.7 56.3-26.7 55.6-58.1-0.7-30.5-25.2-55-55.6-55.6h-455.1c-31.4 0.7-56.3 26.7-55.6 58.1 0.6 30.4 25.1 55 55.6 55.6z m187.1-244c5.2 5.1 11.4 9.2 18.2 12 2.5 1.4 5.2 2.1 8 2.3 9.3 2.8 19.2 2.8 28.5 0 2.8-0.2 5.5-1 8-2.3 6.8-2.8 13-6.8 18.2-12l161-161c22.3-22.3 22.3-58.5 0-80.8-22.3-22.3-58.5-22.3-80.8 0l-63.7 64.3V85.32c0-31.4-25.5-56.9-56.9-56.9s-56.9 25.5-56.9 56.9v261.1l-63.6-64.3c-21.9-22.8-58-23.5-80.8-1.6-22.8 21.9-23.5 58-1.6 80.8l1.6 1.6 160.8 161.1z"
                              Fill="{DynamicResource SvgIconBrush}"/>
                    </Canvas>
                </Viewbox>
            </Button>
        </Grid>

        <!-- 工具栏：分页栏 -->
        <Grid Grid.Row="1" Margin="10,0,10,14" IsVisible="{Binding ShowChartContent}">
            <Border Background="Transparent" HorizontalAlignment="Center" Padding="12,6" CornerRadius="10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Command="{Binding LoadFirstPageCommand}" IsEnabled="{Binding CanLoadPrev}" Theme="{StaticResource RobustIconBtn}" ToolTip.Tip="{Binding [Str_022], Source={x:Static i18n:I18nService.Instance}}">
                        <PathIcon Data="M321.53 929m-41.47 0l0 0q-41.47 0-41.47-41.47l0-747.06q0-41.47 41.47-41.47l0 0q41.47 0 41.47 41.47l0 747.06q0 41.47-41.47 41.47Z M787.26 170L411.44 514.25l375.82 344.21a39.32 39.32 0 0 1 13.11 29c0 36.51-48.2 54.79-76.38 29L348.17 572.2c-34.95-32-34.95-83.9 0-115.9L724 112.08c28.18-25.81 76.38-7.53 76.38 29A39.33 39.33 0 0 1 787.26 170z" Foreground="{DynamicResource SvgIconBrush}" Width="14" Height="14"/>
                    </Button>
                    <Button Command="{Binding LoadPrevPageCommand}" IsEnabled="{Binding CanLoadPrev}" Theme="{StaticResource RobustIconBtn}" ToolTip.Tip="{Binding [Str_023], Source={x:Static i18n:I18nService.Instance}}">
                        <PathIcon Data="M704 944c-10.88 0-22.4-3.84-31.36-11.52l-448-384c-10.88-8.96-16.64-22.4-16.64-36.48s6.4-27.52 16.64-36.48l448-384c19.84-17.28 50.56-14.72 67.84 5.12s14.72 50.56-5.12 67.84L329.6 512l405.76 347.52c19.84 17.28 22.4 47.36 5.12 67.84-9.6 10.88-23.04 16.64-36.48 16.64z" Foreground="{DynamicResource SvgIconBrush}" Width="16" Height="16"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Str_024], Source={x:Static i18n:I18nService.Instance}}" Foreground="{DynamicResource ThemeTextSubBrush}" VerticalAlignment="Center" FontSize="11"/>
                        <Panel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentPage}" Foreground="{DynamicResource SvgIconBrush}" FontWeight="ExtraBold" FontSize="12" Cursor="Hand" PointerPressed="OnPageNumberClick" IsVisible="{Binding !IsEditingPageNumber}"/>
                            <TextBox Text="{Binding JumpPageText}" Foreground="{DynamicResource SvgIconBrush}" FontWeight="Bold" FontSize="12" Width="42" Height="22" Padding="2,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderThickness="1" CornerRadius="4" LostFocus="OnPageJumpLostFocus" IsVisible="{Binding IsEditingPageNumber}" Background="{DynamicResource ControlBgBrush}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Command="{Binding JumpPageCommand}" Gesture="Enter"/>
                                    <KeyBinding Command="{Binding CancelEditPageCommand}" Gesture="Escape"/>
                                </TextBox.KeyBindings>
                            </TextBox>
                        </Panel>
                        <TextBlock Text="/" Foreground="{DynamicResource ThemeTextSubBrush}" VerticalAlignment="Center" FontSize="11"/><TextBlock Text="{Binding TotalPages}" Foreground="{DynamicResource ThemeTextSubBrush}" VerticalAlignment="Center" FontSize="11"/><TextBlock Text="{Binding [Str_025], Source={x:Static i18n:I18nService.Instance}}" Foreground="{DynamicResource ThemeTextSubBrush}" VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                    <Button Command="{Binding LoadNextPageCommand}" IsEnabled="{Binding CanLoadNext}" Theme="{StaticResource RobustIconBtn}" ToolTip.Tip="{Binding [Str_026], Source={x:Static i18n:I18nService.Instance}}">
                        <PathIcon Data="M288 944c10.88 0 22.4-3.84-31.36-11.52l448-384c10.88-8.96 16.64-22.4 16.64-36.48s-6.4-27.52-16.64-36.48l-448-384c-19.84-17.28-50.56-14.72-67.84 5.12s-14.72 50.56 5.12 67.84L662.4 512l-405.76 347.52c-19.84 17.28-22.4 47.36-5.12 67.84 9.6 10.88 23.04 16.64 36.48 16.64z" Foreground="{DynamicResource SvgIconBrush}" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding LoadLastPageCommand}" IsEnabled="{Binding CanLoadNext}" Theme="{StaticResource RobustIconBtn}" ToolTip.Tip="{Binding [Str_027], Source={x:Static i18n:I18nService.Instance}}">
                        <PathIcon Data="M706.19 106m41.47 0l0 0q41.47 0 41.47 41.47l0 747.06q0 41.47-41.47 41.47l0 0q-41.47 0-41.47-41.47l0-747.06q0-41.47 41.47-41.47Z M240.46 865l375.81-344.25-375.81-344.21a39.32 39.32 0 0 1-13.11-29c0-36.51 48.2-54.79 76.38-29L679.55 462.8c35 32 35 83.9 0 115.9L303.73 922.92c-28.18 25.81-76.38 7.53-76.38-29A39.33 39.33 0 0 1 240.46 865z" Foreground="{DynamicResource SvgIconBrush}" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 卡片网格主体 -->
        <Grid Grid.Row="2" Background="Transparent">
            <!-- 加载中 -->
            <StackPanel IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <TextBlock Text="{Binding [Str_040], Source={x:Static i18n:I18nService.Instance}}" FontSize="18" Foreground="#888888" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- 空状态 -->
            <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15">
                <TextBlock Text="{Binding [Str_041], Source={x:Static i18n:I18nService.Instance}}" FontSize="18" Foreground="Gray" HorizontalAlignment="Center"/>
            </StackPanel>

            <ScrollViewer IsVisible="{Binding ShowVirtualCardMode}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SubCategories}" Margin="10,0,10,20">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" HorizontalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DesignerCategoryItemViewModel">
                            <Button x:Name="SubCategoryCardButton"
                                    Command="{Binding $parent[UserControl].((vm:AlbumDetailViewModel)DataContext).OpenSubCategoryCommand}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Margin="8,0,8,16"
                                    Cursor="Hand">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </Button.Styles>
                                <Border Classes="FolderCard"
                                        CornerRadius="10"
                                        ClipToBounds="True">
                                    <Grid RowDefinitions="180,*">
                                        <Border Grid.Row="0"
                                                ClipToBounds="True"
                                                Background="#333333">
                                            <Grid>
                                                <TextBlock Text="📁"
                                                           FontSize="56"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="#555555"
                                                           IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNull}}"/>
                                                <Image Source="{Binding CoverImage}"
                                                       Stretch="UniformToFill"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                <Border Classes="HoverDescription"
                                                        Background="#CC000000"
                                                        Padding="12"
                                                        IsVisible="{Binding #SubCategoryCardButton.IsPointerOver}">
                                                    <TextBlock Text="{Binding Category.Description}"
                                                               FontSize="12"
                                                               Foreground="White"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Bottom"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Row="1" Margin="12,12,12,14" Spacing="6">
                                            <TextBlock Text="{Binding Category.Name}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource ThemeTextMainBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <ScrollViewer IsVisible="{Binding ShowVirtualListMode}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid ColumnDefinitions="*,*" Margin="10,0,10,20">
                    <ItemsControl Grid.Column="0" ItemsSource="{Binding SubCategoryListLeftColumn}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DesignerCategoryItemViewModel">
                                <Button Classes="ListRow"
                                        Command="{Binding $parent[UserControl].((vm:AlbumDetailViewModel)DataContext).OpenSubCategoryCommand}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        Margin="8,0,8,10"
                                        Cursor="Hand">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                    </Button.Styles>
                                    <Border Classes="ListRowBorder"
                                            Background="{DynamicResource CardBgBrush}"
                                            CornerRadius="10"
                                            Padding="14,12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Category.Name}"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource ThemeTextMainBrush}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Category.Description}"
                                                           IsVisible="{Binding Category.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource ThemeTextSubBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <PathIcon Grid.Column="1"
                                                      Data="M288 944c10.88 0 22.4-3.84 31.36-11.52l448-384c10.88-8.96 16.64-22.4 16.64-36.48s-6.4-27.52-16.64-36.48l-448-384c-19.84-17.28-50.56-14.72-67.84 5.12s-14.72 50.56 5.12 67.84L662.4 512l-405.76 347.52c-19.84 17.28-22.4 47.36-5.12 67.84 9.6 10.88 23.04 16.64 36.48 16.64z"
                                                      Width="16"
                                                      Height="16"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource ThemeTextTertiaryBrush}"/>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl Grid.Column="1" ItemsSource="{Binding SubCategoryListRightColumn}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DesignerCategoryItemViewModel">
                                <Button Classes="ListRow"
                                        Command="{Binding $parent[UserControl].((vm:AlbumDetailViewModel)DataContext).OpenSubCategoryCommand}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        Margin="8,0,8,10"
                                        Cursor="Hand">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                    </Button.Styles>
                                    <Border Classes="ListRowBorder"
                                            Background="{DynamicResource CardBgBrush}"
                                            CornerRadius="10"
                                            Padding="14,12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Category.Name}"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource ThemeTextMainBrush}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Category.Description}"
                                                           IsVisible="{Binding Category.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource ThemeTextSubBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <PathIcon Grid.Column="1"
                                                      Data="M288 944c10.88 0 22.4-3.84 31.36-11.52l448-384c10.88-8.96 16.64-22.4 16.64-36.48s-6.4-27.52-16.64-36.48l-448-384c-19.84-17.28-50.56-14.72-67.84 5.12s-14.72 50.56 5.12 67.84L662.4 512l-405.76 347.52c-19.84 17.28-22.4 47.36-5.12 67.84 9.6 10.88 23.04 16.64 36.48 16.64z"
                                                      Width="16"
                                                      Height="16"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource ThemeTextTertiaryBrush}"/>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <ScrollViewer x:Name="ChartScrollViewer" IsVisible="{Binding ShowChartContent}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Charts}" Margin="10,16,10,20">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ChartGridColumns}" HorizontalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:MdmcChart">
                            <Border Classes="Card" CornerRadius="10" Margin="8,4,8,12" VerticalAlignment="Top" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,*">
                                    <!-- 封面图区域 -->
                                    <Border Grid.Row="0" Height="170" ClipToBounds="True" CornerRadius="10,10,0,0">
                                        <Panel>
                                            <Border Background="#333333" CornerRadius="10,10,0,0" IsVisible="{Binding !HasDisplayCoverSource}">
                                                <TextBlock Text="🎵" FontSize="56" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#555555"/>
                                            </Border>
                                            <Image IsVisible="{Binding ShouldShowAnimatedCover}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" animated:ImageBehavior.AnimatedSource="{Binding AnimatedDisplayCoverSource}"/>
                                            <asyncImageLoader:AdvancedImage Loader="{Binding CoverLoader}" Source="{Binding DisplayCoverSource}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShouldShowStaticCover}"/>
                                            <Border IsVisible="{Binding IsPlaying}" Background="#80000000" CornerRadius="10,10,0,0">
                                                <TextBlock Text="{Binding [Str_030], Source={x:Static i18n:I18nService.Instance}}" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Panel>
                                    </Border>
                                    
                                    <StackPanel Grid.Row="1" Margin="12,10,12,10" Spacing="4">
                                        <controls:MarqueeText Text="{Binding Title}" HighlightText="{Binding Title}" SearchText="{Binding SearchText}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMainBrush}" Height="20" IsScrollingEnabled="{Binding $parent[UserControl].((vm:AlbumDetailViewModel)DataContext).EnableMarquee}" ToolTip.Tip="{Binding Title}"/>
                                        <!-- 曲师 -->
                                        <TextBlock helpers:TextBlockHelper.HighlightText="{Binding DisplayArtist}"
                                                   helpers:TextBlockHelper.SearchText="{Binding SearchText}"
                                                   IsVisible="{Binding DisplayArtist, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   FontSize="11" Foreground="{DynamicResource ThemeTextSubBrush}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding DisplayArtist}"/>
                                        <!-- 谱师 -->
                                        <TextBlock helpers:TextBlockHelper.HighlightText="{Binding DisplayCharter}"
                                                   helpers:TextBlockHelper.SearchText="{Binding SearchText}"
                                                   IsVisible="{Binding DisplayCharter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   FontSize="11" Foreground="{DynamicResource ThemeTextSubBrush}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding DisplayCharter}"/>
                                        
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Spacing="8" MinHeight="16">
                                            <TextBlock Text="{Binding Bpm, StringFormat='BPM: \{0\}'}"
                                                       IsVisible="{Binding Bpm, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource ThemeTextTertiaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <ItemsControl ItemsSource="{Binding DifficultyLabels}" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate><DataTemplate><Border Background="#26F25D9C" BorderBrush="#80F25D9C" BorderThickness="1" CornerRadius="4" Padding="5,1"><TextBlock Text="{Binding}" FontSize="10" Foreground="#FF8EBE" FontWeight="SemiBold"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        
                                        <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                                            <Button Grid.Column="0" Theme="{StaticResource RobustIconBtn}" HorizontalAlignment="Center" Command="{Binding $parent[UserControl].((vm:AlbumDetailViewModel)DataContext).TogglePreviewCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding [Str_031], Source={x:Static i18n:I18nService.Instance}}">
                                                <Panel>
                                                    <PathIcon IsVisible="{Binding !IsPlaying}" Data="M896 512L128 1024V0z" Foreground="{DynamicResource SvgIconBrush}" Width="20" Height="20"/>
                                                    <PathIcon IsVisible="{Binding IsPlaying}" Data="M722.9375 933.875H301.0625a210.9375 210.9375 0 0 1-210.9375-210.9375V301.0625a210.9375 210.9375 0 0 1 210.9375-210.9375h421.875a210.9375 210.9375 0 0 1 210.9375 210.9375v421.875a210.9375 210.9375 0 0 1-210.9375 210.9375z" Foreground="{DynamicResource SvgIconBrush}" Width="20" Height="20"/>
                                                </Panel>
                                            </Button>
                                            <Button Grid.Column="1" Theme="{StaticResource RobustIconBtn}" HorizontalAlignment="Center" Command="{Binding $parent[UserControl].((vm:AlbumDetailViewModel)DataContext).DownloadChartCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding [Str_033], Source={x:Static i18n:I18nService.Instance}}">
                                                <PathIcon Data="M498.347 824.32l-296.96-296.96c-11.947-11.947-3.414-34.133 13.653-34.133h160.427c11.946 0 20.48-8.534 20.48-20.48V54.613c0-11.946 8.533-20.48 20.48-20.48h189.44c11.946 0 20.48 8.534 20.48 20.48v418.134c0 11.946 8.533 20.48 20.48 20.48h160.426c18.774 0 27.307 22.186 13.654 34.133L525.653 824.32c-6.826 6.827-20.48 6.827-27.306 0zM916.48 989.867H107.52c-18.773 0-35.84-15.36-35.84-35.84 0-18.774 15.36-35.84 35.84-35.84h810.667c18.773 0 35.84 15.36 35.84 35.84-1.707 20.48-17.067 35.84-37.547 35.84z" Foreground="{DynamicResource SvgIconBrush}" Width="20" Height="20"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>

        <!-- 批量查重对话框 Overlay -->
        <Grid Background="#B0000000" IsVisible="{Binding IsBatchDuplicateDialogOpen}">
            <Border Background="{DynamicResource CardBgBrush}" 
                    BorderBrush="#FF8EBE" 
                    BorderThickness="1.5" 
                    CornerRadius="16" 
                    Width="680" 
                    MaxHeight="550"
                    Padding="24"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    BoxShadow="0 8 32 #80000000">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="16">
                    <!-- 头部 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <PathIcon Data="M512 80C273.44 80 80 273.44 80 512s193.44 432 432 432 432-193.44 432-432S750.56 80 512 80zm0 80c194.24 0 352 157.76 352 352S706.24 864 512 864 160 706.24 160 512 317.76 160 512 160zm-40 140v300h80V300h-80zm0 380v80h80v-80h-80z" 
                                  Foreground="#FF8EBE" Width="28" Height="28"/>
                        <TextBlock Text="{Binding [Str_429], Source={x:Static i18n:I18nService.Instance}}" 
                                   FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMainBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 描述 -->
                    <TextBlock Grid.Row="1" Text="{Binding BatchDuplicateItems.Count, StringFormat='检测到以下 \{0\} 个谱面在本地已存在。请选择操作：'}" 
                               FontSize="14" Foreground="{DynamicResource ThemeTextMainBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    
                    <!-- 全局快捷操作 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Button Content="{Binding [Str_431], Source={x:Static i18n:I18nService.Instance}}" 
                                Command="{Binding BatchActionAllCommand}" CommandParameter="skip"
                                Padding="12,6" Background="#26FFFFFF" Foreground="{DynamicResource ThemeTextMainBrush}" CornerRadius="6" FontSize="12" Cursor="Hand"/>
                        <Button Content="{Binding [Str_432], Source={x:Static i18n:I18nService.Instance}}" 
                                Command="{Binding BatchActionAllCommand}" CommandParameter="overwrite"
                                Padding="12,6" Background="#26FFFFFF" Foreground="{DynamicResource ThemeTextMainBrush}" CornerRadius="6" FontSize="12" Cursor="Hand"/>
                        <Button Content="{Binding [Str_433], Source={x:Static i18n:I18nService.Instance}}" 
                                Command="{Binding BatchActionAllCommand}" CommandParameter="both"
                                Padding="12,6" Background="#26FFFFFF" Foreground="{DynamicResource ThemeTextMainBrush}" CornerRadius="6" FontSize="12" Cursor="Hand"/>
                    </StackPanel>

                    <!-- 重复项目冲突列表 -->
                    <Border Grid.Row="3" Background="#1C151B" CornerRadius="10" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding BatchDuplicateItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1" Padding="0,8,0,10">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                <!-- 左侧谱面信息 -->
                                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Chart.Title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                                    <TextBlock Text="{Binding Chart.DisplayCharter}" FontSize="11" Foreground="{DynamicResource ThemeTextSubBrush}"/>
                                                    <ItemsControl ItemsSource="{Binding Duplicates}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Name, StringFormat='[本地已存在] \{0\}'}" FontSize="11" Foreground="#FF8EBE" Opacity="0.8"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <!-- 右侧操作选择 -->
                                                <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedActionIndex, Mode=TwoWay}" Width="140" VerticalAlignment="Center" CornerRadius="8" FontSize="12">
                                                    <ComboBoxItem Tag="skip" Content="{Binding [Str_428], Source={x:Static i18n:I18nService.Instance}}"/>
                                                    <ComboBoxItem Tag="overwrite" Content="{Binding [Str_426], Source={x:Static i18n:I18nService.Instance}}"/>
                                                    <ComboBoxItem Tag="both" Content="{Binding [Str_427], Source={x:Static i18n:I18nService.Instance}}"/>
                                                </ComboBox>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- 底部确定/取消按钮 -->
                    <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,8,0,0">
                        <Button Grid.Column="0" Content="{Binding [Str_ConfirmDownload], Source={x:Static i18n:I18nService.Instance}}" 
                                Command="{Binding ConfirmBatchDownloadCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,10"
                                Background="#D04060" Foreground="White" CornerRadius="8" FontWeight="Bold" Cursor="Hand"/>
                        <Button Grid.Column="1" Content="{Binding [Str_Cancel], Source={x:Static i18n:I18nService.Instance}}" 
                                Command="{Binding CancelBatchCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,10"
                                Background="Transparent" BorderBrush="{DynamicResource ThemeTextSubBrush}" BorderThickness="1" Foreground="{DynamicResource ThemeTextSubBrush}" CornerRadius="8" Cursor="Hand"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 单谱面查重对话框 Overlay -->
        <Grid Background="#B0000000" IsVisible="{Binding ChartDownload.IsDuplicateDialogOpen}">
            <Border Background="{DynamicResource CardBgBrush}" 
                    BorderBrush="#FF8EBE" 
                    BorderThickness="1.5" 
                    CornerRadius="16" 
                    Width="450" 
                    Padding="24"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    BoxShadow="0 8 32 #80000000">
                <StackPanel Spacing="16">
                    <!-- 头部 -->
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <PathIcon Data="M512 80C273.44 80 80 273.44 80 512s193.44 432 432 432 432-193.44 432-432S750.56 80 512 80zm0 80c194.24 0 352 157.76 352 352S706.24 864 512 864 160 706.24 160 512 317.76 160 512 160zm-40 140v300h80V300h-80zm0 380v80h80v-80h-80z" 
                                  Foreground="#FF8EBE" Width="28" Height="28"/>
                        <TextBlock Text="{Binding [Str_424], Source={x:Static i18n:I18nService.Instance}}" 
                                   FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMainBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 内容 -->
                    <TextBlock Text="{Binding ChartDownload.DuplicateDialogTarget.Title, StringFormat='谱面 《{0}》 已存在于本地。'}" 
                               FontSize="14" Foreground="{DynamicResource ThemeTextMainBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    
                    <!-- 本地重复文件列表 -->
                    <Border Background="#1C151B" CornerRadius="8" Padding="12" MaxHeight="150">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ChartDownload.DuplicateDialogItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,4" Spacing="8">
                                            <TextBlock Text="📁" FontSize="12" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                                <TextBlock Text="{Binding DisplayCharter}" FontSize="11" Foreground="{DynamicResource ThemeTextSubBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- 底部操作按钮 -->
                    <StackPanel Spacing="10" Margin="0,8,0,0">
                        <Button Content="{Binding [Str_426], Source={x:Static i18n:I18nService.Instance}}" 
                                Command="{Binding ChartDownload.ConfirmSingleDownloadActionCommand}" CommandParameter="overwrite"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,10"
                                Background="#D04060" Foreground="White" CornerRadius="8" FontWeight="Bold" Cursor="Hand"/>
                        <Button Content="{Binding [Str_427], Source={x:Static i18n:I18nService.Instance}}" 
                                Command="{Binding ChartDownload.ConfirmSingleDownloadActionCommand}" CommandParameter="both"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,10"
                                Background="{DynamicResource ControlBgBrush}" Foreground="{DynamicResource ThemeTextMainBrush}" CornerRadius="8" Cursor="Hand"/>
                        <Button Content="{Binding [Str_428], Source={x:Static i18n:I18nService.Instance}}" 
                                Command="{Binding ChartDownload.ConfirmSingleDownloadActionCommand}" CommandParameter="skip"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,10"
                                Background="Transparent" BorderBrush="{DynamicResource ThemeTextSubBrush}" BorderThickness="1" Foreground="{DynamicResource ThemeTextSubBrush}" CornerRadius="8" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Panel>
</UserControl>
