<UserControl xmlns:i18n="using:MdModManager.Services" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MdModManager.ViewModels"
             xmlns:conv="using:MdModManager.Converters"
             xmlns:views="using:MdModManager.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="MdModManager.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             DragDrop.AllowDrop="True"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <conv:StringToFontFamilyConverter x:Key="FontFamilyConverter" />
        <!-- 纯图标按钮主题 -->
        <ControlTheme x:Key="RobustPlainIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="RootBorder" Background="Transparent">
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#RootBorder">
                <Setter Property="Opacity" Value="0.8"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#RootBorder">
                <Setter Property="Opacity" Value="0.6"/>
            </Style>
        </ControlTheme>

        <!-- 小型圆角按钮主题 (彻底隔离影响，纯透明背景) -->
        <ControlTheme x:Key="SmallRoundBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="RootBg"
                            Background="Transparent"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#RootBg">
                <Setter Property="Opacity" Value="0.8"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#RootBg">
                <Setter Property="Opacity" Value="0.6"/>
                <Setter Property="RenderTransform" Value="scale(0.96)"/>
            </Style>
        </ControlTheme>

        <!-- 透明效果选项按钮 (ToggleButton 风格，透明背景隔离) -->
        <ControlTheme x:Key="TranspOptionBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMainBrush}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="RootBg"
                            Background="Transparent"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#RootBg">
                <Setter Property="Opacity" Value="0.8"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#RootBg">
                <Setter Property="Opacity" Value="0.6"/>
                <Setter Property="RenderTransform" Value="scale(0.96)"/>
            </Style>
        </ControlTheme>

        <!-- 滑动条禁用态重写：提升深色模式可见度 -->
        <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#555555"/>
        <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#777777"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#888888"/>
    </UserControl.Resources>

    <Panel>
        <!-- ══════════════════════════════════════════════════════
             主设置面板 (IsColorPanelVisible = false 时显示)
             ══════════════════════════════════════════════════════ -->
        <Grid IsVisible="{Binding IsMainPanelVisible}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="30" Margin="20">

                    <!-- 标题行：左侧标题 + 右侧功能按钮组 -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding [Str_155], Source={x:Static i18n:I18nService.Instance}}" FontSize="28" FontWeight="Bold"
                                   VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                    <GradientStop Color="#FF00FF" Offset="0"/>
                                    <GradientStop Color="#FF69B4" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <Button Grid.Column="1"
                                Command="{Binding InstallCustomChartsCommand}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Padding="14,7"
                                Background="#FF6699"
                                Foreground="White"
                                BorderThickness="0"
                                CornerRadius="6"
                                Cursor="Hand"
                                ToolTip.Tip="{Binding [Str_189], Source={x:Static i18n:I18nService.Instance}}">
                            <TextBlock Text="{Binding [Str_190], Source={x:Static i18n:I18nService.Instance}}" FontSize="14" FontWeight="Bold"/>
                        </Button>
                    </Grid>

                    <!-- 运行与启动设置 -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding [Str_191], Source={x:Static i18n:I18nService.Instance}}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSubBrush}" Opacity="0.8" Margin="4,0,0,0"/>
                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="20,16">
                            <StackPanel Spacing="16">


                                <!-- 以原版启动游戏 -->
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,20,0">
                                        <TextBlock Text="{Binding [Str_192], Source={x:Static i18n:I18nService.Instance}}" FontSize="16" Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                        <TextBlock Text="{Binding [Str_193], Source={x:Static i18n:I18nService.Instance}}" FontSize="12" Foreground="{DynamicResource ThemeTextSubBrush}" Opacity="0.6"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsOriginalModeEnabled}" VerticalAlignment="Center"/>
                                </Grid>
                                
                                <Border Height="1" Background="{DynamicResource ThemeTextSubBrush}" Opacity="0.08"/>

                                <!-- 启动游戏时隐藏控制台 -->
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,20,0">
                                        <TextBlock Text="{Binding [Str_194], Source={x:Static i18n:I18nService.Instance}}" FontSize="16" Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                        <TextBlock Text="{Binding [Str_195], Source={x:Static i18n:I18nService.Instance}}" FontSize="12" Foreground="{DynamicResource ThemeTextSubBrush}" Opacity="0.6"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding HideConsoleOnLaunch}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource ThemeTextSubBrush}" Opacity="0.08"/>

                                <!-- 启动与重启免确认 -->
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,20,0">
                                        <TextBlock Text="{Binding [Str_196], Source={x:Static i18n:I18nService.Instance}}" FontSize="16" Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                        <TextBlock Text="{Binding [Str_197], Source={x:Static i18n:I18nService.Instance}}" FontSize="12" Foreground="{DynamicResource ThemeTextSubBrush}" Opacity="0.6"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding SuppressLaunchGameConfirmation}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource ThemeTextSubBrush}" Opacity="0.08"/>

                                <!-- MelonLoader 管理 -->
                                <Button Command="{Binding OpenMelonLoaderPanelCommand}"
                                        HorizontalAlignment="Stretch"
                                        Theme="{StaticResource RobustPlainIconBtn}">
                                    <Grid ColumnDefinitions="*, Auto" Background="Transparent">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding [Str_198], Source={x:Static i18n:I18nService.Instance}}" FontSize="16" Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                            <TextBlock Text="{Binding [Str_199], Source={x:Static i18n:I18nService.Instance}}" FontSize="12" Foreground="{DynamicResource ThemeTextSubBrush}" Opacity="0.6"/>
                                        </StackPanel>
                                        <PathIcon Grid.Column="1" Data="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" Foreground="{DynamicResource ThemeTextSubBrush}" Width="16" Height="16" VerticalAlignment="Center" Opacity="0.6"/>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 下载与搜索设置 -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding [Str_200], Source={x:Static i18n:I18nService.Instance}}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSubBrush}" Opacity="0.8" Margin="4,0,0,0"/>
                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="20,16">
                            <StackPanel Spacing="16">
                                <!-- 下载源配置 -->
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,20,0">
                                        <TextBlock Text="{Binding [Str_201], Source={x:Static i18n:I18nService.Instance}}" FontSize="16" Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                        <TextBlock Text="{Binding [Str_202], Source={x:Static i18n:I18nService.Instance}}" FontSize="12" Foreground="{DynamicResource ThemeTextSubBrush}" Opacity="0.6"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding DownloadSources}"
                                              SelectedItem="{Binding SelectedDownloadSource}"
                                              Foreground="{DynamicResource ThemeTextMainBrush}"
                                              Width="150" HorizontalContentAlignment="Left"
                                              VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource ThemeTextSubBrush}" Opacity="0.08"/>

                                <!-- 启用搜索模糊匹配 -->
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,20,0">
                                        <TextBlock Text="{Binding [Str_203], Source={x:Static i18n:I18nService.Instance}}" FontSize="16" Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                        <TextBlock Text="{Binding [Str_204], Source={x:Static i18n:I18nService.Instance}}" FontSize="12" Foreground="{DynamicResource ThemeTextSubBrush}" Opacity="0.6"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding EnableFuzzySearch}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource ThemeTextSubBrush}" Opacity="0.08"/>

                                <!-- 自动翻译 Mod 信息 -->
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,20,0">
                                        <TextBlock Text="{Binding [Str_205], Source={x:Static i18n:I18nService.Instance}}" FontSize="16" Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                        <TextBlock Text="{Binding [Str_206], Source={x:Static i18n:I18nService.Instance}}" FontSize="12" Foreground="{DynamicResource ThemeTextSubBrush}" Opacity="0.6"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AutoTranslateDescriptions}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource ThemeTextSubBrush}" Opacity="0.08"/>

                                <!-- 下载不兼容 Mod 免提示 -->
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,20,0">
                                        <TextBlock Text="{Binding [Str_207], Source={x:Static i18n:I18nService.Instance}}" FontSize="16" Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                        <TextBlock Text="{Binding [Str_208], Source={x:Static i18n:I18nService.Instance}}" FontSize="12" Foreground="{DynamicResource ThemeTextSubBrush}" Opacity="0.6"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding SuppressIncompatibleModWarning}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource ThemeTextSubBrush}" Opacity="0.08"/>

                                <!-- 删除操作免确认 -->
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,20,0">
                                        <TextBlock Text="{Binding [Str_209], Source={x:Static i18n:I18nService.Instance}}" FontSize="16" Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                        <TextBlock Text="{Binding [Str_210], Source={x:Static i18n:I18nService.Instance}}" FontSize="12" Foreground="{DynamicResource ThemeTextSubBrush}" Opacity="0.6"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding SuppressDeleteConfirmation}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource ThemeTextSubBrush}" Opacity="0.08"/>

                                <!-- 启用下载单谱查重提示 -->
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,20,0">
                                        <TextBlock Text="{Binding [Str_434], Source={x:Static i18n:I18nService.Instance}}" FontSize="16" Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                        <TextBlock Text="{Binding [Str_434_Desc], Source={x:Static i18n:I18nService.Instance}}" FontSize="12" Foreground="{DynamicResource ThemeTextSubBrush}" Opacity="0.6"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding EnableDownloadDuplicateCheck}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource ThemeTextSubBrush}" Opacity="0.08"/>

                                <!-- 启用批量下载查重提示 -->
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,20,0">
                                        <TextBlock Text="{Binding [Str_435], Source={x:Static i18n:I18nService.Instance}}" FontSize="16" Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                        <TextBlock Text="{Binding [Str_435_Desc], Source={x:Static i18n:I18nService.Instance}}" FontSize="12" Foreground="{DynamicResource ThemeTextSubBrush}" Opacity="0.6"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding EnableBatchDownloadDuplicateCheck}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 多媒体与个性化设置 -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding [Str_211], Source={x:Static i18n:I18nService.Instance}}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSubBrush}" Opacity="0.8" Margin="4,0,0,0"/>
                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="20,16">
                            <StackPanel Spacing="16">
                                <!-- 谱面试听音量 -->
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,20,0">
                                        <TextBlock Text="{Binding [Str_212], Source={x:Static i18n:I18nService.Instance}}" FontSize="16" Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                        <TextBlock Text="{Binding [Str_213], Source={x:Static i18n:I18nService.Instance}}" FontSize="12" Foreground="{DynamicResource ThemeTextSubBrush}" Opacity="0.6"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Slider Width="130" Minimum="0" Maximum="1"
                                                Value="{Binding ChartPreviewVolume}"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ChartPreviewVolume, StringFormat={}{0:P0}}"
                                                   Foreground="{DynamicResource ThemeTextSubBrush}"
                                                   FontSize="12" Width="40" TextAlignment="Right" VerticalAlignment="Center" Opacity="0.8"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource ThemeTextSubBrush}" Opacity="0.08"/>

                                <!-- 谱面名称跑马灯 -->
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,20,0">
                                        <TextBlock Text="{Binding [Str_214], Source={x:Static i18n:I18nService.Instance}}" FontSize="16" Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                        <TextBlock Text="{Binding [Str_215], Source={x:Static i18n:I18nService.Instance}}" FontSize="12" Foreground="{DynamicResource ThemeTextSubBrush}" Opacity="0.6"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding EnableChartNameMarquee}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource ThemeTextSubBrush}" Opacity="0.08"/>

                                <!-- 调整界面样式 -->
                                <Button Command="{Binding OpenColorPanelCommand}"
                                        HorizontalAlignment="Stretch"
                                        Theme="{StaticResource RobustPlainIconBtn}">
                                    <Grid ColumnDefinitions="*, Auto" Background="Transparent">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding [Str_216], Source={x:Static i18n:I18nService.Instance}}" FontSize="16" Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                            <TextBlock Text="{Binding [Str_217], Source={x:Static i18n:I18nService.Instance}}" FontSize="12" Foreground="{DynamicResource ThemeTextSubBrush}" Opacity="0.6"/>
                                        </StackPanel>
                                        <PathIcon Grid.Column="1" Data="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" Foreground="{DynamicResource ThemeTextSubBrush}" Width="16" Height="16" VerticalAlignment="Center" Opacity="0.6"/>
                                    </Grid>
                                </Button>

                                <Border Height="1" Background="{DynamicResource ThemeTextSubBrush}" Opacity="0.08"/>

                                <!-- 高级设置 -->
                                <Button Command="{Binding OpenAdvancedPanelCommand}"
                                        HorizontalAlignment="Stretch"
                                        Theme="{StaticResource RobustPlainIconBtn}">
                                    <Grid ColumnDefinitions="*, Auto" Background="Transparent">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding [Str_218], Source={x:Static i18n:I18nService.Instance}}" FontSize="16" Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                            <TextBlock Text="{Binding [Str_219], Source={x:Static i18n:I18nService.Instance}}" FontSize="12" Foreground="{DynamicResource ThemeTextSubBrush}" Opacity="0.6"/>
                                        </StackPanel>
                                        <PathIcon Grid.Column="1" Data="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" Foreground="{DynamicResource ThemeTextSubBrush}" Width="16" Height="16" VerticalAlignment="Center" Opacity="0.6"/>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 语言设置 / Language -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding [Str_356], Source={x:Static i18n:I18nService.Instance}}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSubBrush}" Opacity="0.8" Margin="4,0,0,0"/>
                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="20,16">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,20,0">
                                    <TextBlock Text="{Binding [Str_357], Source={x:Static i18n:I18nService.Instance}}" FontSize="16" Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                    <TextBlock Text="{Binding [Str_358], Source={x:Static i18n:I18nService.Instance}}" FontSize="12" Foreground="{DynamicResource ThemeTextSubBrush}" Opacity="0.6"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}"
                                          SelectedItem="{Binding SelectedLanguage}"
                                          Foreground="{DynamicResource ThemeTextMainBrush}"
                                          Width="150" HorizontalContentAlignment="Left"
                                          VerticalAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ══════════════════════════════════════════════════════
             颜色子面板 (IsColorPanelVisible = true 时显示)
             ══════════════════════════════════════════════════════ -->
        <!-- Added ScrollViewer inside the Color Panel -->
        <Grid IsVisible="{Binding IsColorPanelVisible}">
            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <StackPanel Spacing="22" Margin="20">

                <!-- 顶部栏：返回按钮 + 标题 + 右侧操作按钮组 -->
                <Grid ColumnDefinitions="Auto,*,Auto">

                    <!-- 左上角：返回按钮 -->
                    <Button Grid.Column="0"
                            Command="{Binding CloseColorPanelCommand}"
                            Theme="{StaticResource SmallRoundBtn}"
                            ToolTip.Tip="{Binding [Str_220], Source={x:Static i18n:I18nService.Instance}}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <!-- New SVG back arrow icon -->
                            <Path Data="M732.794579 1020.867765a58.608941 58.608941 0 0 1-41.803294-17.558589L247.478814 553.984a60.446118 60.446118 0 0 1 0-84.720941L690.991285 19.847529a58.578824 58.578824 0 0 1 83.606588 0 60.446118 60.446118 0 0 1 0 84.720942L372.979049 511.638588 774.597873 918.588235a60.446118 60.446118 0 0 1 0 84.720941 58.608941 58.608941 0 0 1-41.803294 17.558589z"
                                  Fill="{DynamicResource SvgIconBrush}" Stretch="Uniform" Width="22" Height="22" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- (Removed Title TextBlock) -->
                    <!-- 右上角：主题切换 + 导入图片 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">

                        <Button Command="{Binding ToggleThemeCommand}"
                                Theme="{StaticResource SmallRoundBtn}"
                                ToolTip.Tip="{Binding [Str_221], Source={x:Static i18n:I18nService.Instance}}">
                            <PathIcon Data="{Binding ThemeToggleIconData}"
                                      Foreground="{DynamicResource SvgIconBrush}" Width="18" Height="18" />
                        </Button>

                        <Button Command="{Binding SelectBackgroundImageCommand}"
                                Theme="{StaticResource SmallRoundBtn}"
                                ToolTip.Tip="{Binding [Str_222], Source={x:Static i18n:I18nService.Instance}}"
                                PointerReleased="OnImportImagePointerReleased">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="M737.7 447.9c-51.9 0-95.9-44-95.9-95.9 0-52 44-96 95.9-96 52 0 96 44 96 96-0.1 51.9-44 95.9-96 95.9z m168-319.8c32 0 55.9 23.9 55.9 56v655.6c0 32-23.9 55.9-55.9 55.9H122c-32.1 0-56-24-56-55.9V184c0-32.1 23.9-56 56-56l783.7 0.1zM699.6 523.9l198 211.8V215.9c0-13.9-12-23.9-26.1-23.9H155.9c-14 0-24 10.1-26 23.9v519.8L381.8 432c8-8.1 20-16 34-16 13.9 0 25.9 4 34 14l108 118 8 7.8c6 4 13.9 8 22 8 8 0 16-4 23.9-10l36.1-32c7.9-6 15.9-10 25.9-10 10 0.1 20 4.1 25.9 12.1z"
                                      Foreground="{DynamicResource SvgIconBrush}" Width="14" Height="14"/>
                                <TextBlock Text="{Binding [Str_223], Source={x:Static i18n:I18nService.Instance}}" Foreground="{DynamicResource ThemeTextMainBrush}" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ─── 分组：透明窗口效果 ─── -->
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="16,12">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding [Str_224], Source={x:Static i18n:I18nService.Instance}}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeTextMainBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">

                            <!-- 无效果 -->
                            <Button Command="{Binding SetTransparencyModeCommand}"
                                    CommandParameter="None"
                                    Theme="{StaticResource TranspOptionBtn}">
                                <TextBlock Text="{Binding [Str_225], Source={x:Static i18n:I18nService.Instance}}"
                                           Foreground="{DynamicResource ThemeTextMainBrush}"/>
                            </Button>



                            <!-- 全透明 -->
                            <Button Command="{Binding SetTransparencyModeCommand}"
                                    CommandParameter="Transparent"
                                    Theme="{StaticResource TranspOptionBtn}">
                                <TextBlock Text="{Binding [Str_226], Source={x:Static i18n:I18nService.Instance}}"
                                           Foreground="{DynamicResource ThemeTextMainBrush}"/>
                            </Button>

                            <!-- Mica（云母）Windows 11 -->
                            <Button Command="{Binding SetTransparencyModeCommand}"
                                    CommandParameter="Mica"
                                    Theme="{StaticResource TranspOptionBtn}"
                                    ToolTip.Tip="{Binding [Str_227], Source={x:Static i18n:I18nService.Instance}}">
                                <TextBlock Text="🪨 Mica"
                                           Foreground="{DynamicResource ThemeTextMainBrush}"/>
                            </Button>

                            <!-- Acrylic（亚克力） -->
                            <Button Command="{Binding SetTransparencyModeCommand}"
                                    CommandParameter="AcrylicBlur"
                                    Theme="{StaticResource TranspOptionBtn}"
                                    ToolTip.Tip="{Binding [Str_228], Source={x:Static i18n:I18nService.Instance}}">
                                <TextBlock Text="🫧 Acrylic"
                                           Foreground="{DynamicResource ThemeTextMainBrush}"/>
                            </Button>

                        </StackPanel>

                        <!-- 当前选择状态提示 -->
                        <TextBlock FontSize="12" Opacity="0.6"
                                   Foreground="{DynamicResource ThemeTextMainBrush}"
                                   Text="{Binding TransparencyModeDisplayName, StringFormat='当前效果：{0}'}"/>
                    </StackPanel>
                </Border>

                <!-- ─── 分组：背景亮度 / 左侧按键字体横向间隔 ─── -->
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="16,12">
                    <Grid ColumnDefinitions="*, 20, *">
                        <!-- 左半边：背景亮度 -->
                        <StackPanel Grid.Column="0" Spacing="10">
                            <TextBlock Text="{Binding [Str_229], Source={x:Static i18n:I18nService.Instance}}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemeTextMainBrush}"/>
                            <Grid ColumnDefinitions="*,50">
                                <Slider Grid.Column="0"
                                        Minimum="0.05" Maximum="1.0"
                                        Value="{Binding CustomBackgroundOpacity}"
                                        IsEnabled="{Binding HasBackgroundImage}"
                                        TickFrequency="0.01"
                                        VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource ThemeTextSubBrush}"
                                           FontSize="13">
                                    <TextBlock.Text>
                                        <Binding Path="CustomBackgroundOpacity" StringFormat="{}{0:P0}"/>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <!-- 分割线 -->
                        <Border Grid.Column="1" Width="1" Background="{DynamicResource ThemeTextSubBrush}" Opacity="0.2" Margin="0,5"/>

                        <!-- 右半边：左侧按键字体横向间隔 -->
                        <StackPanel Grid.Column="2" Spacing="10">
                            <TextBlock Text="{Binding [Str_230], Source={x:Static i18n:I18nService.Instance}}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemeTextMainBrush}"/>
                            <Grid ColumnDefinitions="*,50">
                                <Slider Grid.Column="0"
                                        Minimum="0" Maximum="20"
                                        Value="{Binding NavButtonLetterSpacing}"
                                        TickFrequency="1"
                                        VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource ThemeTextSubBrush}"
                                           FontSize="13" Text="{Binding NavButtonLetterSpacing, StringFormat={}{0:F0}}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ─── 分组：背景不透明度 / 背景模糊程度 ─── -->
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="16,12">
                    <Grid ColumnDefinitions="*, 20, *">
                        <!-- 左半边：背景透明度 (原窗口透明度) -->
                        <StackPanel Grid.Column="0" Spacing="10">
                            <TextBlock Text="{Binding [Str_231], Source={x:Static i18n:I18nService.Instance}}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemeTextMainBrush}"/>
                            <Grid ColumnDefinitions="*,50">
                                <Slider Grid.Column="0"
                                        Minimum="0.1" Maximum="1.0"
                                        Value="{Binding WindowOpacity}"
                                        IsEnabled="{Binding IsWindowOpacityEnabled}"
                                        TickFrequency="0.01"
                                        VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource ThemeTextSubBrush}"
                                           FontSize="13">
                                    <TextBlock.Text>
                                        <Binding Path="WindowOpacity" StringFormat="{}{0:P0}"/>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <!-- 分割线 -->
                        <Border Grid.Column="1" Width="1" Background="{DynamicResource ThemeTextSubBrush}" Opacity="0.2" Margin="0,5"/>

                        <!-- 右半边：背景模糊程度 -->
                        <StackPanel Grid.Column="2" Spacing="10">
                            <TextBlock Text="{Binding [Str_232], Source={x:Static i18n:I18nService.Instance}}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemeTextMainBrush}"/>
                            <Grid ColumnDefinitions="*,50">
                                <Slider Grid.Column="0"
                                        Minimum="0" Maximum="50"
                                        Value="{Binding BackgroundBlurRadius}"
                                        IsEnabled="{Binding HasBackgroundImage}"
                                        TickFrequency="1"
                                        VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource ThemeTextSubBrush}"
                                           FontSize="13" Text="{Binding BackgroundBlurRadius, StringFormat={}{0:F0}}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ─── 分组：字体选择 ─── -->
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="16,12">
                    <Grid ColumnDefinitions="*, 20, *">
                        <!-- 左半边：字体选择与预览 -->
                        <StackPanel Grid.Column="0" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [Str_233], Source={x:Static i18n:I18nService.Instance}}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemeTextMainBrush}"
                                       VerticalAlignment="Center"/>
                            <Grid ColumnDefinitions="1.5*,Auto,*" ColumnSpacing="15">
                                <ComboBox Grid.Column="0" 
                                          ItemsSource="{Binding AvailableFonts}" 
                                          SelectedIndex="{Binding SelectedFontIndex}" 
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource ControlBgBrush}"
                                          Foreground="{DynamicResource ThemeTextMainBrush}"
                                          BorderThickness="1"
                                          BorderBrush="{DynamicResource ThemeTextSubBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" 
                                                       FontFamily="{Binding Converter={StaticResource FontFamilyConverter}}"
                                                       Foreground="{DynamicResource ThemeTextMainBrush}"
                                                       FontSize="14" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           Text="{Binding [Str_234], Source={x:Static i18n:I18nService.Instance}}" TextAlignment="Left"
                                           Foreground="{DynamicResource ThemeTextSubBrush}"
                                           FontSize="14" TextTrimming="CharacterEllipsis">
                                    <TextBlock.FontFamily>
                                        <Binding Path="CustomFontFamily"/>
                                    </TextBlock.FontFamily>
                                </TextBlock>
                                <Button Grid.Column="2"
                                        Command="{Binding ImportFontCommand}"
                                        Theme="{StaticResource RobustPlainIconBtn}"
                                        ToolTip.Tip="{Binding [Str_235], Source={x:Static i18n:I18nService.Instance}}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <PathIcon Data="M563.2 42.666667v640c0 23.466667-19.2 42.666667-42.666667 42.666666s-42.666667-19.2-42.666666-42.666666V42.666667c0-23.466667 19.2-42.666667 42.666666-42.666667s42.666667 19.2 42.666667 42.666667 M806.1952 457.275733L550.5792 712.900267a42.7776 42.7776 0 0 1-60.330667 0c-16.597333-16.605867-16.597333-43.776 0-60.330667l255.616-255.624533a42.7776 42.7776 0 0 1 60.330667 0 42.7776 42.7776 0 0 1 0 60.330666 M490.350933 712.8832L234.734933 457.275733a42.7776 42.7776 0 0 1 0-60.330666c16.597333-16.605867 43.776-16.605867 60.330667 0l255.616 255.616a42.7776 42.7776 0 0 1 0 60.330666 42.7776 42.7776 0 0 1-60.330667 0 M904.533333 1024H136.533333c-70.570667 0-128-57.429333-128-128V640c0-23.594667 19.072-42.666667 42.666667-42.666667s42.666667 19.072 42.666667 42.666667v256c0 23.552 19.114667 42.666667 42.666666 42.666667h768c23.552 0 42.666667-19.114667 42.666667-42.666667V640c0-23.594667 19.072-42.666667 42.666667-42.666667s42.666667 19.072 42.666666 42.666667v256c0 70.570667-57.429333 128-128 128" 
                                              Foreground="{DynamicResource SvgIconBrush}" Width="20" Height="20"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- 中间：分割线 -->
                        <Border Grid.Column="1" Width="1" Background="{DynamicResource ThemeTextSubBrush}" Opacity="0.2" Margin="0,5"/>

                        <!-- 右半边：字体大小调整 -->
                        <StackPanel Grid.Column="2" Spacing="10" VerticalAlignment="Center" Margin="0,0,0,0">
                            <TextBlock Text="{Binding [Str_236], Source={x:Static i18n:I18nService.Instance}}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemeTextMainBrush}"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Slider Grid.Column="0" Minimum="12" Maximum="17" Value="{Binding CustomFontSize}" 
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding CustomFontSize, StringFormat='\{0\}'}" 
                                           Foreground="{DynamicResource ThemeTextMainBrush}"
                                           FontSize="14" VerticalAlignment="Center" Width="20" TextAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ─── 分组：文本颜色 ─── -->
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <StackPanel Orientation="Vertical" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [Str_237], Source={x:Static i18n:I18nService.Instance}}"
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource ThemeTextMainBrush}"
                                       VerticalAlignment="Center"/>
                            <Button Command="{Binding OpenHexColorHelpCommand}"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    Margin="5,2,0,0" VerticalAlignment="Bottom">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </Button.Styles>
                                <TextBlock Text="{Binding [Str_238], Source={x:Static i18n:I18nService.Instance}}" 
                                           FontSize="11" Opacity="0.6"
                                           TextDecorations="Underline"
                                           Foreground="{DynamicResource ThemeTextMainBrush}"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" MinHeight="30">
                            <TextBlock Text="{Binding [Str_239], Source={x:Static i18n:I18nService.Instance}}"
                                       Foreground="{DynamicResource ThemeTextMainBrush}"
                                       VerticalAlignment="Center"
                                       FontSize="13"/>
                            <TextBox Text="{Binding CustomThemeTextColor}"
                                     Watermark="#FFFFFF"
                                     Width="100" Height="30"
                                     Padding="8,0"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     FontSize="13"/>

                            <Control Width="1" Margin="10,5"/>

                            <TextBlock Text="{Binding [Str_240], Source={x:Static i18n:I18nService.Instance}}"
                                       Foreground="{DynamicResource ThemeTextMainBrush}"
                                       VerticalAlignment="Center"
                                       FontSize="13"/>
                            <TextBox Text="{Binding RightPanelTextColor}"
                                     Watermark="#FFFFFF"
                                     Width="100" Height="30"
                                     Padding="8,0"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     FontSize="13"/>
                                     
                            <Control Width="1" Margin="10,5"/>

                            <TextBlock Text="{Binding [Str_241], Source={x:Static i18n:I18nService.Instance}}"
                                       Foreground="{DynamicResource ThemeTextMainBrush}"
                                       VerticalAlignment="Center"
                                       FontSize="13"/>
                            <TextBox Text="{Binding CustomThemeColor}"
                                     Watermark="#d4237a"
                                     Width="100" Height="30"
                                     Padding="8,0"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     FontSize="13"/>

                            <!-- 一键清除按键 -->
                            <Button Command="{Binding ResetColorsCommand}"
                                    Width="30" Height="30"
                                    Margin="15,0,0,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="5"
                                    ToolTip.Tip="{Binding [Str_242], Source={x:Static i18n:I18nService.Instance}}">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                </Button.Styles>
                                <PathIcon Data="M886.401 395.097h-251.7V80.614c0-22.091-19.899-40-44.447-40H439.148c-24.547 0-44.447 17.909-44.447 40v314.483h-251.7c-22.315 0-40.404 17.909-40.404 40v506.471c0 22.091 18.09 40 40.404 40h743.4c22.315 0 40.404-17.909 40.404-40V435.097c0.001-22.092-18.089-40-40.404-40z m-10.72 536.47h-127.98V831c0-17.673-12.088-32-27-32s-27 14.327-27 32v100.567h-152V792c0-14.912-12.088-27-27-27s-27 12.088-27 27v139.567h-152V831c0-17.673-12.088-32-27-32s-27 14.327-27 32v100.567H152.597V688.332h723.084v243.235z m0-293.235H152.597V445.097h291.882V90.614h137.819v354.483H875.68v193.235z" 
                                          Foreground="{DynamicResource SvgIconBrush}"/>
                            </Button>

                            <!-- 一键撤回按键 -->
                            <Button Command="{Binding UndoColorsCommand}"
                                    Width="30" Height="30"
                                    Margin="5,0,0,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="5"
                                    ToolTip.Tip="{Binding [Str_243], Source={x:Static i18n:I18nService.Instance}}">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                </Button.Styles>
                                <PathIcon Data="M704 352H173.4l137.3-137.4a32 32 0 0 0-45.2-45.2L73.9 360.9a32 32 0 0 0 0 45.8l191.4 191.9a32 32 0 1 0 45.3-45.3L173.3 416H704a192 192 0 0 1 0 384h-320a32 32 0 1 0 0 64h320a256 256 0 0 0 0-512z" 
                                          Foreground="{DynamicResource SvgIconBrush}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ══════════════════════════════════════════════════════
             高级设置面板 (IsAdvancedPanelVisible = true 时显示)
             ══════════════════════════════════════════════════════ -->
        <Grid IsVisible="{Binding IsAdvancedPanelVisible}">
            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <StackPanel Spacing="22" Margin="20">
                    
                    <!-- 顶部栏：返回按钮 + 标题 -->
                    <Grid ColumnDefinitions="Auto, 10, *">
                        <!-- 左方：返回按钮 -->
                        <Button Grid.Column="0" HorizontalAlignment="Left"
                                Command="{Binding CloseAdvancedPanelCommand}"
                                Theme="{StaticResource SmallRoundBtn}"
                                ToolTip.Tip="{Binding [Str_220], Source={x:Static i18n:I18nService.Instance}}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Path Data="M732.794579 1020.867765a58.608941 58.608941 0 0 1-41.803294-17.558589L247.478814 553.984a60.446118 60.446118 0 0 1 0-84.720941L690.991285 19.847529a58.578824 58.578824 0 0 1 83.606588 0 60.446118 60.446118 0 0 1 0 84.720942L372.979049 511.638588 774.597873 918.588235a60.446118 60.446118 0 0 1 0 84.720941 58.608941 58.608941 0 0 1-41.803294 17.558589z"
                                      Fill="{DynamicResource SvgIconBrush}" Stretch="Uniform" Width="22" Height="22" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Grid.Column="2" Text="{Binding [Str_218], Source={x:Static i18n:I18nService.Instance}}" FontSize="28" FontWeight="Bold" VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                    <GradientStop Color="#d4237a" Offset="0"/>
                                    <GradientStop Color="#FF69B4" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </Grid>
                    
                    <!-- ─── 分组：自定义 IP 设置 ─── -->
                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="16,12">
                        <StackPanel Spacing="15">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding [Str_244], Source={x:Static i18n:I18nService.Instance}}"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                        <!-- 显示当前正在使用的 IP -->
                                        <TextBlock Text="{Binding CurrentEffectiveIp, StringFormat='(当前使用: {0})'}"
                                                   FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                                   Foreground="{DynamicResource ThemeTextSubBrush}"
                                                   IsVisible="{Binding UseOptimizedIps}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding [Str_245], Source={x:Static i18n:I18nService.Instance}}"
                                               FontSize="12" Opacity="0.6"
                                               Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" 
                                          IsChecked="{Binding UseCustomIp}"
                                          VerticalAlignment="Top"/>
                            </Grid>

                            <Separator Background="{DynamicResource ThemeTextSubBrush}" Opacity="0.1" Height="1"/>

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBox Width="320"
                                         HorizontalAlignment="Left"
                                         Text="{Binding CustomIpAddress}"
                                         Watermark="{Binding [Str_246], Source={x:Static i18n:I18nService.Instance}}"
                                         IsEnabled="{Binding UseCustomIp}"
                                         Height="36"
                                         VerticalContentAlignment="Center"
                                         Foreground="{DynamicResource ThemeTextMainBrush}"
                                         CaretBrush="{DynamicResource ThemeTextMainBrush}"
                                         SelectionBrush="Gray"
                                         BorderThickness="0,0,0,1"
                                         BorderBrush="{DynamicResource ThemeTextSubBrush}"
                                         FocusAdorner="{x:Null}"
                                         Background="Transparent"/>
                                
                                <Button Command="{Binding ConfirmCustomIpCommand}"
                                        IsEnabled="{Binding UseCustomIp}"
                                        Theme="{StaticResource RobustPlainIconBtn}"
                                        Padding="15,0" Height="36">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="M834.1 182.2c-15.1-15.1-39.6-15.1-54.7 0L383.6 578 244.7 439.1c-15.1-15.1-39.6-15.1-54.7 0-15.1 15.1-15.1 39.6 0 54.7l163.6 163.6c15.1 15.1 39.6 15.1 54.7 0l425.8-425.8c15.1-15.1 15.1-39.6-0-54.7z" 
                                                  Width="14" Height="14" Foreground="{DynamicResource SvgIconBrush}"/>
                                        <TextBlock Text="{Binding [Str_247], Source={x:Static i18n:I18nService.Instance}}" VerticalAlignment="Center" FontSize="14"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- 以后在这里填充更多高级设置内容 -->
                    <TextBlock Text="{Binding [Str_248], Source={x:Static i18n:I18nService.Instance}}" 
                               FontSize="14" Opacity="0.4"
                               Foreground="{DynamicResource ThemeTextMainBrush}"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- MelonLoader 管理面板 -->
        <Grid IsVisible="{Binding IsMelonLoaderPanelVisible}">
            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <StackPanel Spacing="22" Margin="20">
                    
                    <!-- 顶部栏 -->
                    <Grid ColumnDefinitions="Auto, 10, *">
                        <!-- 返回按钮 -->
                        <Button Grid.Column="0" HorizontalAlignment="Left"
                                Command="{Binding CloseMelonLoaderPanelCommand}"
                                Theme="{StaticResource SmallRoundBtn}"
                                ToolTip.Tip="{Binding [Str_220], Source={x:Static i18n:I18nService.Instance}}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Path Data="M732.794579 1020.867765a58.608941 58.608941 0 0 1-41.803294-17.558589L247.478814 553.984a60.446118 60.446118 0 0 1 0-84.720941L690.991285 19.847529a58.578824 58.578824 0 0 1 83.606588 0 60.446118 60.446118 0 0 1 0 84.720942L372.979049 511.638588 774.597873 918.588235a60.446118 60.446118 0 0 1 0 84.720941 58.608941 58.608941 0 0 1-41.803294 17.558589z"
                                      Fill="{DynamicResource SvgIconBrush}" Stretch="Uniform" Width="22" Height="22" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 标题 -->
                        <TextBlock Grid.Column="2" Text="{Binding [Str_249], Source={x:Static i18n:I18nService.Instance}}" FontSize="28" FontWeight="Bold" VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                    <GradientStop Color="#d4237a" Offset="0"/>
                                    <GradientStop Color="#FF69B4" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </Grid>
                    
                    <!-- MelonLoader 视图 -->
                    <views:MelonLoaderView DataContext="{Binding MelonLoaderVm}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Panel>
</UserControl>
