<Window xmlns:i18n="using:MdModManager.Services" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MdModManager.Views.DeleteConfirmDialog"
        Title="{Binding [Str_114], Source={x:Static i18n:I18nService.Instance}}"
        Width="420" Height="200"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DialogBgBrush}"
        Foreground="{DynamicResource ThemeTextMainBrush}">

    <Grid RowDefinitions="*, Auto" Margin="24">

        <!-- 提示文本，使用带左边框的红色警告卡片包装 -->
        <Border Grid.Row="0"
                Background="{DynamicResource ControlBgBrush}"
                BorderBrush="{DynamicResource SoftDangerBrush}"
                BorderThickness="3,0,0,0"
                CornerRadius="8"
                Padding="18,14">
            <TextBlock Text="{Binding [Str_115], Source={x:Static i18n:I18nService.Instance}}"
                       TextWrapping="Wrap"
                       FontSize="14.5"
                       LineHeight="24"
                       Foreground="{DynamicResource ThemeTextMainBrush}"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- 底部按钮区 -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto, 10, Auto" Margin="0,18,0,0">

            <!-- 左下角：不再提示复选框 -->
            <CheckBox Grid.Column="0"
                       x:Name="DontShowAgainCheckBox"
                       Content="{Binding [Str_116], Source={x:Static i18n:I18nService.Instance}}"
                       Foreground="{DynamicResource ThemeTextSubBrush}"
                       CornerRadius="6"
                       FontSize="13"/>

            <!-- 右下角：取消 -->
            <Button Grid.Column="2"
                    Content="{Binding [Str_086], Source={x:Static i18n:I18nService.Instance}}"
                    Width="80"
                    Height="34"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="{DynamicResource ControlBgBrush}"
                    Foreground="{DynamicResource ThemeTextMainBrush}"
                    CornerRadius="10"
                    Click="OnCancelClick">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource ControlHoverBgBrush}"/>
                    </Style>
                </Button.Styles>
            </Button>

            <!-- 右下角：确认 -->
            <Button Grid.Column="4"
                    Content="{Binding [Str_114], Source={x:Static i18n:I18nService.Instance}}"
                    Width="90"
                    Height="34"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="{DynamicResource ThemeAccentBrush}"
                    Foreground="White"
                    CornerRadius="10"
                    Click="OnConfirmClick">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrushPointerOver}"/>
                    </Style>
                </Button.Styles>
            </Button>
        </Grid>
    </Grid>
</Window>
