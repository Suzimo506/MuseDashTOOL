<UserControl xmlns:i18n="using:MdModManager.Services" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MdModManager.ViewModels"
             xmlns:models="using:MdModManager.Models"
             xmlns:controls="using:MdModManager.Views.Controls"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             xmlns:helpers="using:MdModManager.Helpers"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="MdModManager.Views.EuterpeView"
             x:DataType="vm:EuterpeViewModel">

    <UserControl.Resources>
        <!-- 图标按钮专属主题 -->
        <ControlTheme x:Key="RobustIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="RootBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#RootBorder">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Opacity" Value="0.8"/>
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="RenderTransform" Value="scale(0.92)"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#RootBorder">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Opacity" Value="0.6"/>
            </Style>
            <Style Selector="^:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
        </ControlTheme>

        <!-- 纯图标按钮主题 -->
        <ControlTheme x:Key="RobustPlainIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="RootBorder" Background="Transparent">
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#RootBorder">
                <Setter Property="Opacity" Value="0.8"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#RootBorder">
                <Setter Property="Opacity" Value="0.6"/>
            </Style>
            <Style Selector="^:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
        </ControlTheme>

        <!-- 标签筛选按钮专属主题 -->
        <ControlTheme x:Key="TagFilterBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E1624"/>
            <Setter Property="BorderBrush" Value="#2D2136"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#CDA0B7"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="RootBorder" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="{TemplateBinding CornerRadius}" 
                            Padding="{TemplateBinding Padding}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.2"/>
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^ /template/ Border#RootBorder">
                <Setter Property="Background" Value="#1E1624"/>
                <Setter Property="BorderBrush" Value="#2D2136"/>
            </Style>
            <Style Selector="^:pointerover /template/ Border#RootBorder">
                <Setter Property="Background" Value="#251C2F"/>
                <Setter Property="BorderBrush" Value="#E57AE6"/>
                <Setter Property="BoxShadow" Value="0 0 10 1 #33FF00FF"/>
            </Style>
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="White"/>
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="RenderTransform" Value="scale(0.96)"/>
            </Style>
            <Style Selector="^:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
        </ControlTheme>

        <!-- 退出登录按钮主题 -->
        <ControlTheme x:Key="LogoutBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E1624"/>
            <Setter Property="BorderBrush" Value="#2D2136"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#CDA0B7"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="RootBorder" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.2"/>
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^ /template/ Border#RootBorder">
                <Setter Property="Background" Value="#1E1624"/>
                <Setter Property="BorderBrush" Value="#2D2136"/>
            </Style>
            <Style Selector="^:pointerover /template/ Border#RootBorder">
                <Setter Property="Background" Value="#E03C3C"/>
                <Setter Property="BorderBrush" Value="#FF5C5C"/>
                <Setter Property="BoxShadow" Value="0 0 12 2 #66FF5C5C"/>
            </Style>
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="White"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#RootBorder">
                <Setter Property="Background" Value="#C02C2C"/>
                <Setter Property="BorderBrush" Value="#FF4D4D"/>
                <Setter Property="BoxShadow" Value="0 0 8 1 #44FF4D4D"/>
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="RenderTransform" Value="scale(0.92)"/>
            </Style>
            <Style Selector="^:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- 谱面卡片Hover缩放发光和阴影过渡动画 -->
        <Style Selector="Border.ChartCard">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="#2D2136"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="LinearEasing"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" Easing="LinearEasing"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.ChartCard:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
            <Setter Property="BorderBrush" Value="#E57AE6"/>
            <Setter Property="BoxShadow" Value="0 4 20 2 #33FF00FF"/>
        </Style>

        <!-- 心形点赞按钮过渡动画 -->
        <Style Selector="Button.LikeBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="RootBorder" Background="Transparent" CornerRadius="8">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="RenderTransform" Value="scale(1.15)"/>
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="RenderTransform" Value="scale(0.9)"/>
            </Style>
        </Style>



        <!-- 标签 Chip 纸片按钮样式 -->
        <Style Selector="Button.TagChip">
            <Setter Property="Background" Value="#1D1426"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#22FF00FF"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Foreground" Value="#C8B7C1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                    <BrushTransition Property="Background" Duration="0:0:0.1" Easing="LinearEasing"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1" Easing="LinearEasing"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.1" Easing="LinearEasing"/>
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="RootBorder" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="{TemplateBinding CornerRadius}" 
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.TagChip:pointerover /template/ Border#RootBorder">
            <Setter Property="Background" Value="#2E1C3F"/>
            <Setter Property="BorderBrush" Value="#88FF00FF"/>
        </Style>
        <Style Selector="Button.TagChip:pointerover">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="RenderTransform" Value="scale(1.05)"/>
        </Style>
        <Style Selector="Button.TagChip.selected /template/ Border#RootBorder">
            <Setter Property="Background" Value="#FFFF00FF"/>
            <Setter Property="BorderBrush" Value="#FF00FFFF"/>
            <Setter Property="BoxShadow" Value="0 0 8 1 #55FF00FF"/>
        </Style>
        <Style Selector="Button.TagChip.selected">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.TagChip.selected:pointerover /template/ Border#RootBorder">
            <Setter Property="Background" Value="#FF33FF"/>
            <Setter Property="BorderBrush" Value="#FF00FFFF"/>
            <Setter Property="BoxShadow" Value="0 0 10 1.5 #88FF00FF"/>
        </Style>
        <Style Selector="Button.TagChip.selected:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- 搜索框自定义边框配色样式 -->
        <Style Selector="TextBox#SearchTextBox">
            <Setter Property="Background" Value="#1E1624"/>
            <Setter Property="BorderBrush" Value="#2D2136"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBox#SearchTextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#1E1624"/>
            <Setter Property="BorderBrush" Value="#2D2136"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="TextBox#SearchTextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#251C2F"/>
            <Setter Property="BorderBrush" Value="#E57AE6"/>
        </Style>
        <Style Selector="TextBox#SearchTextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#1E1624"/>
            <Setter Property="BorderBrush" Value="#E57AE6"/>
            <Setter Property="BoxShadow" Value="0 0 10 1 #33FF00FF"/>
        </Style>

        <!-- 排序下拉列表自定义边框配色样式 -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#1E1624"/>
            <Setter Property="BorderBrush" Value="#2D2136"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ComboBox /template/ Border#Background">
            <Setter Property="Background" Value="#1E1624"/>
            <Setter Property="BorderBrush" Value="#2D2136"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="ComboBox:pointerover">
            <Setter Property="Background" Value="#251C2F"/>
            <Setter Property="BorderBrush" Value="#E57AE6"/>
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="#251C2F"/>
            <Setter Property="BorderBrush" Value="#E57AE6"/>
            <Setter Property="BoxShadow" Value="0 0 10 1 #33FF00FF"/>
        </Style>
        <Style Selector="ComboBox:dropdownopen">
            <Setter Property="Background" Value="#1E1624"/>
            <Setter Property="BorderBrush" Value="#E57AE6"/>
        </Style>
        <Style Selector="ComboBox:dropdownopen /template/ Border#Background">
            <Setter Property="Background" Value="#1E1624"/>
            <Setter Property="BorderBrush" Value="#E57AE6"/>
            <Setter Property="BoxShadow" Value="0 0 10 1 #33FF00FF"/>
        </Style>

        <!-- 分页栏 Hover 边框高亮 -->
        <Style Selector="Border#TopPaginationBorder, Border#BottomPaginationBorder">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.25"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#TopPaginationBorder:pointerover, Border#BottomPaginationBorder:pointerover">
            <Setter Property="BorderBrush" Value="#E57AE6"/>
            <Setter Property="BoxShadow" Value="0 0 10 1 #33FF00FF"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <Grid RowDefinitions="Auto,Auto,*" PointerPressed="OnBackgroundPointerPressed" Background="Transparent" Margin="16">

        <!-- 顶部个人信息玻璃卡片 (Row 0，占左半侧) -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*" Margin="0,0,0,16">
            <Border Grid.Column="0" Padding="16" CornerRadius="16" BorderThickness="1" BorderBrush="#33FFFFFF" ClipToBounds="True" Background="{DynamicResource EuterpeTopPanelBgBrush}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    
                    <!-- 发光紫粉渐变外圈头像 -->
                    <Border Grid.Column="0" Width="78" Height="78" CornerRadius="39" Padding="3" BorderThickness="2" BoxShadow="0 0 15 3 #80FF00FF" VerticalAlignment="Center">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#FFFF00FF" Offset="0"/>
                                <GradientStop Color="#FF00FFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border CornerRadius="35" ClipToBounds="True" Background="#33FFFFFF">
                            <Panel>
                                <TextBlock Text="👤" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#88FFFFFF"/>
                                <asyncImageLoader:AdvancedImage Source="{Binding AvatarUrl}" Stretch="UniformToFill"/>
                            </Panel>
                        </Border>
                    </Border>

                    <!-- 用户基本信息 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="6">
                        <TextBlock Text="{Binding Nickname}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding Email}" FontSize="12" Foreground="#8A8594"/>
                    </StackPanel>

                    <!-- 退出登录门型按钮 -->
                    <Button Grid.Column="2" Theme="{StaticResource LogoutBtn}" Command="{Binding LogoutCommand}" ToolTip.Tip="{Binding [Str_123], Source={x:Static i18n:I18nService.Instance}}" VerticalAlignment="Center">
                        <Path Fill="{Binding $parent[Button].Foreground}" Stretch="Uniform" Width="16" Height="16" Data="M10 2H5C3.34 2 2 3.34 2 5v14c0 1.66 1.34 3 3 3h5c.55 0 1-.45 1-1s-.45-1-1-1H5c-.55 0-1-.45-1-1V5c0-.55.45-1 1-1h5c.55 0 1-.45 1-1s-.45-1-1-1z M19.78 11.22l-4-4c-.39-.39-1.02-.39-1.41 0s-.39 1.02 0 1.41L16.59 11H9c-.55 0-1 .45-1 1s.45 1 1 1h7.59l-2.22 2.22c-.39.39-.39 1.02 0 1.41.39.39 1.02.39 1.41 0l4-4c.39-.39.39-1.03 0-1.42z"/>
                    </Button>
                </Grid>
            </Border>
            
            <!-- 右半侧免责声明面板 -->
            <Border Grid.Column="1" Margin="16,0,0,0" Padding="16" CornerRadius="16" BorderThickness="1" BorderBrush="#33FFFFFF" ClipToBounds="True" Background="{DynamicResource EuterpeTopPanelBgBrush}">
                <TextBlock TextWrapping="Wrap" FontSize="11" LineHeight="16" Foreground="#8A8594" VerticalAlignment="Center">
                    <Run Text="{Binding [Str_124], Source={x:Static i18n:I18nService.Instance}}"/>
                    <InlineUIContainer>
                        <Button Command="{Binding OpenEuterpeWebCommand}" Cursor="Hand" Padding="0" Margin="2,0,2,-2" Background="Transparent" BorderThickness="0" VerticalAlignment="Bottom">
                            <TextBlock Text="Euterpe-org.com" Foreground="#00C0FF" FontSize="11" TextDecorations="Underline" FontWeight="Bold"/>
                        </Button>
                    </InlineUIContainer>
                    <Run Text="{Binding [Str_125], Source={x:Static i18n:I18nService.Instance}}"/>
                </TextBlock>
            </Border>
        </Grid>

        <!-- 工具栏：搜索 + 排序 ComboBox + 顶部分页栏 (Row 1) -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,16">
            <!-- 搜索框 -->
            <TextBox Grid.Column="0" Name="SearchTextBox" Text="{Binding SearchDraftText}" Watermark="{Binding [Str_126], Source={x:Static i18n:I18nService.Instance}}" VerticalAlignment="Center" Padding="10,8" IsHitTestVisible="{Binding !IsLoading}" IsReadOnly="{Binding IsLoading}" LostFocus="OnSearchBoxLostFocus" KeyDown="OnSearchBoxKeyDown" CornerRadius="10">
                <TextBox.InnerLeftContent>
                    <PathIcon Data="M909.6 854.5L649.9 594.8C690.2 542.7 712 479 712 412c0-80.2-31.3-155.4-87.9-212.1C567.2 143.9 492.3 112 413 112s-154.2 31.9-211.1 88.9C145.5 257.5 114 332.7 114 412c0 79.3 31.3 154.5 88 211.4C259.3 680.3 334.4 712 413 712c67 0 130.6-21.8 182.7-62l259.7 259.6a8.2 8.2 0 0 0 11.6 0l42.6-42.6a8.2 8.2 0 0 0 0-11.5zM570.4 570.4C528 612.7 471.8 636 412 636s-116-23.3-158.4-65.6C211.3 528 188 471.8 188 412s23.3-116.1 65.6-158.4C296 211.3 352.2 188 412 188s116.1 23.2 158.4 65.6S636 352.2 636 412s-23.3 116.1-65.6 158.4z"
                              Foreground="#888888" Width="16" Height="16" Margin="6,0,0,0"/>
                </TextBox.InnerLeftContent>
                <TextBox.InnerRightContent>
                    <Button Command="{Binding ClearSearchCommand}" IsVisible="{Binding SearchDraftText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Theme="{StaticResource RobustPlainIconBtn}" Margin="0,0,10,0">
                        <TextBlock Text="{Binding [Str_021], Source={x:Static i18n:I18nService.Instance}}" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource SvgIconBrush}"/>
                    </Button>
                </TextBox.InnerRightContent>
            </TextBox>

            <!-- 排序 ComboBox -->
            <ComboBox Grid.Column="1" ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SelectedSortIndex}" Width="150" Margin="10,0,0,0" VerticalAlignment="Center" CornerRadius="10">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:EuterpeSortOption">
                        <TextBlock Text="{Binding Label}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- 高级筛选按钮 -->
            <Button Grid.Column="2" Command="{Binding ToggleTagPanelCommand}" Theme="{StaticResource TagFilterBtn}" Margin="10,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 8.25c-.97 0-1.75-.78-1.75-1.75s.78-1.75 1.75-1.75 1.75.78 1.75 1.75-.78 1.75-1.75 1.75z" Width="12" Height="12" Foreground="{Binding $parent[Button].Foreground}"/>
                    <TextBlock Text="{Binding [Str_127], Source={x:Static i18n:I18nService.Instance}}" Foreground="{Binding $parent[Button].Foreground}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedTagSummary}" Foreground="{Binding $parent[Button].Foreground}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- 顶部分页栏 -->
            <Border Grid.Column="3" Name="TopPaginationBorder" Background="#1E1624" BorderBrush="#2D2136" BorderThickness="1" Margin="10,0,0,0" Padding="8,4" CornerRadius="10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding LoadFirstPageCommand}" IsEnabled="{Binding CanLoadPrev}" Theme="{StaticResource RobustIconBtn}" ToolTip.Tip="{Binding [Str_022], Source={x:Static i18n:I18nService.Instance}}">
                        <PathIcon Data="M321.53 929m-41.47 0l0 0q-41.47 0-41.47-41.47l0-747.06q0-41.47 41.47-41.47l0 0q41.47 0 41.47 41.47l0 747.06q0 41.47-41.47 41.47Z M787.26 170L411.44 514.25l375.82 344.21a39.32 39.32 0 0 1 13.11 29c0 36.51-48.2 54.79-76.38 29L348.17 572.2c-34.95-32-34.95-83.9 0-115.9L724 112.08c28.18-25.81 76.38-7.53 76.38 29A39.33 39.33 0 0 1 787.26 170z"
                                  Foreground="{DynamicResource SvgIconBrush}" Width="14" Height="14"/>
                    </Button>
                    <Button Command="{Binding LoadPrevPageCommand}" IsEnabled="{Binding CanLoadPrev}" Theme="{StaticResource RobustIconBtn}" ToolTip.Tip="{Binding [Str_023], Source={x:Static i18n:I18nService.Instance}}">
                        <PathIcon Data="M704 944c-10.88 0-22.4-3.84-31.36-11.52l-448-384c-10.88-8.96-16.64-22.4-16.64-36.48s6.4-27.52 16.64-36.48l448-384c19.84-17.28 50.56-14.72 67.84 5.12s14.72 50.56-5.12 67.84L329.6 512l405.76 347.52c19.84 17.28 22.4 47.36 5.12 67.84-9.6 10.88-23.04 16.64-36.48 16.64z"
                                  Foreground="{DynamicResource SvgIconBrush}" Width="14" Height="14"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Str_128], Source={x:Static i18n:I18nService.Instance}}" Foreground="{DynamicResource ThemeTextSubBrush}" FontSize="12" VerticalAlignment="Center"/>
                        <Panel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentPage}" Foreground="{DynamicResource SvgIconBrush}" FontWeight="Bold" FontSize="13" Cursor="Hand" PointerPressed="OnPageNumberClick" IsVisible="{Binding !IsEditingPageNumber}"/>
                            <TextBox Name="PageJumpTextBox_Top" Text="{Binding JumpPageText}" Foreground="{DynamicResource SvgIconBrush}" FontWeight="Bold" FontSize="11" Width="42" Height="22" Padding="2,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderThickness="1" CornerRadius="4" LostFocus="OnPageJumpLostFocus" KeyDown="OnPageJumpKeyDown" IsVisible="{Binding IsEditingPageNumber}" Background="{DynamicResource ControlBgBrush}"/>
                        </Panel>
                        <TextBlock Text=" / " Foreground="{DynamicResource ThemeTextSubBrush}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalPages}" Foreground="{DynamicResource ThemeTextSubBrush}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding [Str_129], Source={x:Static i18n:I18nService.Instance}}" Foreground="{DynamicResource ThemeTextSubBrush}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Command="{Binding LoadNextPageCommand}" IsEnabled="{Binding CanLoadNext}" Theme="{StaticResource RobustIconBtn}" ToolTip.Tip="{Binding [Str_026], Source={x:Static i18n:I18nService.Instance}}">
                        <PathIcon Data="M288 944c10.88 0 22.4-3.84 31.36-11.52l448-384c10.88-8.96 16.64-22.4 16.64-36.48s-6.4-27.52-16.64-36.48l-448-384c-19.84-17.28-50.56-14.72-67.84 5.12s-14.72 50.56 5.12 67.84L662.4 512l-405.76 347.52c-19.84 17.28-22.4 47.36-5.12 67.84 9.6 10.88 23.04 16.64 36.48 16.64z"
                                  Foreground="{DynamicResource SvgIconBrush}" Width="14" Height="14"/>
                    </Button>
                    <Button Command="{Binding LoadLastPageCommand}" IsEnabled="{Binding CanLoadNext}" Theme="{StaticResource RobustIconBtn}" ToolTip.Tip="{Binding [Str_027], Source={x:Static i18n:I18nService.Instance}}">
                        <PathIcon Data="M706.19 106m41.47 0l0 0q41.47 0 41.47 41.47l0 747.06q0 41.47-41.47 41.47l0 0q-41.47 0-41.47-41.47l0-747.06q0-41.47 41.47-41.47Z M240.46 865l375.81-344.25-375.81-344.21a39.32 39.32 0 0 1-13.11-29c0-36.51 48.2-54.79 76.38-29L679.55 462.8c35 32 35 83.9 0 115.9L303.73 922.92c-28.18 25.81-76.38 7.53-76.38-29A39.33 39.33 0 0 1 240.46 865z"
                                  Foreground="{DynamicResource SvgIconBrush}" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 主体区域 (Row 2) -->
        <Grid Grid.Row="2" Background="Transparent">
            <!-- 加载中 -->
            <StackPanel IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <TextBlock Text="{Binding [Str_130], Source={x:Static i18n:I18nService.Instance}}" FontSize="16" Foreground="#888888" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- 空状态 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsEmpty"/>
                        <Binding Path="!IsLoading"/>
                    </MultiBinding>
                </StackPanel.IsVisible>
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding [Str_131], Source={x:Static i18n:I18nService.Instance}}" FontSize="16" Foreground="Gray" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding [Str_132], Source={x:Static i18n:I18nService.Instance}}" FontSize="12" Foreground="#666666" HorizontalAlignment="Center"/>
                </StackPanel>
                
                <Button Command="{Binding RefreshCommand}" 
                        Background="{DynamicResource ControlBgBrush}"
                        Foreground="{DynamicResource SvgIconBrush}"
                        BorderBrush="{DynamicResource SvgIconBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="24,8"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M512 0c141.385 0 269.41 57.308 362.039 149.937l83.945-83.945c15.114-15.114 40.941-4.417 40.941 16.971v271.074c0 14.137-11.46 25.597-25.597 25.597h-271.074c-21.388 0-32.085-25.827-16.971-40.941l95.539-95.539c-73.491-73.491-174.607-118.956-286.039-118.956-224.234 0-406.403 182.169-406.403 406.403s182.169 406.403 406.403 406.403c141.385 0 269.41-57.308 362.039-149.937 15.114-15.114 40.941-4.417 40.941 16.971s-10.826 31.11-25.94 46.224c-109.117 109.117-259.945 176.431-426.452 176.431-335.791 0-608-272.209-608-608s272.209-608 608-608z" Width="12" Height="12"/>
                        <TextBlock Text="{Binding [Str_133], Source={x:Static i18n:I18nService.Instance}}" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 谱面列表滚动区域 -->
            <ScrollViewer x:Name="ChartScrollViewer" IsVisible="{Binding !IsEmpty}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid RowDefinitions="*,Auto">
                    <ItemsControl ItemsSource="{Binding Charts}" Grid.Row="0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ChartGridColumns}" HorizontalAlignment="Stretch"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:EuterpeChart">
                                <Border Classes="ChartCard" Margin="8" VerticalAlignment="Top" ClipToBounds="True">
                                    <Grid RowDefinitions="Auto,*">
                                        
                                        <!-- 封面区域 -->
                                        <Border Grid.Row="0" Height="160" ClipToBounds="True" CornerRadius="14,14,0,0">
                                            <Panel>
                                                <!-- 默认音乐提示图 -->
                                                <Border Background="#251F2E" IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNull}}">
                                                    <TextBlock Text="🎵" FontSize="56" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#443952"/>
                                                </Border>
                                                <!-- 真实大图封面 -->
                                                <Image Source="{Binding CoverImage}" IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNotNull}}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                
                                                <!-- 试听覆盖遮罩 -->
                                                <Border IsVisible="{Binding IsPlaying}" Background="#CC110D17">
                                                    <TextBlock Text="{Binding [Str_030], Source={x:Static i18n:I18nService.Instance}}" FontSize="13" FontWeight="Bold" Foreground="#FFFF00FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- 下载量与点赞数角标 -->
                                                <Border Background="#AA000000" CornerRadius="8" Padding="6,2" Margin="0,0,6,6" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                                            <TextBlock Text="↓" FontSize="11" Foreground="#00C0FF" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding DownloadCount}" FontSize="11" Foreground="White" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                                            <TextBlock Text="♥" FontSize="11" Foreground="#FF2D55" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding LikeCount}" FontSize="11" Foreground="White" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Panel>
                                        </Border>

                                        <!-- 内容与控制区域 -->
                                        <StackPanel Grid.Row="1" Margin="12" Spacing="6">
                                            <controls:MarqueeText Text="{Binding Name}" HighlightText="{Binding Name}" SearchText="{Binding $parent[UserControl].((vm:EuterpeViewModel)DataContext).SearchText}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMainBrush}" Height="20" IsScrollingEnabled="{Binding $parent[UserControl].((vm:EuterpeViewModel)DataContext).EnableMarquee}" ToolTip.Tip="{Binding Name}"/>
                                            <TextBlock Text="{Binding DisplayAuthor}" FontSize="11" Foreground="{DynamicResource ThemeTextSubBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayAuthor}" helpers:TextBlockHelper.HighlightText="{Binding DisplayAuthor}" helpers:TextBlockHelper.SearchText="{Binding $parent[UserControl].((vm:EuterpeViewModel)DataContext).SearchText}"/>
                                            <TextBlock Text="{Binding DisplayCharter}" FontSize="11" Foreground="{DynamicResource ThemeTextSubBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayCharter}" IsVisible="{Binding CharterInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" helpers:TextBlockHelper.HighlightText="{Binding DisplayCharter}" helpers:TextBlockHelper.SearchText="{Binding $parent[UserControl].((vm:EuterpeViewModel)DataContext).SearchText}"/>
                                            
                                            <!-- BPM 与 难度星级 -->
                                            <StackPanel Orientation="Horizontal" Spacing="8" MinHeight="18" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Bpm, StringFormat='BPM: \{0\}'}" FontSize="11" Foreground="{DynamicResource ThemeTextTertiaryBrush}" VerticalAlignment="Center"/>
                                                <ItemsControl ItemsSource="{Binding DifficultyLabels}" VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="3"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#33FF00FF" CornerRadius="4" Padding="4,1">
                                                                <TextBlock Text="{Binding}" FontSize="10" Foreground="#FFFF00FF" FontWeight="Bold"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- 谱面标签 -->
                                            <ScrollViewer IsVisible="{Binding HasTags}" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Height="20" Margin="0,2,0,0">
                                                <ItemsControl ItemsSource="{Binding Tags}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#1A5E3B75" BorderBrush="#355E3B75" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="9.5" Foreground="#CDA0B7"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <!-- 底部一排三大功能按钮：试听、点赞、下载 -->
                                            <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
                                                
                                                <!-- 试听 -->
                                                <Button Grid.Column="0" Theme="{StaticResource RobustIconBtn}" Command="{Binding $parent[UserControl].((vm:EuterpeViewModel)DataContext).TogglePreviewCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding [Str_134], Source={x:Static i18n:I18nService.Instance}}">
                                                    <Panel>
                                                        <PathIcon IsVisible="{Binding !IsPlaying}" Data="M896 512L128 1024V0z" Foreground="{DynamicResource SvgIconBrush}" Width="16" Height="16"/>
                                                        <PathIcon IsVisible="{Binding IsPlaying}" Data="M722.9375 933.875H301.0625a210.9375 210.9375 0 0 1-210.9375-210.9375V301.0625a210.9375 210.9375 0 0 1 210.9375-210.9375h421.875a210.9375 210.9375 0 0 1 210.9375 210.9375v421.875a210.9375 210.9375 0 0 1-210.9375 210.9375z" Foreground="#FFFF00FF" Width="16" Height="16"/>
                                                    </Panel>
                                                </Button>

                                                <!-- 心形交互点赞 -->
                                                <Button Grid.Column="1" Classes="LikeBtn" Command="{Binding $parent[UserControl].((vm:EuterpeViewModel)DataContext).ToggleLikeCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding [Str_135], Source={x:Static i18n:I18nService.Instance}}">
                                                    <Panel>
                                                        <!-- 未点赞：空心心形 -->
                                                        <PathIcon IsVisible="{Binding !IsLiked}" Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35zM12 5.4C11.16 4.5 9.9 4 8.5 4 6 4 4 6 4 8.5c0 2.78 2.85 5.56 7.61 9.87l.39.35.39-.35C17.15 14.06 20 11.28 20 8.5 20 6 18 4 15.5 4c-1.4 0-2.66.5-3.5 1.4z"
                                                                  Foreground="#CDA0B7" Width="16" Height="16"/>
                                                        <!-- 已点赞：红心发光 -->
                                                        <PathIcon IsVisible="{Binding IsLiked}" Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                                                                  Foreground="#FF2D55" Width="16" Height="16"/>
                                                    </Panel>
                                                </Button>

                                                <!-- 下载 -->
                                                <Button Grid.Column="2" Theme="{StaticResource RobustIconBtn}" Command="{Binding $parent[UserControl].((vm:EuterpeViewModel)DataContext).DownloadChartCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding [Str_136], Source={x:Static i18n:I18nService.Instance}}">
                                                    <PathIcon Data="M498.347 824.32l-296.96-296.96c-11.947-11.947-3.414-34.133 13.653-34.133h160.427c11.946 0 20.48-8.534 20.48-20.48V54.613c0-11.946 8.533-20.48 20.48-20.48h189.44c11.946 0 20.48 8.534 20.48 20.48v418.134c0 11.946 8.533 20.48 20.48 20.48h160.426c18.774 0 27.307 22.186 13.654 34.133L525.653 824.32c-6.826 6.827-20.48 6.827-27.306 0zM916.48 989.867H107.52c-18.773 0-35.84-15.36-35.84-35.84 0-18.774 15.36-35.84 35.84-35.84h810.667c18.773 0 35.84 15.36 35.84 35.84-1.707 20.48-17.067 35.84-37.547 35.84z"
                                                              Foreground="{DynamicResource SvgIconBrush}" Width="16" Height="16"/>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 底部分页控制栏 -->
                    <Border Grid.Row="1" Name="BottomPaginationBorder" Background="#1E1624" BorderBrush="#2D2136" BorderThickness="1" Margin="10,20,10,30" Padding="20,10" CornerRadius="20" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24">
                            <Button Command="{Binding LoadFirstPageCommand}" IsEnabled="{Binding CanLoadPrev}" Theme="{StaticResource RobustIconBtn}" ToolTip.Tip="{Binding [Str_022], Source={x:Static i18n:I18nService.Instance}}">
                                <PathIcon Data="M321.53 929m-41.47 0l0 0q-41.47 0-41.47-41.47l0-747.06q0-41.47 41.47-41.47l0 0q41.47 0 41.47 41.47l0 747.06q0 41.47-41.47 41.47Z M787.26 170L411.44 514.25l375.82 344.21a39.32 39.32 0 0 1 13.11 29c0 36.51-48.2 54.79-76.38 29L348.17 572.2c-34.95-32-34.95-83.9 0-115.9L724 112.08c28.18-25.81 76.38-7.53 76.38 29A39.33 39.33 0 0 1 787.26 170z" Foreground="{DynamicResource SvgIconBrush}" Width="16" Height="16"/>
                            </Button>
                            <Button Command="{Binding LoadPrevPageCommand}" IsEnabled="{Binding CanLoadPrev}" Theme="{StaticResource RobustIconBtn}" ToolTip.Tip="{Binding [Str_023], Source={x:Static i18n:I18nService.Instance}}">
                                <PathIcon Data="M704 944c-10.88 0-22.4-3.84-31.36-11.52l-448-384c-10.88-8.96-16.64-22.4-16.64-36.48s6.4-27.52 16.64-36.48l448-384c19.84-17.28 50.56-14.72 67.84 5.12s14.72 50.56-5.12 67.84L329.6 512l405.76 347.52c19.84 17.28 22.4 47.36 5.12 67.84-9.6 10.88-23.04 16.64-36.48 16.64z" Foreground="{DynamicResource SvgIconBrush}" Width="16" Height="16"/>
                            </Button>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Str_024], Source={x:Static i18n:I18nService.Instance}}" Foreground="#8A8594" VerticalAlignment="Center" FontSize="14"/>
                                <Panel VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock Text="{Binding CurrentPage}" Foreground="{DynamicResource SvgIconBrush}" FontWeight="Bold" FontSize="15" Cursor="Hand" PointerPressed="OnPageNumberClick" IsVisible="{Binding !IsEditingPageNumber}"/>
                                    <TextBox Name="PageJumpTextBox_Bottom" Text="{Binding JumpPageText}" Foreground="{DynamicResource SvgIconBrush}" FontWeight="Bold" FontSize="14" Width="55" Height="28" Padding="4,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderThickness="1" CornerRadius="6" LostFocus="OnPageJumpLostFocus" KeyDown="OnPageJumpKeyDown" IsVisible="{Binding IsEditingPageNumber}" Background="{DynamicResource ControlBgBrush}"/>
                                </Panel>
                                <TextBlock Text="/" Foreground="#8A8594" VerticalAlignment="Center" FontSize="14"/>
                                <TextBlock Text="{Binding TotalPages}" Foreground="#8A8594" VerticalAlignment="Center" FontSize="14" Margin="4,0"/>
                                <TextBlock Text="{Binding [Str_025], Source={x:Static i18n:I18nService.Instance}}" Foreground="#8A8594" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                            <Button Command="{Binding LoadNextPageCommand}" IsEnabled="{Binding CanLoadNext}" Theme="{StaticResource RobustIconBtn}" ToolTip.Tip="{Binding [Str_026], Source={x:Static i18n:I18nService.Instance}}">
                                <PathIcon Data="M288 944c10.88 0 22.4-3.84 31.36-11.52l448-384c-10.88 8.96-16.64-22.4-16.64-36.48s6.4-27.52 16.64-36.48l-448-384c-19.84-17.28-50.56-14.72-67.84 5.12s-14.72 50.56 5.12 67.84L662.4 512l-405.76 347.52c-19.84 17.28-22.4 47.36-5.12 67.84 9.6 10.88 23.04 16.64 36.48 16.64z" Foreground="{DynamicResource SvgIconBrush}" Width="16" Height="16"/>
                            </Button>
                            <Button Command="{Binding LoadLastPageCommand}" IsEnabled="{Binding CanLoadNext}" Theme="{StaticResource RobustIconBtn}" ToolTip.Tip="{Binding [Str_027], Source={x:Static i18n:I18nService.Instance}}">
                                <PathIcon Data="M706.19 106m41.47 0l0 0q41.47 0 41.47 41.47l0 747.06q0 41.47-41.47 41.47l0 0q-41.47 0-41.47-41.47l0-747.06q0-41.47 41.47-41.47Z M240.46 865l375.81-344.25-375.81-344.21a39.32 39.32 0 0 1-13.11-29c0-36.51 48.2-54.79 76.38-29L679.55 462.8c35 32 35 83.9 0 115.9L303.73 922.92c-28.18 25.81-76.38 7.53-76.38-29A39.33 39.33 0 0 1 240.46 865z" Foreground="{DynamicResource SvgIconBrush}" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>

    <!-- 筛选遮罩弹窗面板 -->
    <Grid Name="TagOverlayGrid" IsVisible="{Binding IsTagPanelOpen}" Background="#C509050F" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- 点击背景空白区域关闭弹窗 -->
            <Button Background="Transparent" BorderThickness="0" Command="{Binding ToggleTagPanelCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate>
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            
            <Border Classes="ModalCard" Margin="24" CornerRadius="18" BorderThickness="1.5" MaxWidth="940" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#FFFF00FF" Offset="0"/>
                        <GradientStop Color="#FF00FFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#251F2E" Offset="0"/>
                        <GradientStop Color="#16131C" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid RowDefinitions="Auto,*">
                    <!-- 头部 -->
                    <Border Grid.Row="0" Padding="20,16" BorderThickness="0,0,0,1" BorderBrush="#22FFFFFF">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Text="{Binding [Str_137], Source={x:Static i18n:I18nService.Instance}}" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Command="{Binding ClearFiltersCommand}" Theme="{StaticResource RobustPlainIconBtn}" ToolTip.Tip="清除所有筛选" Margin="0,0,8,0">
                                <PathIcon Data="M18.3 5.71a7.93 7.93 0 0 0-5.6-2.33 7.95 7.95 0 0 0-7.96 7.96h-2.1l3.3 3.3 3.3-3.3H7.12a5.6 5.6 0 1 1 1.64 3.98l-1.7 1.7A7.96 7.96 0 1 0 18.3 5.71z" Width="17" Height="17" Foreground="#88FFFFFF"/>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding ToggleTagPanelCommand}" Theme="{StaticResource RobustPlainIconBtn}" ToolTip.Tip="{Binding [Str_093], Source={x:Static i18n:I18nService.Instance}}">
                                <TextBlock Text="✕" FontSize="18" Foreground="#88FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="14" Margin="20,16,20,20">
                            <WrapPanel Orientation="Horizontal">
                                <StackPanel Width="168" Margin="0,0,12,12" Spacing="5"><TextBlock Text="定数" FontSize="11" Foreground="#8A8594"/><ComboBox ItemsSource="{Binding RatingFilterOptions}" SelectedValueBinding="{Binding Value, DataType=vm:EuterpeSortOption}" SelectedValue="{Binding RatingFilter}"/></StackPanel>
                                <StackPanel Width="168" Margin="0,0,12,12" Spacing="5"><TextBlock Text="地图数量" FontSize="11" Foreground="#8A8594"/><ComboBox ItemsSource="{Binding MapCountFilterOptions}" SelectedValueBinding="{Binding Value, DataType=vm:EuterpeSortOption}" SelectedValue="{Binding MapCountFilter}"/></StackPanel>
                                <StackPanel Width="168" Margin="0,0,12,12" Spacing="5"><TextBlock Text="BPM" FontSize="11" Foreground="#8A8594"/><ComboBox ItemsSource="{Binding BpmFilterOptions}" SelectedValueBinding="{Binding Value, DataType=vm:EuterpeSortOption}" SelectedValue="{Binding BpmFilter}"/></StackPanel>
                                <StackPanel Width="168" Margin="0,0,12,12" Spacing="5"><TextBlock Text="评分精选" FontSize="11" Foreground="#8A8594"/><ComboBox ItemsSource="{Binding BooleanFilterOptions}" SelectedValueBinding="{Binding Value, DataType=vm:EuterpeSortOption}" SelectedValue="{Binding CuratorPickedFilter}"/></StackPanel>
                                <StackPanel Width="168" Margin="0,0,12,12" Spacing="5"><TextBlock Text="上传者等级" FontSize="11" Foreground="#8A8594"/><ComboBox ItemsSource="{Binding CreatorLevelMinFilterOptions}" SelectedValueBinding="{Binding Value, DataType=vm:EuterpeSortOption}" SelectedValue="{Binding CreatorLevelMinFilter}"/></StackPanel>
                                <StackPanel Width="168" Margin="0,0,12,12" Spacing="5"><TextBlock Text="上传者是评委" FontSize="11" Foreground="#8A8594"/><ComboBox ItemsSource="{Binding BooleanFilterOptions}" SelectedValueBinding="{Binding Value, DataType=vm:EuterpeSortOption}" SelectedValue="{Binding CreatorIsCuratorFilter}"/></StackPanel>
                                <StackPanel Width="168" Margin="0,0,12,12" Spacing="5"><TextBlock Text="创建时间" FontSize="11" Foreground="#8A8594"/><ComboBox ItemsSource="{Binding CreatedWithinDaysFilterOptions}" SelectedValueBinding="{Binding Value, DataType=vm:EuterpeSortOption}" SelectedValue="{Binding CreatedWithinDaysFilter}"/></StackPanel>
                                <StackPanel Width="168" Margin="0,0,12,12" Spacing="5"><TextBlock Text="背景视频" FontSize="11" Foreground="#8A8594"/><ComboBox ItemsSource="{Binding BooleanFilterOptions}" SelectedValueBinding="{Binding Value, DataType=vm:EuterpeSortOption}" SelectedValue="{Binding HasVideoFilter}"/></StackPanel>
                                <StackPanel Width="168" Margin="0,0,12,12" Spacing="5"><TextBlock Text="有 Talk" FontSize="11" Foreground="#8A8594"/><ComboBox ItemsSource="{Binding BooleanFilterOptions}" SelectedValueBinding="{Binding Value, DataType=vm:EuterpeSortOption}" SelectedValue="{Binding HasTalkFilter}"/></StackPanel>
                                <StackPanel Width="168" Margin="0,0,12,12" Spacing="5"><TextBlock Text="有试听" FontSize="11" Foreground="#8A8594"/><ComboBox ItemsSource="{Binding BooleanFilterOptions}" SelectedValueBinding="{Binding Value, DataType=vm:EuterpeSortOption}" SelectedValue="{Binding HasDemoFilter}"/></StackPanel>
                                <StackPanel Width="168" Margin="0,0,12,12" Spacing="5"><TextBlock Text="有隐藏谱" FontSize="11" Foreground="#8A8594"/><ComboBox ItemsSource="{Binding BooleanFilterOptions}" SelectedValueBinding="{Binding Value, DataType=vm:EuterpeSortOption}" SelectedValue="{Binding HasMap4Filter}"/></StackPanel>
                                <StackPanel Width="168" Margin="0,0,12,12" Spacing="5"><TextBlock Text="场景" FontSize="11" Foreground="#8A8594"/><ComboBox ItemsSource="{Binding SceneFilterOptions}" SelectedValueBinding="{Binding Value, DataType=vm:EuterpeSortOption}" SelectedValue="{Binding SceneFilter}"/></StackPanel>
                                <StackPanel Width="168" Margin="0,0,12,12" Spacing="5"><TextBlock Text="有彩蛋场景" FontSize="11" Foreground="#8A8594"/><ComboBox ItemsSource="{Binding BooleanFilterOptions}" SelectedValueBinding="{Binding Value, DataType=vm:EuterpeSortOption}" SelectedValue="{Binding HasSceneEggFilter}"/></StackPanel>
                                <StackPanel Width="168" Margin="0,0,12,12" Spacing="5"><TextBlock Text="版权敏感" FontSize="11" Foreground="#8A8594"/><ComboBox ItemsSource="{Binding SafeForStreamerFilterOptions}" SelectedValueBinding="{Binding Value, DataType=vm:EuterpeSortOption}" SelectedValue="{Binding SafeForStreamerFilter}"/></StackPanel>
                                <StackPanel Width="168" Margin="0,0,12,12" Spacing="5"><TextBlock Text="有评论" FontSize="11" Foreground="#8A8594"/><ComboBox ItemsSource="{Binding BooleanFilterOptions}" SelectedValueBinding="{Binding Value, DataType=vm:EuterpeSortOption}" SelectedValue="{Binding HasCommentsFilter}"/></StackPanel>
                                <StackPanel Width="168" Margin="0,0,12,12" Spacing="5"><TextBlock Text="我点赞过" FontSize="11" Foreground="#8A8594"/><ComboBox ItemsSource="{Binding BooleanFilterOptions}" SelectedValueBinding="{Binding Value, DataType=vm:EuterpeSortOption}" SelectedValue="{Binding LikedByMeFilter}"/></StackPanel>
                                <StackPanel Width="168" Margin="0,0,12,12" Spacing="5"><TextBlock Text="我下载过" FontSize="11" Foreground="#8A8594"/><ComboBox ItemsSource="{Binding BooleanFilterOptions}" SelectedValueBinding="{Binding Value, DataType=vm:EuterpeSortOption}" SelectedValue="{Binding DownloadedByMeFilter}"/></StackPanel>
                            </WrapPanel>

                            <Border BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="标签" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        <CheckBox Grid.Column="1" Content="匹配任意已选标签" IsChecked="{Binding IsAnyTagMatch}" Foreground="#B8B2C4" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBox Name="TagSearchTextBox" Text="{Binding TagSearchText}" Watermark="搜索标签（支持模糊匹配）" Padding="10,8"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Classes="TagChip" Content="全部标签" Command="{Binding ClearTagSelectionCommand}"/>
                                        <ItemsControl ItemsSource="{Binding SelectedTags}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:EuterpeTag"><Button Classes="TagChip" Classes.selected="{Binding IsSelected}" Content="{Binding DisplayName}" Command="{Binding $parent[UserControl].((vm:EuterpeViewModel)DataContext).SelectTagCommand}" CommandParameter="{Binding}" Margin="0,0,4,0"/></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding FilteredTags}" IsVisible="{Binding HasTagSearchResults}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:EuterpeTag"><Button Classes="TagChip" Classes.selected="{Binding IsSelected}" Content="{Binding DisplayName}" Command="{Binding $parent[UserControl].((vm:EuterpeViewModel)DataContext).SelectTagCommand}" CommandParameter="{Binding}" Margin="0,0,4,4"/></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 查重对话框 Overlay -->
        <Grid Background="#B0000000" IsVisible="{Binding IsDuplicateDialogOpen}">
            <Border Background="{DynamicResource DialogBgBrush}" 
                    BorderBrush="#FF8EBE" 
                    BorderThickness="1.5" 
                    CornerRadius="16" 
                    Width="450" 
                    Padding="24"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    BoxShadow="0 8 32 #80000000">
                <StackPanel Spacing="16">
                    <!-- 头部 -->
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <PathIcon Data="M512 80C273.44 80 80 273.44 80 512s193.44 432 432 432 432-193.44 432-432S750.56 80 512 80zm0 80c194.24 0 352 157.76 352 352S706.24 864 512 864 160 706.24 160 512 317.76 160 512 160zm-40 140v300h80V300h-80zm0 380v80h80v-80h-80z" 
                                  Foreground="#FF8EBE" Width="28" Height="28"/>
                        <TextBlock Text="{Binding [Str_424], Source={x:Static i18n:I18nService.Instance}}" 
                                   FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMainBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 内容 -->
                    <TextBlock Text="{Binding DuplicateDialogTarget.Name, StringFormat='谱面 《{0}》 已存在于本地。'}" 
                               FontSize="14" Foreground="{DynamicResource ThemeTextMainBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    
                    <!-- 本地重复文件列表 -->
                    <Border Background="#1C151B" CornerRadius="8" Padding="12" MaxHeight="150">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DuplicateDialogItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,4" Spacing="8">
                                            <TextBlock Text="📁" FontSize="12" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMainBrush}"/>
                                                <TextBlock Text="{Binding DisplayCharter}" FontSize="11" Foreground="{DynamicResource ThemeTextSubBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- 底部操作按钮 -->
                    <StackPanel Spacing="10" Margin="0,8,0,0">
                        <Button Content="{Binding [Str_426], Source={x:Static i18n:I18nService.Instance}}" 
                                Command="{Binding ConfirmSingleDownloadActionCommand}" CommandParameter="overwrite"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,10"
                                Background="#D04060" Foreground="White" CornerRadius="8" FontWeight="Bold" Cursor="Hand"/>
                        <Button Content="{Binding [Str_427], Source={x:Static i18n:I18nService.Instance}}" 
                                Command="{Binding ConfirmSingleDownloadActionCommand}" CommandParameter="both"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,10"
                                Background="{DynamicResource ControlBgBrush}" Foreground="{DynamicResource ThemeTextMainBrush}" CornerRadius="8" Cursor="Hand"/>
                        <Button Content="{Binding [Str_428], Source={x:Static i18n:I18nService.Instance}}" 
                                Command="{Binding ConfirmSingleDownloadActionCommand}" CommandParameter="skip"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,10"
                                Background="Transparent" BorderBrush="{DynamicResource ThemeTextSubBrush}" BorderThickness="1" Foreground="{DynamicResource ThemeTextSubBrush}" CornerRadius="8" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Panel>
</UserControl>
