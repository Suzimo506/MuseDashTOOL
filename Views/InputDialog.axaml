<Window xmlns:i18n="using:MdModManager.Services" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MdModManager.Views.InputDialog"
        Title="{Binding [Str_075], Source={x:Static i18n:I18nService.Instance}}"
        Width="400" Height="200"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DialogBgBrush}"
        Foreground="{DynamicResource ThemeTextMainBrush}"
        SystemDecorations="Full">

    <Grid RowDefinitions="Auto, Auto, Auto" Margin="24" VerticalAlignment="Center">
        <!-- 提示文本 -->
        <TextBlock x:Name="PromptText"
                   Grid.Row="0"
                   Text="{Binding [Str_142], Source={x:Static i18n:I18nService.Instance}}"
                   FontSize="15"
                   Foreground="{DynamicResource ThemeTextMainBrush}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,16"/>

        <!-- 输入框 -->
        <TextBox x:Name="InputTextBox"
                 Grid.Row="1"
                 Width="320"
                 Height="36"
                 Watermark="{Binding [Str_143], Source={x:Static i18n:I18nService.Instance}}"
                 VerticalContentAlignment="Center"
                 HorizontalAlignment="Center"
                 CornerRadius="10"
                 Background="{DynamicResource ControlBgBrush}"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

        <!-- 底部按钮区 -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="16"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0">
            <Button x:Name="CancelButton"
                    Content="{Binding [Str_086], Source={x:Static i18n:I18nService.Instance}}"
                    Width="100"
                    Height="32"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="{DynamicResource ControlBgBrush}"
                    Foreground="{DynamicResource ThemeTextMainBrush}"
                    CornerRadius="10"
                    Click="OnCancelClick"/>
            <Button x:Name="ConfirmButton"
                    Content="{Binding [Str_144], Source={x:Static i18n:I18nService.Instance}}"
                    Width="100"
                    Height="32"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="{DynamicResource ThemeAccentBrush}"
                    Foreground="White"
                    CornerRadius="10"
                    Click="OnConfirmClick"/>
        </StackPanel>
    </Grid>
</Window>
